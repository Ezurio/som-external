config BR2_SUMMIT_SECURE_BOOT
	bool "Summit Secure Boot"
	select BR2_TARGET_UBOOT_NEEDS_OPENSSL
	select BR2_PACKAGE_HOST_CRYPTSETUP
	help
		This enables "traditional" (down to kernel) secure boot
		rootfs security provided by Summit Encrypted Storage Toolkit

config BR2_SUMMIT_OPENJDK_GGV2
	bool "summit-openjdk-ggv2"
	depends on BR2_PACKAGE_OPENJDK
	help
		Split out the OpenJDK 'modules' file dependency
		during the build to support moving Java dependecies
		to the SD card to support AWS IoT Greengrass V2. This
		flag triggers logic in the post_build and post_image
		scripts.

choice
	prompt "Use FIPS"
	optional

config BR2_SUMMIT_FIPS_7
	bool "Use FIPS 7.1"
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_SUMMITSSL_FIPS_BINARIES
	select BR2_PACKAGE_SUMMIT_FIPS_UTILS
	select BR2_PACKAGE_FIPSCHECK
	select BR2_SUMMIT_FIPS_RADIO
	select BR2_PACKAGE_UBOOT_TOOLS
	select BR2_PACKAGE_UBOOT_TOOLS_DUMPIMAGE
	select BR2_PACKAGE_UBOOT_TOOLS_FIT_SUPPORT
	select BR2_REPRODUCIBLE

config BR2_SUMMIT_FIPS_11
	bool "Use FIPS 11.0"
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBOPENSSL_3_0
	select BR2_PACKAGE_SUMMIT_OPENSSL_FIPS_PROVIDER
	select BR2_PACKAGE_SUMMIT_FIPS_UTILS
	select BR2_SUMMIT_FIPS_RADIO
	select BR2_PACKAGE_UBOOT_TOOLS
	select BR2_PACKAGE_UBOOT_TOOLS_DUMPIMAGE
	select BR2_PACKAGE_UBOOT_TOOLS_FIT_SUPPORT
	select BR2_REPRODUCIBLE

endchoice


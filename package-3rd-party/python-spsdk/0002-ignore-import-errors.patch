 spsdk/utils/devicedescription.py              |   5 +-
 spsdk/utils/interfaces/device/usb_device.py   |   5 +-
 .../utils/interfaces/device/usbsio_device.py  |  11 +-
 spsdk/utils/nxpdevscan.py                     |   5 +-
 7 files changed, 280 insertions(+), 16 deletions(-)

diff --git a/spsdk/__init__.py b/spsdk/__init__.py
index 70a36f5..16460a8 100644
--- a/spsdk/__init__.py
+++ b/spsdk/__init__.py
@@ -28,8 +28,254 @@ import os
 import sys
 from typing import Optional, Union
 
-from packaging.version import Version, parse
-from platformdirs import PlatformDirs
+# ---- Begin optional-dependency shims ----
+# Install shim modules into sys.modules so that "import <mod>" succeeds
+# everywhere without per-file try/except blocks.  These libraries are
+# not required for offline AHAB container signing with nxpimage.
+try:
+    import colorama  # noqa: F401
+except ImportError:
+    import types as _types
+
+    class _EmptyStr:
+        def __getattr__(self, name):
+            return ""
+
+    _colorama = _types.ModuleType("colorama")
+    _colorama.Fore = _EmptyStr()
+    _colorama.Style = _EmptyStr()
+    _colorama.just_fix_windows_console = lambda: None
+    sys.modules["colorama"] = _colorama
+
+try:
+    import click_command_tree  # noqa: F401
+except ImportError:
+    import types as _types
+
+    _cct = _types.ModuleType("click_command_tree")
+    _cct._build_command_tree = lambda cmd: cmd
+    _cct._CommandWrapper = type("_CommandWrapper", (), {})
+    sys.modules["click_command_tree"] = _cct
+
+try:
+    import hexdump  # noqa: F401
+except ImportError:
+    import types as _types
+
+    def _hexdump_hexdump(data, result="print"):
+        s = " ".join(f"{b:02x}" for b in data[:64])
+        if result == "return":
+            return s
+        print(s)
+
+    def _hexdump_restore(s):
+        return bytes.fromhex(s.replace(" ", ""))
+
+    _hexdump = _types.ModuleType("hexdump")
+    _hexdump.hexdump = _hexdump_hexdump
+    _hexdump.restore = _hexdump_restore
+    sys.modules["hexdump"] = _hexdump
+
+try:
+    import prettytable  # noqa: F401
+except ImportError:
+    import types as _types
+
+    class _PrettyTable:
+        def __init__(self, *a, **kw):
+            self.field_names = []
+
+        def add_row(self, *a, **kw):
+            pass
+
+        def set_style(self, *a):
+            pass
+
+        def __str__(self):
+            return ""
+
+    class _StyleEnum:
+        def __getattr__(self, name):
+            return None
+
+    _pt = _types.ModuleType("prettytable")
+    _pt.PrettyTable = _PrettyTable
+    _pt.TableStyle = _StyleEnum()
+    _pt.HRuleStyle = _StyleEnum()
+    _pt.VRuleStyle = _StyleEnum()
+    sys.modules["prettytable"] = _pt
+
+try:
+    import sly  # noqa: F401
+except ImportError:
+    import types as _types
+
+    def _sly_decorator(*patterns):
+        """Stand-in for sly's _ decorator that just returns the function."""
+        def _wrapper(fn):
+            return fn
+        return _wrapper
+
+    class _SlyMeta(type):
+        """Metaclass that injects _ into every subclass body namespace."""
+        @classmethod
+        def __prepare__(mcs, name, bases, **kw):
+            d = super().__prepare__(name, bases, **kw)
+            d['_'] = _sly_decorator
+            return d
+
+    class _SlyBase(metaclass=_SlyMeta):
+        tokens = set()
+
+    class _Token:
+        pass
+
+    class _YaccProduction:
+        pass
+
+    _sly = _types.ModuleType("sly")
+    _sly.__path__ = []
+    _sly.Lexer = _SlyBase
+    _sly.Parser = _SlyBase
+    _sly_lex = _types.ModuleType("sly.lex")
+    _sly_lex.Token = _Token
+    _sly_yacc = _types.ModuleType("sly.yacc")
+    _sly_yacc.YaccProduction = _YaccProduction
+    _sly.lex = _sly_lex
+    _sly.yacc = _sly_yacc
+    sys.modules["sly"] = _sly
+    sys.modules["sly.lex"] = _sly_lex
+    sys.modules["sly.yacc"] = _sly_yacc
+
+try:
+    import x690  # noqa: F401
+except ImportError:
+    import types as _types
+
+    class _X690Type:
+        def __class_getitem__(cls, item):
+            return cls
+
+    class _TypeClass:
+        def __getattr__(self, name):
+            return name
+
+    class _TypeNature:
+        def __getattr__(self, name):
+            return name
+
+    _TypeClass = _TypeClass()
+    _TypeNature = _TypeNature()
+
+    def _decode(*a, **kw):
+        return b""
+
+    _x690 = _types.ModuleType("x690")
+    _x690_types = _types.ModuleType("x690.types")
+    _x690_types.X690Type = _X690Type
+    _x690_types.TypeClass = _TypeClass
+    _x690_types.TypeNature = _TypeNature
+    _x690_types.decode = _decode
+    _x690.types = _x690_types
+    sys.modules["x690"] = _x690
+    sys.modules["x690.types"] = _x690_types
+
+try:
+    from packaging.version import Version, parse
+except ImportError:
+
+    class Version:
+        def __init__(self, v):
+            self.base_version = str(v).split("+")[0].split("-")[0]
+
+        def __str__(self):
+            return self.base_version
+
+    def parse(v):
+        return Version(v)
+
+
+try:
+    from platformdirs import PlatformDirs
+except ImportError:
+
+    class PlatformDirs:
+        def __init__(
+            self, appauthor=None, appname=None, version=None, ensure_exists=False
+        ):
+            self._base = os.path.join(
+                os.path.expanduser("~"), ".cache", appname or "spsdk"
+            )
+            if version:
+                self._base = os.path.join(self._base, version)
+            if ensure_exists:
+                os.makedirs(self._base, exist_ok=True)
+
+        @property
+        def user_cache_dir(self):
+            p = os.path.join(self._base, "cache")
+            os.makedirs(p, exist_ok=True)
+            return p
+
+        @property
+        def user_data_dir(self):
+            return self._base
+
+        @property
+        def user_log_dir(self):
+            p = os.path.join(self._base, "log")
+            os.makedirs(p, exist_ok=True)
+            return p
+
+        @property
+        def user_runtime_dir(self):
+            p = os.path.join(self._base, "runtime")
+            os.makedirs(p, exist_ok=True)
+            return p
+
+        def _optionally_create_directory(self, path):
+            os.makedirs(path, exist_ok=True)
+
+# Redirect importlib_metadata (backport) to stdlib importlib.metadata
+# since Python 3.9+ includes the same API.
+try:
+    import importlib_metadata  # noqa: F401
+except ImportError:
+    import importlib.metadata as importlib_metadata
+    sys.modules["importlib_metadata"] = importlib_metadata
+
+# Shim remaining optional third-party modules not needed for AHAB signing.
+# Using bare ModuleType stubs injected into sys.modules avoids per-file
+# try/except blocks across the spsdk source tree.
+# NOTE: Do NOT shim spsdk_pqc or gmssl -- the code uses
+# importlib.util.find_spec() for those and must see them absent.
+import types as _types
+
+_shim_names = [
+    "click_option_group",
+    "auto_click_auto",
+    "bincopy",
+    "bitstring",
+    "can",
+    "ftd2xx",
+    "asn1crypto",
+    "astunparse",
+    "ipywidgets",
+    "IPython",
+    "pyasn1",
+    "pyftdi",
+    "pylibftdi",
+    "validator_file",
+]
+for _name in _shim_names:
+    if _name not in sys.modules:
+        _mod = _types.ModuleType(_name)
+        _mod.__path__ = []
+        _mod.__file__ = "<shim:" + _name + ">"
+        sys.modules[_name] = _mod
+
+del _types, _shim_names, _name, _mod
+# ---- End optional-dependency shims ----
 
 
 class SPSDKPlatformDirs(PlatformDirs):

From 8ec548c4498e1060bd66f840a97e5817a3ad9dae Mon Sep 17 00:00:00 2001
From: Doug Smith <doug.smith@ezurio.com>
Date: Fri, 6 Feb 2026 08:58:38 -0500
Subject: [PATCH] fix attempt using atexit

---
 aws_kms_pkcs11.cpp | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/aws_kms_pkcs11.cpp b/aws_kms_pkcs11.cpp
index c8afef0..6d7fe1b 100644
--- a/aws_kms_pkcs11.cpp
+++ b/aws_kms_pkcs11.cpp
@@ -13,6 +13,8 @@
 #include <aws/kms/model/ListKeysRequest.h>
 #include <aws/kms/model/SignRequest.h>
 
+#include <stdlib.h>
+
 #include "pkcs11_compat.h"
 #include "openssl_compat.h"
 #include "attributes.h"
@@ -110,6 +112,17 @@ static CK_RV load_config(json_object** config) {
     return CKR_OK;
 }
 
+static int is_C_Initialized = 0;
+static int is_atexit_initialized = 0;
+
+// atexit function to fix static object cleanup in AWS
+// if application uses exit to cleanup (calling C_Finalize in exit handlers)
+// then double frees occur as AWS destructors are called before C_Finalize
+// add an atexit to be executed before the object detructors
+static void cleanup_atexit(void) {
+    C_Finalize(NULL);
+}
+
 CK_RV C_Initialize(CK_VOID_PTR pInitArgs) {
     CK_RV result = CKR_OK;
 
@@ -239,6 +252,12 @@ CK_RV C_Initialize(CK_VOID_PTR pInitArgs) {
         }
     }
 
+    if (!is_atexit_initialized) {
+        is_atexit_initialized = 1;
+        atexit(cleanup_atexit);
+    }
+
+    is_C_Initialized = 1;
     if (result != CKR_OK) {
         C_Finalize(NULL_PTR);
     }
@@ -248,6 +267,10 @@ CK_RV C_Initialize(CK_VOID_PTR pInitArgs) {
 CK_RV C_Finalize(CK_VOID_PTR pReserved) {
     debug("Cleaning PKCS#11 provider.");
 
+    if (!is_C_Initialized)
+        return CKR_OK;
+    is_C_Initialized = 0;
+
     if (slots != NULL) {
         for (size_t i = 0; i < slots->size(); i++) {
             AwsKmsSlot& slot = slots->at(i);
-- 

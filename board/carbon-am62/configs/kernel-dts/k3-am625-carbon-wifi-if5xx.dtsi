#include "k3-am625-carbon-wifi.dtsi"

&sdhci2 { /* SDIO_B  WIFI */
	wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&main_uart1 {
	pinctrl-0 = <&main_uart1_pins_default>, <&main_bt_en_pins_default>;

	bluetooth {
		compatible = "infineon,cyw55572-bt";
		brcm,requires-autobaud-mode;
		max-speed = <921600>;
		shutdown-gpios = <&main_gpio0 22 GPIO_ACTIVE_HIGH>; /* W_DISABLE2# */
	};
};

#include "k3-am625-carbon-wifi.dtsi"

/ {
	/* Regulator needed to sync Wi-Fi and Bluetooth on power transitions */
	vcc_wifi_en: regulator-wifi-en {
		compatible = "regulator-fixed";
		regulator-name = "vcc_wifi_en";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&wifi_pwrseq {
	post-power-on-delay-ms = <10>;
	power-off-delay-us = <80>;
};

&sdhci2 { /* SDIO_B  WIFI */
	vmmc-supply = <&vcc_wifi_en>;

	cap-power-off-card;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";
	};
};

&main_uart1 {
	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&vcc_wifi_en>;
		max-speed = <115200>;
	};
};

&wifi_wakeup {
	wifi-wake-up {
		gpios = <&main_gpio0 16 GPIO_ACTIVE_HIGH>;
	};

	bt-wake-up {
		gpios = <&main_gpio0 42 GPIO_ACTIVE_HIGH>;
	};
};

/dts-v1/;
/plugin/;

#include "k3-am625-carbon-m2.dtsi"

&{/} {
	vcc_bt_m2: regulator-bt-m2 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_bt_m2";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		vin-supply = <&vcc_wifi_m2>;

		gpios = <&exp1 5 GPIO_ACTIVE_HIGH>;  /* M2_WDISABLE2# */
		enable-active-high;
		regulator-always-on;
	};

	wifi_pwrseq_m2: wifi-pwrseq-m2 {
		compatible = "mmc-pwrseq-sd8787";

		powerdown-gpios = <&exp1 4 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&exp1 10 GPIO_ACTIVE_HIGH>;
	};
};

&sdhci1 { /* SDIO_A uSD / M.2_SDIO */
	wifi_pwrseq = <&wifi_pwrseq_m2>;
};

&mcu_uart0 {
	bluetooth {
		compatible = "nxp,88w8987-bt";
		fw-init-baudrate = <3000000>;
	};
};

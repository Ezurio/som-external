/dts-v1/;
/plugin/;

#include "k3-am625-carbon-m2.dtsi"

&{/} {
	/* Regulator needed to sync Wi-Fi and Bluetooth on power transitions */
	reg_wifi_en_m2: regulator-wifi-en-m2 {
		compatible = "regulator-fixed";

		regulator-name = "vcc_wifi_en_m2";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		vin-supply = <&vcc_wifi_m2>;

		gpios = <&exp1 4 GPIO_ACTIVE_HIGH>;   /* M2_WDISABLE1# */
		enable-active-high;

		startup-delay-us = <10000>;
		off-on-delay-us = <80>;
	};
};

&sdhci1 { /* SDIO_A uSD / M.2_SDIO */
	vmmc-supply = <&reg_wifi_en_m2>;

	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";
	};
};

&mcu_uart0 {
	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_wifi_en_m2>;
		max-speed = <115200>;
	};
};

&wifi_wakeup_m2 {
	status = "disabled";
};

&exp2 {
	/delete-property/ wakeup-source;
};

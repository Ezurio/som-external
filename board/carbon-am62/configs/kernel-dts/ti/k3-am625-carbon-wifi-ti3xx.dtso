/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

&reg_slow_clock {
	status = "okay";
};

&reg_wifi_en {
	status = "okay";
	startup-delay-us = <10000>;
};

&sdhci2 { /* SDIO_B  WIFI */
	status = "okay";

	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";

		pinctrl-names = "default";
		pinctrl-0 = <&main_wifi_wake_default>;
		//interrupts-extended = <&main_gpio0 16 IRQ_TYPE_EDGE_RISING>;
	};
};

&main_uart1 {
 	status = "okay";

	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_wifi_en>;
		max-speed = <115200>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_bt_wake_pins_default>;
		host-wakeup-gpios = <&main_gpio0 42 GPIO_ACTIVE_HIGH>;
	};
};

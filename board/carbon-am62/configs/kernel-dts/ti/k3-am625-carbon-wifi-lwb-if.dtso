/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

&sdhci2 { /* SDIO_B  WIFI */
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&main_uart1 {
	pinctrl-0 = <&main_uart1_pins_default>, <&main_bt_en_pins_default>;

	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4329-bt";
		vbat-supply = <&vcc_3v3_sys>;
		vddio-supply = <&vdd_1v8>;
		brcm,requires-autobaud-mode;
		max-speed = <921600>;
		shutdown-gpios = <&main_gpio0 22 GPIO_ACTIVE_HIGH>; /* W_DISABLE2# */
	};
};

&wifi_wakeup {
	status = "okay";
};

&wifi_pwrseq {
	status = "okay";
};

/dts-v1/;

#include "k3-am625-carbon-som.dtsi"
#include "k3-am625-carbon-wifi-cc33xx.dtsi"

/ {
	model = "Summit Carbon AM625 OSM WBx3 Board";
	compatible = "summit,am62-wbx3", "ti,am625";

	vdd_mmc1: regulator-sdio-a {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&main_vdd_sdio_a_gpio>;
		regulator-name = "vdd_mmc1";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <250000>;
		enable-active-high;
		gpio = <&main_gpio0 18 GPIO_ACTIVE_HIGH>;
	};
};

&cpsw3g_mdio {
	status = "okay";

	cpsw3g_phy0: ethernet-phy@3 {
		reg = <3>;
		pinctrl-names = "default";
		pinctrl-0 = <&main_rgmii_phy0_gpio>;
		interrupt-parent = <&main_gpio0>;
		interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&main_gpio0 2 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10>;
		reset-deassert-us = <200>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_25_NS>;
		ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
	};

	cpsw3g_phy1: ethernet-phy@1 {
		reg = <1>;
		pinctrl-names = "default";
		pinctrl-0 = <&main_rgmii_phy1_gpio>;
		interrupt-parent = <&main_gpio0>;
		interrupts = <41 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&main_gpio0 39 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10>;
		reset-deassert-us = <200>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_25_NS>;
		ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
	};
};

&main_pmx0 {
	main_rgmii_phy0_gpio: main-rgmii-phy0-gpio-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0008, PIN_INPUT, 7) /* ETH_A_RST (J24) OSPI0_DQS.GPIO0_2 */
			AM62X_IOPAD(0x0004, PIN_INPUT, 7) /* ETH_A_INT (G25) OSPI0_LBCLKO.GPIO0_1 */
		>;
	};

	main_rgmii_phy1_gpio: main-rgmii-phy1-gpio-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x00a0, PIN_INPUT, 7) /* ETH_B_RST (K25) GPMC0_WPn.GPIO0_39 */
			AM62X_IOPAD(0x00a8, PIN_INPUT, 7) /* ETH_B_INT(M21) GPMC0_CSn0.GPIO0_41 */
		>;
	};

	main_vdd_sdio_a_gpio: main-vdd-sdio-a-gpio-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0048, PIN_INPUT, 7) /* SDIO_A_PWR_EN (N25) GPMC0_AD3.GPIO0_18 */
		>;
	};

	main_usb_a_reset_pins_default: main-usb-a-reset-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x1a8, PIN_INPUT, 7) /* GPIO_A_3 (D20) MCASP0_AFSX.GPIO1_12 */
		>;
	};
};

&main_gpio1 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_usb_a_reset_pins_default>;

	main-usb-a-reset {
		gpio-hog;
		output-high;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		line-name = "USB_A_RESET";
	};
};

&sdhci1 { /* SDIO_A uSD / M.2_SDIO */
	status = "okay";
	vmmc-supply = <&vdd_mmc1>; /* SDIO_A_PWR_EN */
	vqmmc-supply = <&vdd_sd>; /* VSEL_SD */
	disable-wp; // MMC1_SDWP is just pulled down, so lets not use this.

	ti,driver-strength-ohm = <50>;
};

&usb0 {
	status = "okay";
	dr_mode = "host";
};

&usb1 {
	status = "okay";
	dr_mode = "host";
};

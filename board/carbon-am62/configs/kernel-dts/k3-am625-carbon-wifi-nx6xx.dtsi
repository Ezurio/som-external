#include "k3-am625-carbon-wifi.dtsi"

/ {
	vcc_wifi: regulator-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc_wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_wifi_en_default>;
		gpios = <&main_gpio0 20 GPIO_ACTIVE_HIGH>; /* W_DISABLE1# */
		enable-active-high;
		regulator-always-on;
	};

	vcc_bt: regulator-bt {
		compatible = "regulator-fixed";
		regulator-name = "vcc_bt";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_bt_en_default>;
		gpios = <&main_gpio0 22 GPIO_ACTIVE_HIGH>; /* W_DISABLE2# */
		enable-active-high;
		regulator-always-on;
	};
};

&wifi_pwrseq {
	pinctrl-0 = <&main_wifi_en2_default>;
	reset-gpios = <&main_gpio0 21 GPIO_ACTIVE_LOW>; /* SDIO_RESET# */
};

&sdhci2 { /* SDIO_B  WIFI */
	vmmc-supply = <&vcc_wifi>;
};

&main_uart1 {
	bluetooth {
		compatible = "nxp,88w8987-bt";
		fw-init-baudrate = <3000000>;
	};
};

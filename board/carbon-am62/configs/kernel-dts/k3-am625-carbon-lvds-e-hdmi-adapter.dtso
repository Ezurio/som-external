/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include "ti/k3-pinctrl.h"

&{/} {
	hdmi-connector-lvds-e {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "a";
		digital;

		pinctrl-names = "default";
		pinctrl-0 = <&main_lvds_e_pwr_default>;
		dcc-en-gpios = <&main_gpio0 14 GPIO_ACTIVE_HIGH>;

		ddc-i2c-bus = <&i2c_port_e>;

		/* Reenable after U3 VDD_5V miswiring fixed */
		//hpd-gpios = <&exp2 13 GPIO_ACTIVE_HIGH>;

		port {
			hdmi_connector_lvds_e_in: endpoint {
				remote-endpoint = <&tfp410_e_out>;
			};
		};
	};

	dvi-bridge-lvds-e {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "ti,tfp410";

		port@0 {
			reg = <0>;
			dual-lvds-odd-pixels;
			tfp410_e_in: endpoint {
				remote-endpoint = <&lvds_e_out>;
				pclk-sample = <1>;
				bus-width = <24>;
			};
		};

		port@1 {
			reg = <1>;
			tfp410_e_out: endpoint {
				remote-endpoint = <&hdmi_connector_lvds_d_in>;
			};
		};
	};

	lvds-decoder-e {
		compatible = "ti,ds90cf386", "lvds-decoder";

		max-frequency = <85000000>;
		min-frequency = <20000000>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				dual-lvds-odd-pixels;
				lvds_e_in0: endpoint {
					data-mapping = "jeida-24";
					remote-endpoint = <&oldi_0_out>;
				};
			};

			port@1 {
				reg = <1>;
				lvds_e_out: endpoint {
					remote-endpoint = <&tfp410_e_in>;
				};
			};

			port@2 {
				reg = <2>;
				dual-lvds-even-pixels;
				lvds_d_in1: endpoint {
					remote-endpoint = <&oldi_1_out>;
				};
			};
		};
	};
};

&main_pmx0 {
	/* CAUTION: LVDS_E_VDD_EN is shared with RGB_VDD_EN 
	   as such these functions cannot be used together */
	main_lvds_e_pwr_default: main-lvds-e-pwr-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x038, PIN_INPUT, 7) /* LVDS_E_VDD_EN (E24) OSPI0_CSn3.GPIO0_14 */
		>;
	};
};

&dss {
	status = "okay";
	/* OLDITX ports have no mux on them */
};

&oldi0 {
	status = "okay";
};

&oldi1 {
	status = "okay";
};

&oldi0_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;
		oldi_0_in: endpoint {
			remote-endpoint = <&dpi0_out0>;
		};
	};

	port@1 {
		reg = <1>;
		oldi_0_out: endpoint {
			remote-endpoint = <&lvds_e_in0>;
		};
	};
};

&oldi1_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;
		oldi_1_in: endpoint {
			remote-endpoint = <&dpi0_out1>;
		};
	};

	port@1 {
		reg = <1>;
		oldi_1_out: endpoint {
			remote-endpoint = <&lvds_e_in1>;
		};
	};
};

&dss_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	/* Video Port 1 Output to OLDI */
	port@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;

		dpi0_out0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&oldi_0_in>;
		};

		dpi0_out1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&oldi_1_in>;
		};
	};
};

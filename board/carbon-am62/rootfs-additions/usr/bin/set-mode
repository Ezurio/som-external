#!/bin/sh

if [ -z "${1}" ] ; then
    echo "Usage: $0 <mode> [<mode> ...]"
    echo "  <mode> is one or multiple of:"
    echo "    default - remove all overlays"
    echo "    lvds-d-hdmi"
    echo "    lvds-e-hdmi"
    echo "    rgb-hdmi"
    echo "    rgb-lvds-7"
    echo "    rgb-lvds-10"
    echo "    60-sdio-uart"
    echo "    60-sdio-uart-stop"
    echo "    60-sdio-sdio"
    echo "    lwb-if"
    echo "    ti3xx"
    echo "    nx6xx"
    echo "    m2-60"
    echo "    m2-lwb-if"
    echo "    m2-ti3xx"
    echo "    m2-nx6xx"
    exit 1
fi

prefix="#conf-k3-am625-carbon"
conf=""

for i in "${@}" ; do
    case ${i} in
        default)
            break
            ;;
        lvds-d-hdmi|lvds-e-hdmi|rgb-hdmi|rgb-lvds-7|rgb-lvds-10)
            conf="${conf}${prefix}-${i}-adapter.dtbo"
            ;;
        m2-60|m2-lwb-if|m2-ti3xx|m2-nx6xx)
            conf="${conf}${prefix}-${i}.dtbo"
            ;;
        60-sdio*|lwb-if|ti3xx|nx6xx)
            conf="${conf}${prefix}-wifi-${i}.dtbo"
            ;;
        *)
            echo "Invalid mode"
            exit 1
            ;;
    esac
done

[ -z "${conf}" ] || conf="${prefix}-dvk.dtb${conf}"

cconf=$(fw_printenv -n conf)
if [ "${cconf}" = "${conf}" ] ; then
    echo "Configuration already set"
    exit 0
fi

fw_setenv conf "${conf}"
reboot

/dts-v1/;
/plugin/;

#include "k3-am675-carbon-m2.dtsi"

&reg_wifi_en_m2 {
	regulator-always-on;
};

&pcie0_rc {
	status = "okay";
};

&serdes1 {
	status = "okay";
};

&serdes_wiz1 {
	status = "okay";
};

&mcu_uart0 {
	bluetooth {
		compatible = "brcm,bcm4329-bt";
		vbat-supply = <&vcc_wifi_m2>;
		vddio-supply = <&vdd_1v8_carrier>;
		brcm,requires-autobaud-mode;
		max-speed = <921600>;
		shutdown-gpios = <&exp1 5 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&exp1 7 GPIO_ACTIVE_HIGH>;
	};
};

&wifi_wakeup_m2 {
	status = "disabled";
};

software =
{
	version = "0.1.0";
	bootloader_transaction_marker = false;
	bootloader_state_marker = false;
	hardware-compatibility = [ "1.0" ];

	stable = {
		main-a: {
			images: (
				{
					filename = "kernel.itb";
					volume = "kernel_a";
					type = "ubivol";
					installed-directly = true;
					name = "kernel";
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "rootfs.bin";
					volume = "rootfs_a";
					type = "ubivol";
					installed-directly = true;
					name = "rootfs";
					sha256 = "$swupdate_get_sha256(rootfs.bin)";
				}
			);

			scripts: (
				{
					filename = "erase_data.sh";
					type = "postinstall";
					data = "rootfs_data_a";
					sha256 = "$swupdate_get_sha256(erase_data.sh)";
				}
			);

			bootenv: (
				{
					name = "bootside";
					value = "a";
				}
			);
		};

		main-b: {
			images: (
				{
					filename = "kernel.itb";
					volume = "kernel_b";
					type = "ubivol";
					installed-directly = true;
					name = "kernel";
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "rootfs.bin";
					volume = "rootfs_b";
					type = "ubivol";
					installed-directly = true;
					name = "rootfs";
					sha256 = "$swupdate_get_sha256(rootfs.bin)";
				}
			);

			scripts: (
				{
					filename = "erase_data.sh";
					type = "postinstall";
					data = "rootfs_data_b";
					sha256 = "$swupdate_get_sha256(erase_data.sh)";
				}
			);

			bootenv: (
				{
					name = "bootside";
					value = "b";
				}
			);
		};

		full-a: {
			images: (
				{
					filename = "boot.bin";
					mtdname = "u-boot-spl";
					transform = "atmel_pmecc_header";
					type = "flash";
					name = "boot";
					sha256 = "$swupdate_get_sha256(boot.bin)";
				},
				{
					filename = "u-boot.itb";
					mtdname = "u-boot";
					type = "flash";
					name = "u-boot";
					sha256 = "$swupdate_get_sha256(u-boot.itb)";
				},
				{
					filename = "kernel.itb";
					volume = "kernel_a";
					type = "ubivol";
					installed-directly = true;
					name = "kernel";
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "rootfs.bin";
					volume = "rootfs_a";
					type = "ubivol";
					installed-directly = true;
					name = "rootfs";
					sha256 = "$swupdate_get_sha256(rootfs.bin)";
				}
			);

			scripts: (
				{
					filename = "erase_data.sh";
					type = "postinstall";
					data = "rootfs_data_a";
					sha256 = "$swupdate_get_sha256(erase_data.sh)";
				}
			);

			bootenv: (
				{
					name = "bootside";
					value = "a";
				}
			);
		};

		full-b: {
			images: (
				{
					filename = "boot.bin";
					mtdname = "u-boot-spl";
					transform = "atmel_pmecc_header";
					type = "flash";
					name = "boot";
					sha256 = "$swupdate_get_sha256(boot.bin)";
				},
				{
					filename = "u-boot.itb";
					mtdname = "u-boot";
					type = "flash";
					name = "u-boot";
					sha256 = "$swupdate_get_sha256(u-boot.itb)";
				},
				{
					filename = "kernel.itb";
					volume = "kernel_b";
					type = "ubivol";
					installed-directly = true;
					name = "kernel";
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "rootfs.bin";
					volume = "rootfs_b";
					type = "ubivol";
					installed-directly = true;
					name = "rootfs";
					sha256 = "$swupdate_get_sha256(rootfs.bin)";
				}
			);

			scripts: (
				{
					filename = "erase_data.sh";
					type = "postinstall";
					data = "rootfs_data_b";
					sha256 = "$swupdate_get_sha256(erase_data.sh)";
				}
			);

			bootenv: (
				{
					name = "bootside";
					value = "b";
				}
			);
		};

		complete: {
			/* partitions tag is used to resize UBI partitions */
			partitions: (
				{
					name = "kernel_a";
					device = "ubi";
					type = "ubipartition";
					size = 8388608; /* in bytes */
					data = "static";
					properties: {
						skip-check = "true";
					};
				},
				{
					name = "rootfs_a";
					device = "ubi";
					type = "ubipartition";
					size = 46465024; /* in bytes */
					data = "static";
					properties: {
						skip-check = "true";
					};
				},
				{
					name = "rootfs_data_a";
					device = "ubi";
					type = "ubipartition";
					size = 4194304; /* in bytes */
				},
				{
					name = "kernel_b";
					device = "ubi";
					type = "ubipartition";
					size = 8388608; /* in bytes */
					data = "static";
					properties: {
						skip-check = "true";
					};
				},
				{
					name = "rootfs_b";
					device = "ubi";
					type = "ubipartition";
					size = 46465024; /* in bytes */
					data = "static";
					properties: {
						skip-check = "true";
					};
				},
				{
					name = "rootfs_data_b";
					device = "ubi";
					type = "ubipartition";
					size = 4194304; /* in bytes */
				},
				{
					name = "perm";
					device = "ubi";
					type = "ubipartition";
					size = 6221824; /* in bytes */
				}
			);

			images: (
				{
					filename = "boot.bin";
					mtdname = "u-boot-spl";
					transform = "atmel_pmecc_header";
					type = "flash";
					name = "boot";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(boot.bin)";
				},
				{
					filename = "u-boot.itb";
					mtdname = "u-boot";
					type = "flash";
					name = "u-boot";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(u-boot.itb)";
				},
				{
					filename = "uboot.env";
					mtdname = "u-boot-env-a";
					transform = "ignore_bad";
					type = "flash";
					sha256 = "$swupdate_get_sha256(uboot.env)";
				},
				{
					filename = "uboot.env";
					mtdname = "u-boot-env-b";
					transform = "ignore_bad";
					type = "flash";
					sha256 = "$swupdate_get_sha256(uboot.env)";
				},
				{
					filename = "kernel.itb";
					volume = "kernel_a";
					type = "ubivol";
					installed-directly = true;
					name = "kernel";
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "rootfs.bin";
					volume = "rootfs_a";
					type = "ubivol";
					installed-directly = true;
					name = "rootfs";
					sha256 = "$swupdate_get_sha256(rootfs.bin)";
				}
			);

			scripts: (
				{
					filename = "copy_partitions.sh";
					type = "postinstall";
					data = "kernel_a kernel_b $swupdate_get_file_size_bytes(kernel.itb) $swupdate_get_sha256(kernel.itb)";
					sha256 = "$swupdate_get_sha256(copy_partitions.sh)";
				},
				{
					filename = "copy_partitions.sh";
					type = "postinstall";
					data = "rootfs_a rootfs_b $swupdate_get_file_size_bytes(rootfs.bin) $swupdate_get_sha256(rootfs.bin)";
					sha256 = "$swupdate_get_sha256(copy_partitions.sh)";
				},
				{
					filename = "erase_data.sh";
					type = "postinstall";
					data = "rootfs_data_a rootfs_data_b perm";
					sha256 = "$swupdate_get_sha256(erase_data.sh)";
				}
			);
		};
	};
};

#! /bin/sh

press_on() {
	gpioset -t0 lte_on=0
	sleep 1
	gpioset -t0 lte_on=1
}

press_off() {
	gpioset -t0 lte_fast_shdn=0
	sleep 1
	gpioset -t0 lte_fast_shdn=1
}

case "${1}" in
    on)
        press_on
        ;;

    off)
        press_off
        ;;

    *)
        echo "Usage: $0 [on | off]"
        ;;
esac
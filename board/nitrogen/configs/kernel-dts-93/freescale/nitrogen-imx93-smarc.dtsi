/dts-v1/;

#include <dt-bindings/usb/pd.h>
#include <dt-bindings/leds/common.h>
#include "imx93.dtsi"

/ {
	model = "Ezurio i.MX93 Nitrogen SMARC board";
	compatible = "summit,imx93-nitrogen-smarc", "fsl,imx93";

	aliases {
		can0 = &flexcan1;
		can1 = &flexcan2;
		ethernet0 = &eqos;
		ethernet1 = &fec;
		spi0 = &lpspi3;
		spi1 = &lpspi1;
		gpio4 = &pcal6534;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux_cma: linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0 0x80000000 0 0x40000000>;
			size = <0 0x10000000>;
			linux,cma-default;
		};

		ele_reserved: ele-reserved@a4120000 {
			compatible = "shared-dma-pool";
			reg = <0 0xa4120000 0 0x100000>;
			no-map;
		};
	};

	reg_vdd_5v0: regulator-vdd-5v0 {
		compatible = "regulator-fixed";
		regulator-name = "reg_vdd_5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_vdd_3v3: regulator-vdd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "reg_vdd_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_vdd_1v8: regulator-vdd-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "reg_vdd_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_usdhc2_vmmc: regulator-usdhc2-vmmc {
		compatible = "regulator-fixed";

		regulator-name = "reg_usdhc2_vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
		gpio = <&gpio3 7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_wifi_en: regulator-wifi-en {
		compatible = "regulator-fixed";

		regulator-name = "reg_wifi_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&pcal6534 2 GPIO_ACTIVE_HIGH>; /* P0_2 -> WL_EN */
		enable-active-high;
	};

	reg_usb_otg_vbus: regulator-usb-otg-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_otg_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pcal6534 14 GPIO_ACTIVE_HIGH>; /* P1_6 -> USB0_EN_OC */
		enable-active-high;
	};

	reg_usb_2_vbus: regulator-usb-2-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_2_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pcal6534 13 GPIO_ACTIVE_HIGH>; /* P1_5 -> USB1_EN_OC */
		enable-active-high;
	};

	reg_i2c_mux_som: regulator-i2c-mux-som {
		compatible = "regulator-fixed";
		regulator-name = "reg_i2c_mux_som";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pcal6534 32 GPIO_ACTIVE_HIGH>; /* P4_0 -> I2C_HUB_RESET */
		enable-active-high;
	};
};

&adc1 {
	vref-supply = <&reg_vdd_1v8>;
};

&ele_fw2 {
	memory-region = <&ele_reserved>;
};

&eqos {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_eqos>;
	pinctrl-1 = <&pinctrl_eqos_sleep>;

	phy-mode = "rgmii-id";
	phy-handle = <&ethphy1>;

	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		reset-gpios = <&pcal6534 1 GPIO_ACTIVE_LOW>;
		reset-delay-us = <150000>;
		reset-post-delay-us = <100>;

		ethphy1: ethernet-phy@7 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <7>;

			interrupts-extended = <&gpio2 29 IRQ_TYPE_LEVEL_LOW>;
		};
	};
};

&fec {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_fec>;
	pinctrl-1 = <&pinctrl_fec_sleep>;

	phy-mode = "rgmii-id";
	phy-handle = <&ethphy2>;

	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		reset-gpios = <&pcal6534 0 GPIO_ACTIVE_LOW>;
		reset-delay-us = <150000>;
		reset-post-delay-us = <100>;

		ethphy2: ethernet-phy@7 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <7>;

			interrupts-extended = <&gpio2 18 IRQ_TYPE_LEVEL_LOW>;
		};
	};
};

&flexcan1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexcan1>;
	pinctrl-1 = <&pinctrl_flexcan1_sleep>;
};

&flexcan2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexcan2>;
	pinctrl-1 = <&pinctrl_flexcan2_sleep>;
};

&lpi2c1 { /* PMIC I2C bus, but the PMIC is on lpi2c2 */
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c1>;
	pinctrl-1 = <&pinctrl_lpi2c1>;

	clock-frequency = <400000>;

	#address-cells = <1>;
	#size-cells = <0>;
};

&lpi2c2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c2>;
	pinctrl-1 = <&pinctrl_lpi2c2>;

	clock-frequency = <400000>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	pmic@25 {
		compatible = "nxp,pca9451a";
		reg = <0x25>;
		interrupts-extended = <&pcal6534 28 IRQ_TYPE_EDGE_FALLING>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <2237500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck2: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck4: BUCK4 {
				regulator-name = "BUCK4";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck5: BUCK5 {
				regulator-name = "BUCK5";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck6: BUCK6 {
				regulator-name = "BUCK6";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: LDO4 {
				regulator-name = "LDO4";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo5: LDO5 {
				regulator-name = "LDO5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};

	pcal6534: gpio@22 {
		compatible = "nxp,pcal6534";
		reg = <0x22>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pcal6534>;
		reset-gpios = <&gpio2 28 GPIO_ACTIVE_LOW>; /* GPIO_IO28 */

		vcc-supply = <&reg_vdd_1v8>;

		gpio-controller;
		#gpio-cells = <2>;

		interrupt-controller;
		#interrupt-cells = <2>;
		interrupts-extended = <&gpio2 21 IRQ_TYPE_LEVEL_LOW>;

		gpio-line-names = "P0_0 ENET2", "P0_1 ENET1", "P0_2 WL_EN",
					"P0_3 WIFI_SDIO_WAKE", "P0_4 BT_EN",
					"P0_5 EMMC_RESET", "P0_6 BT_HOST_WAKE",
					"P0_7 ESPI1_CS1",
					"P1_0 CHARGER_PRESENT", "P1_1 ESPI_ALERT0",
					"P1_2 TEST", "P1_3 ETH1_SPEED",
					"P1_4 SD2_WP", "P1_5 USB2_PWR_EN_OC",
					"P1_6 USB1_PWR_EN_OC", "P1_7 GPIO_4",
					"P2_0 LCD0_BCKL_EN", "P2_1 LCD0_VDD_EN",
					"P2_2 CARRIER_STBY", "P2_3 LCD1_BCKL_EN",
					"P2_4 CHARGING", "P2_5 SLEEP",
					"P2_6 BAT_LOW", "P2_7 SMBUS_IRQ",
					"P3_0 GPIO_8", "P3_1 RESET_OUT",
					"P3_2 GPIO_10", "P3_3 GPIO_11",
					"P3_4 PMIC_IRQ", "P3_5 GPIO_13",
					"P3_6 ETH0_SPEED", "P3_7 CARRIER_PWR_ON",
					"P4_0 I2C_HUB_RESET", "P4_1 GPIO_9";
	};

	i2c-mux-som@71 {
		compatible = "nxp,pca9546";
		reg = <0x71>;

		vdd-supply = <&reg_i2c_mux_som>;

		#address-cells = <1>;
		#size-cells = <0>;

		i2c_som_csi0: i2c-mux-som@0 {
			/* CSI0 I2C */
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c_som_lcd: i2c-mux-som@1 {
			/* LCD I2C */
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c_som_csi1: i2c-mux-som@2 {
			/* CSI1 I2C */
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

&lpi2c3 { /* SM_I2C_GP */
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	pinctrl-1 = <&pinctrl_lpi2c3>;

	clock-frequency = <400000>;

	#address-cells = <1>;
	#size-cells = <0>;
};

&lpm {
	soc-supply = <&buck1>;
	status = "okay";
};

&lpspi1 { /* SPI1 */
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi1>;
	pinctrl-1 = <&pinctrl_lpspi1>;

	fsl,spi-num-chipselects = <2>;
	cs-gpios = <0>, <&pcal6534 7 GPIO_ACTIVE_HIGH>;
};

&lpspi3 { /* SPI0 */
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi3>;
	pinctrl-1 = <&pinctrl_lpspi3>;

	fsl,spi-num-chipselects = <2>;
};

&lpuart1 { /* console SER1 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&lpuart2 { /* M33 console SER2 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
};

&lpuart5 {
	/* BT */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>;
	uart-has-rtscts;
};

&lpuart6 { /*  SER3 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart6>;
};

&lpuart8 { /*  SER0 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart8>;
	uart-has-rtscts;
};

&usbotg1 { /* USB0 */
	vbus-supply = <&reg_usb_otg_vbus>;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
};

&usbotg2 { /* USB1 */
	vbus-supply = <&reg_usb_2_vbus>;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
};

&usdhc1 { /* eMMC */
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;

	bus-width = <8>;
	non-removable;

	status = "okay";
};

&usdhc2 { /* SD card */
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-3 = <&pinctrl_usdhc2_sleep>, <&pinctrl_usdhc2_gpio_sleep>;

	cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
	fsl,cd-gpio-wakeup-disable;

	vmmc-supply = <&reg_usdhc2_vmmc>;

	bus-width = <4>;
};

&usdhc3 { /* WiFi / Bluetooth */
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc3_sleep>;

	vmmc-supply = <&reg_wifi_en>;

	bus-width = <4>;
	non-removable;
	keep-power-in-suspend;
};

&wdog3 {
	status = "okay";
};

&tpm5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm5>;
};

&tpm6 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm6>;
};

&dsi {
	ports {
		port@1 {
			dsi_out_ep: endpoint {
			};
		};
	};
};

&iomuxc {
	pinctrl_eqos: eqosgrp {
		fsl,pins = <
			MX93_PAD_ENET1_MDC__ENET_QOS_MDC			0x57e
			MX93_PAD_ENET1_MDIO__ENET_QOS_MDIO			0x57e
			MX93_PAD_ENET1_RD0__ENET_QOS_RGMII_RD0			0x37e
			MX93_PAD_ENET1_RD1__ENET_QOS_RGMII_RD1			0x37e
			MX93_PAD_ENET1_RD2__ENET_QOS_RGMII_RD2			0x37e
			MX93_PAD_ENET1_RD3__ENET_QOS_RGMII_RD3			0x37e
			MX93_PAD_ENET1_RXC__CCM_ENET_QOS_CLOCK_GENERATE_RX_CLK	0x3fe
			MX93_PAD_ENET1_RX_CTL__ENET_QOS_RGMII_RX_CTL		0x57e
			MX93_PAD_ENET1_TD0__ENET_QOS_RGMII_TD0			0x57e
			MX93_PAD_ENET1_TD1__ENET_QOS_RGMII_TD1			0x57e
			MX93_PAD_ENET1_TD2__ENET_QOS_RGMII_TD2			0x57e
			MX93_PAD_ENET1_TD3__ENET_QOS_RGMII_TD3			0x57e
			MX93_PAD_ENET1_TXC__CCM_ENET_QOS_CLOCK_GENERATE_TX_CLK	0x5fe
			MX93_PAD_ENET1_TX_CTL__ENET_QOS_RGMII_TX_CTL		0x57e
			MX93_PAD_GPIO_IO29__GPIO2_IO29				0x131e
		>;
	};

	pinctrl_eqos_sleep: eqosgrpsleep {
		fsl,pins = <
			MX93_PAD_ENET1_MDC__GPIO4_IO00				0x31e
			MX93_PAD_ENET1_MDIO__GPIO4_IO01				0x31e
			MX93_PAD_ENET1_RD0__GPIO4_IO10				0x31e
			MX93_PAD_ENET1_RD1__GPIO4_IO11				0x31e
			MX93_PAD_ENET1_RD2__GPIO4_IO12				0x31e
			MX93_PAD_ENET1_RD3__GPIO4_IO13				0x31e
			MX93_PAD_ENET1_RXC__GPIO4_IO09				0x31e
			MX93_PAD_ENET1_RX_CTL__GPIO4_IO08			0x31e
			MX93_PAD_ENET1_TD0__GPIO4_IO05				0x31e
			MX93_PAD_ENET1_TD1__GPIO4_IO04				0x31e
			MX93_PAD_ENET1_TD2__GPIO4_IO03				0x31e
			MX93_PAD_ENET1_TD3__GPIO4_IO02				0x31e
			MX93_PAD_ENET1_TXC__GPIO4_IO07				0x31e
			MX93_PAD_ENET1_TX_CTL__GPIO4_IO06			0x31e
			MX93_PAD_GPIO_IO29__GPIO2_IO29				0x131e
		>;
	};

	pinctrl_fec: fecgrp {
		fsl,pins = <
			MX93_PAD_ENET2_MDC__ENET1_MDC				0x57e
			MX93_PAD_ENET2_MDIO__ENET1_MDIO				0x57e
			MX93_PAD_ENET2_RD0__ENET1_RGMII_RD0			0x37e
			MX93_PAD_ENET2_RD1__ENET1_RGMII_RD1			0x37e
			MX93_PAD_ENET2_RD2__ENET1_RGMII_RD2			0x37e
			MX93_PAD_ENET2_RD3__ENET1_RGMII_RD3			0x37e
			MX93_PAD_ENET2_RXC__ENET1_RGMII_RXC			0x37e
			MX93_PAD_ENET2_RX_CTL__ENET1_RGMII_RX_CTL		0x57e
			MX93_PAD_ENET2_TD0__ENET1_RGMII_TD0			0x57e
			MX93_PAD_ENET2_TD1__ENET1_RGMII_TD1			0x57e
			MX93_PAD_ENET2_TD2__ENET1_RGMII_TD2			0x57e
			MX93_PAD_ENET2_TD3__ENET1_RGMII_TD3			0x57e
			MX93_PAD_ENET2_TXC__ENET1_RGMII_TXC			0x57e
			MX93_PAD_ENET2_TX_CTL__ENET1_RGMII_TX_CTL		0x57e
			MX93_PAD_GPIO_IO18__GPIO2_IO18				0x131e
		>;
	};

	pinctrl_fec_sleep: fecsleepgrp {
		fsl,pins = <
			MX93_PAD_ENET2_MDC__GPIO4_IO14				0x51e
			MX93_PAD_ENET2_MDIO__GPIO4_IO15				0x51e
			MX93_PAD_ENET2_RD0__GPIO4_IO24				0x51e
			MX93_PAD_ENET2_RD1__GPIO4_IO25				0x51e
			MX93_PAD_ENET2_RD2__GPIO4_IO26				0x51e
			MX93_PAD_ENET2_RD3__GPIO4_IO27				0x51e
			MX93_PAD_ENET2_RXC__GPIO4_IO23				0x51e
			MX93_PAD_ENET2_RX_CTL__GPIO4_IO22			0x51e
			MX93_PAD_ENET2_TD0__GPIO4_IO19				0x51e
			MX93_PAD_ENET2_TD1__GPIO4_IO18				0x51e
			MX93_PAD_ENET2_TD2__GPIO4_IO17				0x51e
			MX93_PAD_ENET2_TD3__GPIO4_IO16				0x51e
			MX93_PAD_ENET2_TXC__GPIO4_IO21				0x51e
			MX93_PAD_ENET2_TX_CTL__GPIO4_IO20			0x51e
			MX93_PAD_GPIO_IO18__GPIO2_IO18				0x131e
		>;
	};

	pinctrl_lpi2c1: lpi2c1grp {
		fsl,pins = <
			MX93_PAD_I2C1_SCL__LPI2C1_SCL				0x40000b9e
			MX93_PAD_I2C1_SDA__LPI2C1_SDA				0x40000b9e
		>;
	};

	pinctrl_lpi2c2: lpi2c2grp {
		fsl,pins = <
			MX93_PAD_I2C2_SCL__LPI2C2_SCL				0x40000b9e
			MX93_PAD_I2C2_SDA__LPI2C2_SDA				0x40000b9e
		>;
	};

	pinctrl_lpi2c3: lpi2c3grp {
		fsl,pins = <
			MX93_PAD_GPIO_IO00__LPI2C3_SDA				0x40000b9e
			MX93_PAD_GPIO_IO01__LPI2C3_SCL				0x40000b9e
			MX93_PAD_GPIO_IO02__GPIO2_IO02				0x31e
		>;
	};

	pinctrl_flexcan1: flexcan1grp {
		fsl,pins = <
			MX93_PAD_PDM_CLK__CAN1_TX				0x139e
			MX93_PAD_PDM_BIT_STREAM0__CAN1_RX			0x139e
		>;
	};

	pinctrl_flexcan1_sleep: flexcan1sleepgrp {
		fsl,pins = <
			MX93_PAD_PDM_CLK__GPIO1_IO08				0x31e
			MX93_PAD_PDM_BIT_STREAM0__GPIO1_IO09			0x31e
		>;
	};

	pinctrl_flexcan2: flexcan2grp {
		fsl,pins = <
			MX93_PAD_GPIO_IO25__CAN2_TX				0x139e
			MX93_PAD_GPIO_IO27__CAN2_RX				0x139e
		>;
	};


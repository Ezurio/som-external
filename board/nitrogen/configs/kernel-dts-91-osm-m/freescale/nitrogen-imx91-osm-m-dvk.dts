/*
 * Nitrogen i.MX93 OSM-M Carrier (DVK)
 *
 * Copyright 2026 Ezurio LLC
 */

/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/net/ti-dp83867.h>

#include "nitrogen-imx91-osm-m.dtsi"

/ {
	model = "Ezurio Nitrogen i.MX91 OSM-M DVK";
	compatible = "summit,nitrogen-imx91-osm-m-dvk", "summit,nitrogen-imx91-osm-m", "fsl,imx91";

	aliases {
		gpio5 = &exp1;
		gpio6 = &exp2;
	};

	reg_can1_stby: regulator-can1-stby {
		compatible = "regulator-fixed";
		regulator-name = "reg_can1_stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpios = <&exp1 2 GPIO_ACTIVE_HIGH>;	/* CAN_A_STB (HIGH=standby on TCAN1046) */
		enable-active-low;
	};

	reg_can2_stby: regulator-can2-stby {
		compatible = "regulator-fixed";
		regulator-name = "reg_can2_stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&exp1 3 GPIO_ACTIVE_HIGH>;	/* CAN_B_STB (HIGH=standby on TCAN1046) */
		enable-active-low;
	};

	reg_aud_3v3_carrier: regulator-aud-3v3-carrier {
		compatible = "regulator-fixed";
		regulator-name = "reg_aud_3v3_carrier";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_3v3>;
		gpio = <&exp1 8 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	codec_audio: sound {
		compatible = "simple-audio-card";

		simple-audio-card,bitclock-master = <&dailink0_master>;
		simple-audio-card,frame-master = <&dailink0_master>;

		simple-audio-card,name = "ti,tac5x1x-soundcard";
		simple-audio-card,format = "i2s";

		simple-audio-card,widgets =
			"Headphone", "Headphone Jack",
			"Line",      "Line In",
			"Line",      "Line Out";

		simple-audio-card,routing =
			"Headphone Jack", "OUT1",
			"Headphone Jack", "OUT2",
			"AIN1", "Line In",
			"AIN2", "Line In",
			"Line Out", "OUT1",
			"Line Out", "OUT2";

		simple-audio-card,aux-devs = <&headset>;

		dailink0_master: simple-audio-card,cpu {
			sound-dai = <&sai3>;
			clocks = <&clk IMX93_CLK_SAI3_GATE>;
			bitclock-master;
			frame-master;
		};

		simple-audio-card,codec {
			sound-dai = <&tac5112>;
		};
	};

	dvk_keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_osm_gpio_a_7>;

		volume-up {
			label = "Volume Up";
			interrupts-extended = <&exp2 12 IRQ_TYPE_EDGE_FALLING>;
			interrupt-names = "irq";
			linux,code = <KEY_VOLUMEUP>;

			//gpios = <&exp2 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};

		volume-down {
			label = "Volume Down";
			interrupts-extended = <&exp2 13 IRQ_TYPE_EDGE_FALLING>;
			interrupt-names = "irq";
			linux,code = <KEY_VOLUMEDOWN>;

			//gpios = <&exp2 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};

		wakeup {
			label = "Wakeup";
			interrupts-extended = <&gpio1 10 IRQ_TYPE_EDGE_FALLING>; /* GPIO_A_7 / WAKEUP_BUTTON */
			interrupt-names = "irq";
			linux,code = <KEY_WAKEUP>;
			wakeup-source;

			//gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led0 {
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&exp0 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&eqos { /* ETH_A */
	status = "okay";

	phy-handle = <&eth_phy0>;

	mdio {
		reset-gpios = <&exp0 4 GPIO_ACTIVE_LOW>;	/* ETH_A_RST */
		reset-delay-us = <10000>;
		reset-post-delay-us = <20000>;

		eth_phy0: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;

			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_osm_gpio_a_2>;	/* ETH_A_INT */
			interrupts-extended = <&gpio2 29 IRQ_TYPE_LEVEL_LOW>;	/* GPIO_A_2 / ETH_A_INT */

			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			tx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
			rx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
			ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
		};
	};
};

&fec { /* ETH_B */
	status = "okay";

	phy-handle = <&eth_phy1>;

	mdio {
		reset-gpios = <&exp0 22 GPIO_ACTIVE_LOW>;	/* ETH_B_RST */
		reset-delay-us = <10000>;
		reset-post-delay-us = <20000>;

		eth_phy1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;

			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_osm_gpio_c_1>;	/* ETH_B_INTR */
			interrupts-extended = <&gpio4 29 IRQ_TYPE_LEVEL_LOW>;	/* GPIO_C_1 / ETH_B_INTR */

			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			tx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
			rx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
			ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
		};
	};
};

&flexcan1 { /* CAN_A */
	status = "okay";
	xceiver-supply = <&reg_can1_stby>;
};

&flexcan2 { /* CAN_B */
	status = "okay";
	xceiver-supply = <&reg_can2_stby>;
};

&lpspi1 { /* SPI_A */
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		spi-max-frequency = <24000000>;
		reg = <0>;
	};
};

&lpuart2 { /* UART_C */
	status = "okay";
};

&lpuart6 { /* UART_A */
	status = "okay";
};

&lpuart8 { /* UART_B */
	status = "okay";
};

&sai3 { /* I2S_A / TAC5112 */
	status = "okay";

	assigned-clocks = <&clk IMX93_CLK_SAI3>;
	assigned-clock-parents = <&clk IMX93_CLK_AUDIO_PLL>;
	assigned-clock-rates = <24576000>;

	fsl,sai-mclk-direction-output;
};

&lpi2c1 { /* I2C_A */
	status = "okay";

	power-sensor-5v@40 {
		compatible = "ti,ina232"; /* TI, INA232AIDDFR */
		reg = <0x40>;
		vs-supply = <&reg_3v3>;
		shunt-resistor = <33000>; /* 0.033 Ohms */
	};

	power-sensor-3v3@41 {
		compatible = "ti,ina232"; /* TI, INA232AIDDFR */
		reg = <0x41>;
		vs-supply = <&reg_3v3>;
		shunt-resistor = <33000>; /* 0.033 Ohms */
	};

	eeprom@54 {
		/* U53, Giantec, GT24C256C-2GLI-TR */
		compatible = "atmel,24c256";
		reg = <0x54>;
		vcc-supply = <&reg_1v8>;
	};

	exp1: gpio@74 {
		/* U35, TI, TCAL9539RTWR */
		compatible = "ti,tcal9539", "nxp,pcal9535";
		reg = <0x74>;

		vcc-supply = <&reg_1v8>;

		#gpio-cells = <2>;
		gpio-controller;

		gpio-line-names =
			"USB_C_OEn_P00", "USB_D_OEn_P01",
			"CAN_A_STB", "CAN_B_STB",
			"M2_WDISABLE1#", "M2_WDISABLE2#",
			"CSI_PWR_CTL_A", "CSI_PWR_CTL_B",
			"AUD_PWR_EN", "M2_Vendor_DF38",
			"CSI_PWR_CTL_C", "CHGR_CE#",
			"M2_POWER_EN", "CSI_PWR_CTL_B",
			"SDIO_A_SEL", "NC";
	};

	exp2: gpio@27 {
		/* U21, Microchip, MCP23018 */
		compatible = "microchip,mcp23018";
		reg = <0x27>;

		#gpio-cells = <2>;
		gpio-controller;

		gpio-line-names =
			"DSI_A_INT", "DSI_A_HPD",
			"LVDS_D_INT", "LVDS_D_HPD",
			"LVDS_E_INT", "LVDS_E_HPD",
			"RGB_INT", "RGB_HDMI_HPD",
			"ACD_nINT", "M2_UART_WAKE",
			"M2_SD_HOST_WAKE", "CHRGR_INTn",
			"VOL_UP", "VOL_DOWN",
			"", "DSI_A_IRQ";

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_osm_gpio_a_3>;

		#interrupt-cells = <2>;
		interrupt-controller;
		microchip,irq-mirror;

		interrupts-extended = <&gpio2 11 IRQ_TYPE_EDGE_FALLING>; /* GPIO_A_3 */
		interrupt-names = "irq";
	};

	tac5112: audio-codec@51 {
		#sound-dai-cells = <0>;
		compatible = "ti,tac5112";
		reg = <0x51>;

		ti,vref = <0>;	/* 2.75V */
		ti,micbias-vg = <0>; /* same as Vref */
		ti,gpios-func = <0>, <0>, <0>;
		ti,gpi1-func = <0>;

		avdd-supply = <&reg_aud_3v3_carrier>;
		iovdd-supply = <&reg_1v8>;
	};

	headset: ts3a227e@3b {
		compatible = "ti,ts3a227e";
		reg = <0x3b>;

		interrupts-extended = <&exp2 8 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "irq";
		ti,micbias = <6>;	/* 2.7V, must match mic bias from codec */
	};
};

&usdhc2 { /* SDIO_A (uSD / M.2 socket) */
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-3 = <&pinctrl_usdhc2_sleep>, <&pinctrl_usdhc2_gpio_sleep>;

	cd-gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;
	fsl,cd-gpio-wakeup-disable;

	status = "okay";
};

&usbotg1 { /* USB_A */
	status = "okay";

	hnp-disable;
	srp-disable;
	adp-disable;
	disable-over-current;
};

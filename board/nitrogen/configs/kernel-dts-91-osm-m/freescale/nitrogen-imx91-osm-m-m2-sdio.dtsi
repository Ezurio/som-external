/*
 * M.2 SDIO Wi-Fi common functions (carrier-side)
 *
 * Copyright 2026 Ezurio LLC
 *
 * Carrier .dts must provide: &exp1, &exp2, &reg_3v3, &reg_1v8
 */

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/gpio-keys.h>

#include "imx91-pinfunc.h"

&{/} {
	reg_m2_power_en: regulator-m2-power-en {
		compatible = "regulator-fixed";
		regulator-name = "reg_m2_power_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		vin-supply = <&reg_3v3>;

		gpio = <&exp1 12 GPIO_ACTIVE_HIGH>; /* M2_POWER_EN */
		enable-active-high;

		regulator-always-on;
	};

	reg_m2_wifi_en: regulator-m2-wifi-en {
		compatible = "regulator-fixed";

		regulator-name = "reg_m2_wifi_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		vin-supply = <&reg_m2_power_en>;

		gpio = <&exp1 4 GPIO_ACTIVE_HIGH>; /* M2_WDISABLE1# */
		enable-active-high;

		startup-delay-us = <250000>;
		off-on-delay-us = <100>;
	};

	reg_vsel_usdhc2: regulator-vsel-usdhc2 {
		compatible = "regulator-fixed";

		regulator-name = "reg_vsel_usdhc2";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_usdhc2_vsel>;
		gpio = <&gpio3 19 GPIO_ACTIVE_HIGH>; /* SD2_VSELECT */
		enable-active-high;
		regulator-always-on;
	};

	wifi_wakeup_m2: wifi_wakeup_m2 {
		compatible = "gpio-keys";

		status = "disabled";

		wifi-wake-up-m2 {
			label = "Wi-Fi Wake Up M2";
			gpios = <&exp2 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_WAKEUP>;
			wakeup-event-action = <EV_ACT_ASSERTED>;
			wakeup-source;
		};

		bt-wake-up-m2 {
			label = "BT Wake Up M2";
			gpios = <&exp2 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_WAKEUP>;
			wakeup-event-action = <EV_ACT_ASSERTED>;
			wakeup-source;
		};
	};
};

&lpuart8 { /* M.2 BT_UART via OSM UART_B */
	status = "okay";

	uart-has-rtscts;
};

&exp1 {
	sdio_a_sel_hog {
		gpio-hog;
		output-high;
		gpios = <14 GPIO_ACTIVE_HIGH>;
	};

	uart_b_sel_hog {
		gpio-hog;
		output-high;
		gpios = <15 GPIO_ACTIVE_HIGH>;
	};
};

&usdhc2 { /* SDIO_A: M.2 SDIO socket */
	pinctrl-0 = <&pinctrl_usdhc2>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc2_sleep>;

	status = "okay";

	vmmc-supply = <&reg_m2_wifi_en>;
	vqmmc-supply = <&reg_vsel_usdhc2>;

	non-removable;
	keep-power-in-suspend;

	#address-cells = <1>;
	#size-cells = <0>;
};

&iomuxc {
	pinctrl_usdhc2_vsel: usdhc2vselgrp {
		fsl,pins = <
			MX91_PAD_SD2_VSELECT__GPIO3_IO19	0x51e
		>;
	};
};

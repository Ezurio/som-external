/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

#include "imx8mm-pinfunc.h"

&reg_wifi_en {
	startup-delay-us = <10000>;
	off-on-delay-us = <100>;
};

&usdhc3 {
	status = "okay";

	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";
	};
};

&uart3 {
 	status = "okay";

	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_wifi_en>;
		max-speed = <115200>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_bt_wake>;
		host-wakeup-gpios = <&gpio3 14 GPIO_ACTIVE_HIGH>;
	};
};

&iomuxc {
	pinctrl_bt_wake: bt-wakegrp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_DQS_GPIO3_IO14	0x180
		>;
	};
};	

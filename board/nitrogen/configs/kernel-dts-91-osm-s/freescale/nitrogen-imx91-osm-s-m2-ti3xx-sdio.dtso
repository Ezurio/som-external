/*
 * M.2 SDIO TI CC33xx Wi-Fi/BT
 *
 * Copyright 2026 Ezurio LLC
 */

/dts-v1/;
/plugin/;

#include "nitrogen-imx91-osm-s-m2-sdio.dtsi"

&reg_m2_wifi_en {
	startup-delay-us = <10000>;
};

&usdhc2 {
	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";
	};
};

&lpuart6 {
	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_m2_wifi_en>;
		max-speed = <115200>;
	};
};

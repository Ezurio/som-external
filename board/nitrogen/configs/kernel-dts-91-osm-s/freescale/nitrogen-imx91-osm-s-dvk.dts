/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/net/ti-dp83867.h>

#include "nitrogen-imx91-osm-s.dtsi"

/ {
	model = "Ezurio Nitrogen i.MX91 OSM-S DVK";
	compatible = "summit,nitrogen-imx91-osm-s-dvk", "summit,nitrogen-imx91-osm-s", "fsl,imx91";

	aliases {
		gpio4 = &exp1;
		gpio5 = &exp2;
	};

	reg_can1_stby: regulator-can1-stby {
		compatible = "regulator-fixed";
		regulator-name = "reg_can1_stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpios = <&exp1 2 GPIO_ACTIVE_HIGH>;	/* CAN_A_STB (HIGH=standby on TCAN1046) */
		enable-active-low;
	};

	dvk_keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_osm_gpio_a_7>;

		wakeup {
			label = "Wakeup";
			interrupts-extended = <&gpio1 10 IRQ_TYPE_LEVEL_LOW>;
			interrupt-names = "irq";
			linux,code = <KEY_WAKEUP>;
			wakeup-source;

			//gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};
	};

	leds {
		compatible = "gpio-leds";

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_osm_gpio_a_0>;

		led0 {
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio2 12 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&eqos { /* ETH_A */
	status = "okay";

	phy-handle = <&eth_phy0>;

	mdio {
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_osm_gpio_a_1>;	/* ETH_A_RST */

		reset-gpios = <&gpio2 13 GPIO_ACTIVE_LOW>;	/* GPIO_A_1 / ETH_A_RST */
		reset-delay-us = <150>;
		reset-post-delay-us = <300>;

		eth_phy0: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;

			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_osm_gpio_a_2>;	/* ETH_A_INT */
			interrupts-extended = <&gpio2 14 IRQ_TYPE_LEVEL_LOW>;	/* GPIO_A_2 / ETH_A_INT */

			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			tx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
			rx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
			ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
		};
	};
};

&flexcan1 { /* CAN_A */
	status = "okay";
	xceiver-supply = <&reg_can1_stby>;
};

&lpspi4 { /* SPI_A */
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		spi-max-frequency = <24000000>;
		reg = <0>;
	};
};

&lpuart2 { /* UART_A */
	status = "okay";
};

&lpuart6 { /* UART_B */
	status = "okay";
};

&lpi2c2 { /* I2C_A */
	status = "okay";

	power-sensor-5v@40 {
		compatible = "ti,ina232"; /* TI, INA232AIDDFR */
		reg = <0x40>;
		vs-supply = <&reg_3v3>;
		shunt-resistor = <33000>; /* 0.033 Ohms */
	};

	power-sensor-3v3@41 {
		compatible = "ti,ina232"; /* TI, INA232AIDDFR */
		reg = <0x41>;
		vs-supply = <&reg_3v3>;
		shunt-resistor = <33000>; /* 0.033 Ohms */
	};

	eeprom@54 {
		/* U53, Giantec, GT24C256C-2GLI-TR */
		compatible = "atmel,24c256";
		reg = <0x54>;
		vcc-supply = <&reg_1v8>;
	};

	exp1: gpio@74 {
		/* U35, TI, TCAL9539RTWR */
		compatible = "ti,tcal9539", "nxp,pcal9535";
		reg = <0x74>;

		vcc-supply = <&reg_1v8>;

		#gpio-cells = <2>;
		gpio-controller;

		gpio-line-names =
			"USB_C_OEn_P00", "USB_D_OEn_P01",
			"CAN_A_STB", "CAN_B_STB",
			"M2_WDISABLE1#", "M2_WDISABLE2#",
			"CSI_PWR_CTL_A", "CSI_PWR_CTL_B",
			"AUD_PWR_EN", "M2_Vendor_DF38", "CSI_PWR_CTL_C",
			"CHGR_CE#", "M2_POWER_EN",
			"CSI_PWR_CTL_B", "SDIO_A_SEL", "NC";
	};

	exp2: gpio@27 {
		/* U21, Microchip, MCP23018 */
		compatible = "microchip,mcp23018";
		reg = <0x27>;

		#gpio-cells = <2>;
		gpio-controller;

		gpio-line-names =
			"DSI_A_INT", "DSI_A_HPD",
			"LVDS_D_INT", "LVDS_D_HPD",
			"LVDS_E_INT", "LVDS_E_HPD",
			"RGB_INT", "RGB_HDMI_HPD",
			"ACD_nINT", "M2_UART_WAKE",
			"M2_SD_HOST_WAKE", "CHRGR_INTn",
			"VOL_UP", "VOL_DOWN",
			"", "DSI_A_IRQ";

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_osm_gpio_a_3>;

		#interrupt-cells = <2>;
		interrupt-controller;
		microchip,irq-mirror;

		interrupts-extended = <&gpio2 15 IRQ_TYPE_EDGE_FALLING>; /* GPIO_A_3 */
		interrupt-names = "irq";
	};
};

&usdhc2 { /* SDIO_A (uSD / M.2 socket) */
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-3 = <&pinctrl_usdhc2_sleep>, <&pinctrl_usdhc2_gpio_sleep>;

	cd-gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;
	fsl,cd-gpio-wakeup-disable;

	status = "okay";
};

&usbotg1 { /* USB_A */
	status = "okay";

	hnp-disable;
	srp-disable;
	adp-disable;
	disable-over-current;
};

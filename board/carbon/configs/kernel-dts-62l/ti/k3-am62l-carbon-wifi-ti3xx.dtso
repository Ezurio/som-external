/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

#include "k3-pinctrl.h"

&reg_wifi_en {
	startup-delay-us = <10000>;
	off-on-delay-us = <100>;
};

&main_wifi_wake_default {
	pinctrl-single,pins = <
		AM62LX_IOPAD(0x018c, PIN_INPUT_PULLDOWN, 7) /* SDIO_WAKE# (B9) MCASP0_AXR0.GPIO0_82 */
	>;
};

&main_bt_wake_pins_default {
	pinctrl-single,pins = <
		AM62LX_IOPAD(0x0050, PIN_INPUT_PULLDOWN, 7) /* BT_HOST_WAKE (E23) OSPI0_D2.GPIO0_5 */
	>;
};

&sdhci2 { /* SDIO_B  WIFI */
	status = "okay";

	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";

		pinctrl-names = "default";
		pinctrl-0 = <&main_wifi_wake_default>;
		//interrupts-extended = <&main_gpio0 82 IRQ_TYPE_EDGE_RISING>;
	};
};

&main_uart1 {
 	status = "okay";

	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_wifi_en>;
		max-speed = <115200>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_bt_wake_pins_default>;
		host-wakeup-gpios = <&main_gpio0 5 GPIO_ACTIVE_HIGH>;
	};
};

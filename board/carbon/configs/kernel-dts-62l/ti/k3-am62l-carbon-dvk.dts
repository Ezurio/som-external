/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/net/ti-dp83867.h>

#include "k3-am62l-carbon-som.dtsi"

/ {
	model = "Summit Carbon AM62l OSM Carrier Board";
	compatible = "summit,carbon-am62l-dvk", "summit,carbon-am62l", "ti,am62l3";

	aliases {
		gpio4 = &exp1;
		gpio5 = &exp2;
	};

	reg_3v3_carrier: regulator-3v3-carrier {
		/* output 2 of U4 */
		compatible = "regulator-fixed";
		regulator-name = "reg_3v3_carrier";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_1v8_carrier: regulator-1v8-carrier {
		/* output 3 of U4 */
		compatible = "regulator-fixed";
		regulator-name = "reg_1v8_carrier";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_aud_3v3_carrier: regulator-aud-3v3-carrier {
		compatible = "regulator-fixed";
		regulator-name = "reg_aud_3v3_carrier";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&exp1 8 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	reg_usb0_vbus: regulator-usb0-vbus {
		compatible = "regulator-fixed";
		regulator-name = "reg_usb0_vbus";
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		vin-supply = <&reg_5v0>;
		pinctrl-names = "default";
		pinctrl-0 = <&main_usb0_en_pins_default>;
		gpios = <&main_gpio0 124 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	codec_audio: sound {
		compatible = "simple-audio-card";

		simple-audio-card,bitclock-master = <&dailink0_master>;
		simple-audio-card,frame-master = <&dailink0_master>;

		simple-audio-card,name = "ti,tac5x1x-soundcard";
		simple-audio-card,format = "i2s";

		simple-audio-card,widgets =
			"Headphone", "Headphone Jack",
			"Line",      "Line In",
			"Line",      "Line Out";

		simple-audio-card,routing =
			"Headphone Jack", "OUT1",
			"Headphone Jack", "OUT2",
			"AIN1", "Line In",
			"AIN2", "Line In",
			"Line Out", "OUT1",
			"Line Out", "OUT2";

		simple-audio-card,aux-devs = <&headset>;

		dailink0_master: simple-audio-card,cpu {
			sound-dai = <&mcasp2>;
			bitclock-master;
			frame-master;
			system-clock-direction-out;
		};

		simple-audio-card,codec {
			sound-dai = <&tac5112>;
		};
	};

	dvk_keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&osm_gpio_a_7_pins_default>;

		volume-up {
			label = "Volume Up";
			interrupts-extended = <&exp2 12 IRQ_TYPE_EDGE_FALLING>;
			interrupt-names = "irq";
			linux,code = <KEY_VOLUMEUP>;

			//gpios = <&exp2 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};

		volume-down {
			label = "Volume Down";
			interrupts-extended = <&exp2 13 IRQ_TYPE_EDGE_FALLING>;
			interrupt-names = "irq";
			linux,code = <KEY_VOLUMEDOWN>;

			//gpios = <&exp2 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};

		wakeup {
			label = "Wakeup";
			interrupts-extended = <&main_gpio0 88 IRQ_TYPE_EDGE_FALLING>;
			interrupt-names = "irq";
			linux,code = <KEY_WAKEUP>;
			wakeup-source;

			//gpios = <&mcu_gpio0 1 GPIO_ACTIVE_LOW>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};
	};

	transceiver1: can-phy0 {
		compatible = "ti,tcan1046", "ti,tcan1042";
		#phy-cells = <0>;
		max-bitrate = <8000000>;
		standby-gpios = <&exp1 2 GPIO_ACTIVE_HIGH>; /* TCAN1046 STB is active HIGH */
	};

	transceiver2: can-phy1 {
		compatible = "ti,tcan1046", "ti,tcan1042";
		#phy-cells = <0>;
		max-bitrate = <8000000>;
		standby-gpios = <&exp1 3 GPIO_ACTIVE_HIGH>; /* TCAN1046 STB is active HIGH */
	};

	con_usb0: connector-usb0 {
		compatible = "gpio-usb-b-connector", "usb-c-connector";

		label = "USB_A";
		self-powered;

		id-gpios = <&exp0 10 GPIO_ACTIVE_HIGH>;

		vbus-supply = <&reg_usb0_vbus>;

		port {
			usb0_dr_connector: endpoint {
				remote-endpoint = <&usb0_ep>;
			};
		};
	};

	mdio_gpio_fanout: mdio-gpio-fanout {
		compatible = "gpio-fanout";
		gpio-controller;
		#gpio-cells = <2>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_rgmii_phy0_rst_pins_default>;
		gpios = <&main_gpio0 83 GPIO_ACTIVE_HIGH>,
		        <&exp0 12 GPIO_ACTIVE_HIGH>;
	};
};

&cpsw3g {
	status = "okay";
};

&cpsw_port1 {
	status = "okay";
	phy-handle = <&cpsw3g_phy0>;
};

&cpsw_port2 {
	status = "okay";
	phy-handle = <&cpsw3g_phy1>;
};

&cpsw3g_mdio {
	status = "okay";

	reset-gpios = <&mdio_gpio_fanout 0 GPIO_ACTIVE_LOW>;
	/* longer to wait for io expander */
	reset-delay-us = <10000>;
	reset-post-delay-us = <20000>;

	cpsw3g_phy0: ethernet-phy@3 {
		reg = <3>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_rgmii_phy0_irq_pins_default>;
		interrupts-extended = <&main_gpio0 84 IRQ_TYPE_EDGE_FALLING>;

		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		tx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		rx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
	};

	cpsw3g_phy1: ethernet-phy@1 {
		reg = <1>;

		interrupts-extended = <&exp0 13 IRQ_TYPE_EDGE_FALLING>;

		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		tx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		rx-fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,clk-output-sel = <DP83867_CLK_O_SEL_OFF>;
	};
};

&osm_gpio_a_3_pins_default {
	pinctrl-single,pins = <
		AM62LX_IOPAD(0x004c, PIN_INPUT_PULLUP, 7) /* GPIO_A_3 (D21) OSPI0_D1.GPIO0_4 */
	>;
};

&main_i2c0 { /* I2C_A */
	status = "okay";
	clock-frequency = <400000>;

	power-sensor-5v@40 {
		compatible = "ti,ina232"; /* TI, INA232AIDDFR */
		reg = <0x40>;
		vs-supply = <&reg_3v3_carrier>;
		shunt-resistor = <33000>; /* 0.033 Ohms */
	};

	power-sensor-3v3@41 {
		compatible = "ti,ina232"; /* TI, INA232AIDDFR */
		reg = <0x41>;
		vs-supply = <&reg_3v3_carrier>;
		shunt-resistor = <33000>; /* 0.033 Ohms */
	};

	eeprom@54 {
		/* U53, Giantec, GT24C256C-2GLI-TR */
		compatible = "atmel,24c256";
		reg = <0x54>;
		vcc-supply = <&reg_1v8_carrier>;
	};

	exp1: gpio@74 {
		/* U35, TI, TCAL9539RTWR */
		compatible = "ti,tcal9539", "nxp,pcal9535";
		reg = <0x74>;

		vcc-supply = <&reg_1v8_carrier>;

		#gpio-cells = <2>;
		gpio-controller;

		gpio-line-names = "USB_C_OEn_P00", "USB_D_OEn_P01",
			"CAN_A_STB", "CAN_B_STB",
			"M2_WDISABLE1#", "M2_WDISABLE2#",
			"CSI_PWR_CTL_A", "CSI_PWR_CTL_B",
			"AUD_PWR_EN", "M2_Vendor_DF38", "CSI_PWR_CTL_C",
			"CHGR_CE#", "M2_POWER_EN",
			"CSI_PWR_CTL_B", "SDIO_A_SEL", "NC";
	};

	exp2: gpio@27 {
		/* U21, Microchip, MCP23018 */
		compatible = "microchip,mcp23018";
		reg = <0x27>;
		#gpio-cells = <2>;
		gpio-controller;

		gpio-line-names =
			"DSI_A_INT", "DSI_A_HPD",
			"LVDS_D_INT", "LVDS_D_HPD",
			"LVDS_E_INT", "LVDS_E_HPD",
			"RGB_INT", "RGB_HDMI_HPD",
			"ACD_nINT", "M2_UART_WAKE",
			"M2_SD_HOST_WAKE", "CHRGR_INTn",
			"VOL_UP", "VOL_DOWN",
			"", "DSI_A_IRQ";

		pinctrl-names = "default";
		pinctrl-0 = <&osm_gpio_a_3_pins_default>;

		#interrupt-cells = <2>;
		interrupt-controller;
		microchip,irq-mirror;

		interrupts-extended = <&main_gpio0 4 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "irq";
		//wakeup-source;
	};

	tac5112: audio-codec@51 {
		/* U19, TI, XTAC5112IRGER */
		#sound-dai-cells = <0>;
		compatible = "ti,tac5112";
		reg = <0x51>;

		ti,vref = <0>;  /* 2.75V */
		ti,micbias-vg = <0>; /* same as Vref */
		ti,gpios-func = <0>, <0>, <0>; /* GPIOx - Disable */
		ti,gpi1-func = <0>;

		avdd-supply = <&reg_aud_3v3_carrier>;
		iovdd-supply = <&reg_1v8_carrier>;
	};

	headset: ts3a227e@3b {
		/* U20, TI, TS3A227ERVAR */
		compatible = "ti,ts3a227e";
		reg = <0x3b>;

		interrupts-extended = <&exp2 8 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "irq";
		ti,micbias = <6>; /* 2.7V, must match mic bias from codec */
	};
};

&mcasp2 {
	status = "okay";
};

&main_i2c1 { /* I2C_B */
	status = "okay";
};

&main_mcan1 { /* CAN_A */
	status = "okay";
	phys = <&transceiver1>;
};

&main_mcan2 { /* CAN_B */
	status = "okay";
	phys = <&transceiver2>;
};

&main_usb0_en_pins_default {
	pinctrl-single,pins = <
		AM62LX_IOPAD(0x244, PIN_INPUT, 7) /* USB_A_EN (C6) USB0_DRVVBUS.GPIO0_124 */
	>;
};

&osm_gpio_a_7_pins_default {
	pinctrl-single,pins = <
		AM62LX_IOPAD(0x01a4, PIN_INPUT_PULLUP, 7) /* GPIO_A_7 (D11) SPI0_CS1.GPIO0_88 */
	>;
};

&main_spi0 { /* SPI_B */
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		spi-max-frequency = <24000000>;
		reg = <0>;
	};
};

&wkup_uart0 { /* UART_C */
	status = "okay";
};

&main_uart3 { /* UART_D */
	status = "okay";
};

&main_uart5 { /* UART_A */
	status = "okay";
};

&reg_mmc1 {
	status = "okay";
};

&sdhci0 { /* SDIO_B eMMC */
	non-removable;
};

&sdhci1 { /* SDIO_A uSD / M.2_SDIO */
	status = "okay";
};

&main_i2c2 { /* I2C_C */
	status = "okay";

	i2c-mux@72 {
		compatible = "nxp,pca9546"; /* U22 TCA9546APWR */
		reg = <0x72>;

		vdd-supply = <&reg_1v8_carrier>;
		#address-cells = <1>;
		#size-cells = <0>;

		i2c_port_a: i2c-port-a@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c_port_d: i2c-port-d@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c_port_e: i2c-port-e@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c_port_rgb: i2c-port-rgb@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

&usbss0 {
	status = "okay";
	ti,vbus-divider;
};

&usbss1 {
	ti,vbus-divider;
};

&usb0 {
	adp-disable;
	usb-role-switch;

	port {
		usb0_ep: endpoint {
			remote-endpoint = <&usb0_dr_connector>;
		};
	};
};

&usb1 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_usb1_en_pins_default>;
};

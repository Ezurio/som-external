/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

&reg_wifi_en {
	startup-delay-us = <250000>;
	off-on-delay-us = <100>;
};

&sdhci2 { /* SDIO_B  WIFI */
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&uart1 {
	status = "okay";

	bluetooth {
		compatible = "infineon,cyw55572-bt";
		vbat-supply = <&reg_slow_clock>;
		vddio-supply = <&reg_1v8>;
		brcm,requires-autobaud-mode;
		max-speed = <3000000>;
		shutdown-gpios = <&exp0 1 GPIO_ACTIVE_HIGH>;
	};
};

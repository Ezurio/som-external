/dts-v1/;
/plugin/;

#include "k3-am62l-carbon-m2-sdio.dtsi"

&reg_m2_wifi_en {
	startup-delay-us = <10000>;
};

&sdhci1 { /* SDIO_A uSD / M.2_SDIO */
	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";
	};
};

&uart2 {
	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_m2_wifi_en>;
		max-speed = <115200>;
	};
};

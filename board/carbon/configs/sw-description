software =
{
	version = "0.1.0";
	bootloader_transaction_marker = false;
	bootloader_state_marker = false;

	stable = {
		full-a: {
			partitions: (
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p1";

					properties: {
						fstype = "vfat";
						force = "true";
					};
				},
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p3";

					properties: {
						fstype = "ext4";
						force = "true";
					};
				}
			);

			images: (
				{
					filename = "tiboot3.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
					type = "raw";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(tiboot3.bin)";
				},
				{
					filename = "tispl.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
					type = "raw";
					offset = "@@EMMC_SPL_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(tispl.bin)";
				},
				{
					filename = "u-boot.img";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
					type = "raw";
					offset = "@@EMMC_BOOT_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(u-boot.img)";
				},
				{
					filename = "uboot.env";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
					type = "raw";
					offset = "@@UBOOT_ENV_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(uboot.env)";
				},
				{
					filename = "rootfs.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p2";
					type = "raw";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(rootfs.bin)";
				}
			);

			files: (
				{
					filename = "kernel.itb";
					path = "/kernel.itb";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p1";
					filesystem = "vfat";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "prov_data.tar.gz_sign_enc.bin";
					path = "/prov_data.tar.gz_sign_enc.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p1";
					filesystem = "vfat";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(prov_data.tar.gz_sign_enc.bin)";
				}
			);

			scripts: (
				{
					filename = "erase_data.sh";
					type = "postinstall";
					data = "/dev/mmcblk@@EMMC_DEVICE@@p6 /dev/mmcblk@@EMMC_DEVICE@@p3";
					sha256 = "$swupdate_get_sha256(erase_data.sh)";
				},
				{
					type = "emmc_boot";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
				}
			);
		};

		full-b: {
			partitions: (
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p4";

					properties: {
						fstype = "vfat";
						force = "true";
					};
				},
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p6";

					properties: {
						fstype = "ext4";
						force = "true";
					};
				}
			);

			images: (
				{
					filename = "tiboot3.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";
					type = "raw";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(tiboot3.bin)";
				},
				{
					filename = "tispl.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";
					type = "raw";
					offset = "@@EMMC_SPL_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(tispl.bin)";
				},
				{
					filename = "u-boot.img";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";
					type = "raw";
					offset = "@@EMMC_BOOT_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(u-boot.img)";
				},
				{
					filename = "uboot.env";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";
					type = "raw";
					offset = "@@UBOOT_ENV_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(uboot.env)";
				},
				{
					filename = "rootfs.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p5";
					type = "raw";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(rootfs.bin)";
				}
			);

			files: (
				{
					filename = "kernel.itb";
					path = "/kernel.itb";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p4";
					filesystem = "vfat";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "prov_data.tar.gz_sign_enc.bin";
					path = "/prov_data.tar.gz_sign_enc.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p4";
					filesystem = "vfat";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(prov_data.tar.gz_sign_enc.bin)";
				}
			);

			scripts: (
				{
					filename = "erase_data.sh";
					type = "postinstall";
					data = "/dev/mmcblk@@EMMC_DEVICE@@p3 /dev/mmcblk@@EMMC_DEVICE@@p6";
					sha256 = "$swupdate_get_sha256(erase_data.sh)";
				},
				{
					type = "emmc_boot";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";
				}
			);
		};

		complete: {
			partitions: (
				{
					type = "diskpart";
					device = "/dev/mmcblk@@EMMC_DEVICE@@";

					properties: {
						labeltype = "gpt";
						partition-1 = ["size=64M",  "name=kernel_a",      "type=BC13C2FF-59E6-4262-A352-B275FD6F7172"];
						partition-2 = ["size=512M", "name=rootfs_a",      "type=B921B045-1DF0-41C3-AF44-4C6F280D3FAE"];
						partition-3 = ["size=256M", "name=rootfs_data_a", "type=0FC63DAF-8483-4772-8E79-3D69D8477DE4"];
						partition-4 = ["size=64M",  "name=kernel_b",      "type=BC13C2FF-59E6-4262-A352-B275FD6F7172"];
						partition-5 = ["size=512M", "name=rootfs_b",      "type=B921B045-1DF0-41C3-AF44-4C6F280D3FAE"];
						partition-6 = ["size=256M", "name=rootfs_data_b", "type=0FC63DAF-8483-4772-8E79-3D69D8477DE4"];
						partition-7 = ["size=5G",   "name=perm",          "type=0FC63DAF-8483-4772-8E79-3D69D8477DE4"];
					};
				},
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p1";

					properties: {
						fstype = "vfat";
						force = "true";
					};
				},
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p3";

					properties: {
						fstype = "ext4";
						force = "true";
					};
				},
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p4";

					properties: {
						fstype = "vfat";
						force = "true";
					};
				},
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p6";

					properties: {
						fstype = "ext4";
						force = "true";
					};
				},
				{
					type = "diskformat";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p7";

					properties: {
						fstype = "ext4";
						force = "true";
					};
				}
			);

			images: (
				{
					filename = "tiboot3.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
					type = "raw";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(tiboot3.bin)";
				},
				{
					filename = "tispl.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
					type = "raw";
					offset = "@@EMMC_SPL_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(tispl.bin)";
				},
				{
					filename = "u-boot.img";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
					type = "raw";
					offset = "@@EMMC_BOOT_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(u-boot.img)";
				},
				{
					filename = "uboot.env";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
					type = "raw";
					offset = "@@UBOOT_ENV_OFFSET@@";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(uboot.env)";
				},
				{
					filename = "rootfs.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p2";
					type = "raw";
					installed-directly = true;
					sha256 = "$swupdate_get_sha256(rootfs.bin)";
				}
			);

			files: (
				{
					filename = "kernel.itb";
					path = "/kernel.itb";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p1";
					filesystem = "vfat";
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "kernel.itb";
					path = "/kernel.itb";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p4";
					filesystem = "vfat";
					sha256 = "$swupdate_get_sha256(kernel.itb)";
				},
				{
					filename = "prov_data.tar.gz_sign_enc.bin";
					path = "/prov_data.tar.gz_sign_enc.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p1";
					filesystem = "vfat";
					sha256 = "$swupdate_get_sha256(prov_data.tar.gz_sign_enc.bin)";
				},
				{
					filename = "prov_data.tar.gz_sign_enc.bin";
					path = "/prov_data.tar.gz_sign_enc.bin";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p4";
					filesystem = "vfat";
					sha256 = "$swupdate_get_sha256(prov_data.tar.gz_sign_enc.bin)";
				}
			);

			scripts: (
				{
					type = "copy";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";

					properties: {
						type = "postinstall";
						copyfrom = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
						chain = "raw";
						size = "4194304";
					};
				},
				{
					type = "copy";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p5";

					properties: {
						type = "postinstall";
						copyfrom = "/dev/mmcblk@@EMMC_DEVICE@@p2";
						chain = "raw";
						size = "$swupdate_get_size(rootfs.bin)";
					};
				},
				{
					type = "readback";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";

					properties: {
						sha256 = "$swupdate_get_sha256(tiboot3.bin)";
						size = "$swupdate_get_size(tiboot3.bin)";
					};
				},
				{
					type = "readback";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";

					properties: {
						sha256 = "$swupdate_get_sha256(tispl.bin)";
						size = "$swupdate_get_size(tispl.bin)";
						offset = "@@EMMC_SPL_OFFSET@@";
					};
				},
				{
					type = "readback";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";

					properties: {
						sha256 = "$swupdate_get_sha256(u-boot.img)";
						size = "$swupdate_get_size(u-boot.img)";
						offset = "@@EMMC_BOOT_OFFSET@@";
					};
				},
				{
					type = "readback";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot1";

					properties: {
						sha256 = "$swupdate_get_sha256(uboot.env)";
						size = "$swupdate_get_size(uboot.env)";
						offset = "@@UBOOT_ENV_OFFSET@@";
					};
				},
				{
					type = "readback";
					device = "/dev/mmcblk@@EMMC_DEVICE@@p5";

					properties: {
						sha256 = "$swupdate_get_sha256(rootfs.bin)";
						size = "$swupdate_get_size(rootfs.bin)";
					};
				},
				{
					type = "emmc_boot";
					device = "/dev/mmcblk@@EMMC_DEVICE@@boot0";
				}
			);
		};
	};
};

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/gpio-keys.h>

#include "k3-am625.dtsi"

/ {
	compatible = "summit,carbon-am62x", "ti,am625";
	model = "Ezurio Carbon AM62x SOM";

	aliases {
		serial0 = &wkup_uart0;		/* UART_C */
		serial2 = &main_uart0;		/* UART_CON */
		serial3 = &main_uart1;		/* BT */
		serial4 = &main_uart6;		/* UART_A */
		serial5 = &mcu_uart0;		/* UART_B */
		serial6 = &main_uart4;		/* UART_D */
		mmc0 = &sdhci0;			/* EMMC */
		mmc1 = &sdhci1;			/* SD */
		mmc2 = &sdhci2;			/* WIFI */
		spi0 = &ospi0;			/* SPI_A */
		spi1 = &main_spi0;		/* SPI_B */
		spi2 = &mcu_spi0;		/* SPI_C */
		ethernet0 = &cpsw_port1;	/* ETH_A */
		ethernet1 = &cpsw_port2;	/* ETH_B */
		can0 = &main_mcan0;		/* CAN_A */
		can1 = &mcu_mcan0;		/* CAN_B */
		usb0 = &usb0;			/* USB_A */
		usb1 = &usb1;			/* USB_B */
		gpio0 = &main_gpio0;
		gpio1 = &main_gpio1;
		gpio2 = &mcu_gpio0;
		rtc0 = &rv3028;
		rtc1 = &wkup_rtc0;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	opp-table {
		/* Add 1.4GHz OPP for am625-carbon board. Requires VDD_CORE to be at 0.85V */
		opp-1400000000 {
			opp-hz = /bits/ 64 <1400000000>;
			opp-supported-hw = <0x01 0x0004>;
			clock-latency-ns = <6000000>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		/* 2G RAM */
		reg = <0x00000000 0x80000000 0x00000000 0x80000000>;
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops@9c700000 {
			compatible = "ramoops";
			reg = <0x00 0x9c700000 0x00 0x00100000>;
			record-size = <0x8000>;
			console-size = <0x8000>;
			ftrace-size = <0x00>;
			pmsg-size = <0x8000>;
		};

		/* global cma region */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x20000000>;
			linux,cma-default;
		};

		rtos_ipc_memory_region: ipc-memories@9c800000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x9c800000 0x00 0x00300000>;
			no-map;
		};

		mcu_m4fss_dma_memory_region: m4f-dma-memory@9cb00000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x9cb00000 0x00 0x100000>;
			no-map;
		};

		mcu_m4fss_memory_region: m4f-memory@9cc00000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x9cc00000 0x00 0xe00000>;
			no-map;
		};

		wkup_r5fss0_core0_dma_memory_region: r5f-dma-memory@9da00000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x9da00000 0x00 0x100000>;
			no-map;
		};

		wkup_r5fss0_core0_memory_region: r5f-memory@9db00000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x9db00000 0x00 0xc00000>;
			no-map;
		};

		secure_tfa_ddr: tfa@9e780000 {
			reg = <0x00 0x9e780000 0x00 0x80000>;
			alignment = <0x1000>;
			no-map;
		};

		secure_ddr: optee@9e800000 {
			reg = <0x00 0x9e800000 0x00 0x01800000>; /* for OP-TEE */
			alignment = <0x1000>;
			no-map;
		};
	};

	idle-states {
		entry-method = "psci";

		CPU_SLEEP_0: stby {
			compatible = "arm,idle-state";
			idle-state-name = "standby";
			arm,psci-suspend-param = <0x00000001>;
			entry-latency-us = <100>;
			exit-latency-us = <50>;
			min-residency-us = <1000>;
		};
	};

	reg_5v0: regulator-5v0 {
		/* VCC_IN_5V */
		compatible = "regulator-fixed";
		regulator-name = "reg_5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_3v3: regulator-3v3 {
		/* output of U4 */
		compatible = "regulator-fixed";
		regulator-name = "reg_3v3";
		vin-supply = <&reg_5v0>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_vpp: regulator-vpp {
		/* TCK107AG,LF U5 */
		compatible = "regulator-fixed";
		regulator-name = "reg_vpp";
		vin-supply = <&reg_1v8>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_vpp_en_pins_default>;
		gpios = <&main_gpio0 22 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_vsel_mmc1: regulator-vsel-mmc1 {
		/* Output of U3 TPS6521920WRHBRQ1 VLDO1 */
		compatible = "regulator-gpio";

		vin-supply = <&reg_sd_pmic>;

		regulator-name = "reg_vsel_mmc1";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_vsel_mmc1_pins_default>;
		gpios = <&main_gpio0 31 GPIO_ACTIVE_LOW>;

		/* initial state must be 3.3V */
		states = <3300000 0x0>, <1800000 0x1>;
		status = "disabled";
	};

	reg_mmc1: regulator-mmc1 {
		compatible = "regulator-fixed";

		regulator-name = "reg_mmc1";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_mmc1_power_en_default>;
		gpios = <&main_gpio0 25 GPIO_ACTIVE_HIGH>;

		enable-active-high;
		startup-delay-us = <5000>;
		status = "disabled";
	};

	clk_cam_a_hw: clk-cam-a-hw {
		compatible = "pwm-clock";
		status = "disabled";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clk_cam_a_hw";
		pwms = <&ecap2 0 42 0>; /* 1 / 42 ns = 24 MHz */
	};

	mmc0_pwrseq: pwrseq {
		pinctrl-names = "default";
		pinctrl-0 = <&main_mmc0_reset_pins_default>;

		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&main_gpio0 15 GPIO_ACTIVE_LOW>;
	};

	reg_slow_clock: regulator-slow-clock {
		compatible = "regulator-fixed-clock";

		regulator-name = "reg_slow_clock";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		vin-supply = <&reg_3v3>;
		clocks = <&k3_clks 157 158>;

		startup-delay-us = <1000>;

		pinctrl-names = "default";
		pinctrl-0 = <&mcu_clkout_pins_default>;

		assigned-clocks = <&k3_clks 157 158>;
		assigned-clock-parents = <&k3_clks 157 160>;
	};

	reg_wifi_en: regulator-wifi-en {
		compatible = "regulator-fixed";

		regulator-name = "reg_wifi_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		vin-supply = <&reg_slow_clock>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_wifi_en_pins_default>;
		gpios = <&main_gpio0 20 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		startup-delay-us = <250000>;
		off-on-delay-us = <100>;
	};

	wifi_wakeup: wifi-wakeup {
		compatible = "gpio-keys";

		status = "disabled";

		pinctrl-names = "default";
		pinctrl-0 = <&main_wifi_wake_default>, <&main_bt_wake_pins_default>;

		wifi-wake {
			label = "Wi-Fi Wake Up";
			linux,code = <KEY_WAKEUP>;
			wakeup-source;

			interrupts-extended = <&main_gpio0 16 IRQ_TYPE_EDGE_FALLING>,
				<&main_pmx0 0x040>;
			interrupt-names = "irq", "wakeup";

			//gpios = <&main_gpio0 16 GPIO_ACTIVE_LOW>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};

		bt-wake {
			label = "BT Wake Up";
			linux,code = <KEY_WAKEUP>;
			wakeup-source;

			interrupts-extended = <&main_gpio0 42 IRQ_TYPE_EDGE_FALLING>,
				<&main_pmx0 0x0ac>;
			interrupt-names = "irq", "wakeup";

			//gpios = <&main_gpio0 42 GPIO_ACTIVE_LOW>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};
	};
};

&cpu0 {
	cpu-idle-states = <&CPU_SLEEP_0>;
};

&cpu1 {
	cpu-idle-states = <&CPU_SLEEP_0>;
};

&cpu2 {
	cpu-idle-states = <&CPU_SLEEP_0>;
};

&cpu3 {
	cpu-idle-states = <&CPU_SLEEP_0>;
};

&cpsw3g {
	pinctrl-names = "default";
	pinctrl-0 = <&main_rgmii1_pins_default>, <&main_rgmii2_pins_default>;

	status = "disabled";

	cpts@3d000 {
		/* MAP HW3_TS_PUSH to GENF1 */
		ti,pps = <2 1>;
	};
};

&cpsw_port1 {
	status = "disabled";
	phy-mode = "rgmii-rxid";

	/delete-property/ mac-address;
	/delete-property/ ti,syscon-efuse;
	nvmem-cells = <&eth_mac0>;
	nvmem-cell-names = "mac-address";
};

&cpsw_port2 {
	status = "disabled";
	phy-mode = "rgmii-rxid";

	/delete-property/ mac-address;
	/delete-property/ ti,syscon-efuse;
	nvmem-cells = <&eth_mac1>;
	nvmem-cell-names = "mac-address";
};

&cpsw3g_mdio {
	pinctrl-names = "default";
	pinctrl-0 = <&main_mdio0_pins_default>;
};

&epwm0 { /* PWM_0 */
	pinctrl-names = "default";
	pinctrl-0 = <&main_epwm0_pins_default>;
};

&epwm1 { /* PWM_1 and PWM_2 */
	pinctrl-names = "default";
	pinctrl-0 = <&main_epwm1_pins_default>;
};

&ecap2 { /* CAM_A_MCK */
	/* ECAP in APWM mode */
	pinctrl-names = "default";
	pinctrl-0 = <&main_ecap2_pins_default>;
};

&mailbox0_cluster0 {
	mbox_m4_0: mbox-m4-0 {
		ti,mbox-rx = <0 0 0>;
		ti,mbox-tx = <1 0 0>;
	};

	mbox_r5_0: mbox-r5-0 {
		ti,mbox-rx = <2 0 0>;
		ti,mbox-tx = <3 0 0>;
	};
};

&mcu_m4fss {
	mboxes = <&mailbox0_cluster0 &mbox_m4_0>;
	memory-region = <&mcu_m4fss_dma_memory_region>,
			<&mcu_m4fss_memory_region>;
};

&wkup_r5fss0_core0 {
	mboxes = <&mailbox0_cluster0 &mbox_r5_0>;
	memory-region = <&wkup_r5fss0_core0_dma_memory_region>,
			<&wkup_r5fss0_core0_memory_region>;
};

&main_rti1 {
	status = "disabled";
};

&main_rti2 {
	status = "disabled";
};

&main_rti3 {
	status = "disabled";
};

&main_rti15 {
	status = "disabled";
};

&main_gpio0 {
	gpio-line-names =
		"","ETH_A_INT","ETH_A_RST","","", 		/* 0 - 4 */
		"","","","","",
		"","","","GPIO_A_0","RGB_VDD_EN",			/* 10 - 14 */
		"EMMC_RESET#","WIFI_WAKE","USB_B_ID","RGB_CS","RGB_RESET#",
		"W_DISABLE1#","W_DISABLE2#","VPP_EN","","",	/* 20 - 24 */
		"SDIO_A_PWR_EN","","","","CAM_A_RST",
		"LVDS_D_VDD_EN","SDIO_A_IOPWR","","LVDS_D_BL_EN","",		/* 30 - 34 */
		"","GPIO_B_3","","GPIO_B_2","ETH_B_RST",
		"","ETH_B_INT","BT_HOST_WAKE","","",		/* 40 - 44 */
		"","","","","",
		"","","","","",					/* 50 - 54 */
		"","","","","",
		"","","","","",					/* 60 - 64 */
		"","","","","",
		"","RGB_BL_EN","CAM_A_PWR","","",				/* 70 - 74 */
		"","","","","",
		"","","","","",					/* 80 - 84 */
		"","","","","",
		"","";						/* 90 - 91 */
};

&main_gpio1 {
	gpio-line-names =
		"","","","","",					/* 0 - 4 */
		"","","","","",
		"","","","","",				/* 10 - 14 */
		"","","","","",
		"","","","","",					/* 20 - 24 */
		"","","","","",
		"USB_A_ID","","","","",					/* 30 - 34 */
		"","","","","",
		"","","","","",					/* 40 - 44 */
		"","","","SDIO_A_CD#","",
		"USB_A_EN","USB_B_EN";						/* 50 - 51 */
};

&main_i2c0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c0_pins_default>;
	clock-frequency = <400000>;

	rv3028: rtc@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;

		pinctrl-names = "default";
		pinctrl-0 = <&mcu_rtc_pins_default>;
		interrupts-extended = <&mcu_gpio0 16 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "irq";
		wakeup-source;

		#clock-cells = <0>;

		eeprom {
			compatible = "microcrystal,rv3028-eeprom";
			#address-cells = <1>;
			#size-cells = <1>;

			eth_mac0: mac-address@0 {
				reg = <0x00 0x06>;
			};

			eth_mac1: mac-address@6 {
				reg = <0x06 0x06>;
			};

			ram_type: ram-type@c {
				reg = <0x0c 0x02>;
			};

			radio_type: radio-type@e {
				reg = <0x0e 0x02>;
			};
		};
	};

	tps65219: pmic@30 {
		compatible = "ti,tps65219";
		reg = <0x30>;
		buck1-supply = <&reg_5v0>;
		buck2-supply = <&reg_5v0>;
		buck3-supply = <&reg_5v0>;
		ldo1-supply = <&reg_3v3>;
		ldo2-supply = <&reg_1v8>;
		ldo3-supply = <&reg_3v3>;
		ldo4-supply = <&reg_3v3>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_pmic_irq_pins_default>;

		interrupts-extended = <&gic500 GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>;

		system-power-controller;
		ti,power-button;

		regulators {
			reg_core: buck1 {
				regulator-name = "reg_core";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-boot-on;
				regulator-always-on;
			};

			reg_1v8: buck2 {
				regulator-name = "reg_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			reg_1v1: buck3 {
				regulator-name = "reg_1v1";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-boot-on;
				regulator-always-on;
			};

			reg_sd_pmic: ldo1 {
				/*
				 * Regulator is left as is unused, vdd_sd
				 * is controlled via GPIO with bypass config
				 * as per the NVM configuration
				 */
				regulator-name = "reg_sd_pmic";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-allow-bypass;
				regulator-boot-on;
				regulator-always-on;
			};

			rega_0v85: ldo2 {
				regulator-name = "rega_0v85";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-boot-on;
				regulator-always-on;
			};

			rega_1v8: regulator-u3-ldo3 {
				regulator-name = "rega_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			reg_1v2: ldo4 {
				regulator-name = "reg_1v2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&main_i2c1 {
	/* I2C_A */
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c1_pins_default>;
	clock-frequency = <400000>;
};

&main_i2c2 {
	/* I2C_B */
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c2_pins_default>;
	clock-frequency = <400000>;
};

&main_i2c3 {
	/* I2C_CAM */
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c3_pins_default>;
	clock-frequency = <400000>;
};

&wkup_i2c0 {
	/* I2C_C/I2C_DISP */
	pinctrl-names = "default";
	pinctrl-0 = <&wkup_i2c0_pins_default>;
	clock-frequency = <400000>;
};

&main_mcan0 {
	/* CAN_A */
	pinctrl-names = "default";
	pinctrl-0 = <&main_mcan0_pins_default>;
};

&main_pmx0 {
	main_ecap2_pins_default: main-ecap2-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x1a4, PIN_OUTPUT, 2) /* CAM_A_MCK (B20) MCASP0_ACLKX.ECAP2_IN_APWM_OUT */
		>;
	};

	main_epwm0_pins_default: main-epwm0-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x1b8, PIN_OUTPUT, 2) /* PWM_0 (C13) SPI0_CS1.EHRPWM0_B */
		>;
	};

	main_epwm1_pins_default: main-epwm1-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x19c, PIN_OUTPUT, 6) /* LVDS_D_BL_PWM/PWM_1 (B18) MCASP0_AXR1.EHRPWM1_A */
			AM62X_IOPAD(0x1a0, PIN_OUTPUT, 6) /* RGB_BL_PWM/LVDS_E_BL_PWM/PWM_2 (E18) MCASP0_AXR0.EHRPWM1_B */
		>;
	};

	main_i2c0_pins_default: main-i2c0-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x1e0, PIN_INPUT_PULLUP, 0) /* (B16) I2C0_SCL */
			AM62X_IOPAD(0x1e4, PIN_INPUT_PULLUP, 0) /* (A16) I2C0_SDA */
		>;
	};

	main_i2c1_pins_default: main-i2c1-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x1e8, PIN_INPUT_PULLUP, 0) /* I2C_A_SCL (B17) I2C1_SCL */
			AM62X_IOPAD(0x1ec, PIN_INPUT_PULLUP, 0) /* I2C_A_SDA (A17) I2C1_SDA */
		>;
	};

	main_i2c2_pins_default: main-i2c2-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0b0, PIN_INPUT_PULLUP, 1) /* I2C_B_SCL (K22) GPMC0_CSn2.I2C2_SCL */
			AM62X_IOPAD(0x0b4, PIN_INPUT_PULLUP, 1) /* I2C_B_SDA (K24) GPMC0_CSn3.I2C2_SDA */
		>;
	};

	main_i2c3_pins_default: main-i2c3-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x1d0, PIN_INPUT_PULLUP, 2) /* I2C_CAM_A_SCL (A15) UART0_CTSn.I2C3_SCL */
			AM62X_IOPAD(0x1d4, PIN_INPUT_PULLUP, 2) /* I2C_CAM_A_SDA (B15) UART0_RTSn.I2C3_SDA */
		>;
	};

	main_vpp_en_pins_default: main-vpp-en-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x058, PIN_OUTPUT, 7) /* VPP_EN (R23) GPMC0_AD7.GPIO0_22 */
		>;
	};

	main_mmc0_reset_pins_default: main-mmc0-reset-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x03c, PIN_INPUT, 7) /* (M25) GPMC0_AD0.GPIO0_15 */
		>;
	};

	main_mmc0_pins_default: main-mmc0-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x220, PIN_INPUT_PULLUP, 0) /* (Y3) MMC0_CMD */
			AM62X_IOPAD(0x218, PIN_OUTPUT, 0) /* (AB1) MMC0_CLK */
			AM62X_IOPAD(0x214, PIN_INPUT_PULLUP, 0) /* (AA2) MMC0_DAT0 */
			AM62X_IOPAD(0x210, PIN_INPUT_PULLUP, 0) /* (AA1) MMC0_DAT1 */
			AM62X_IOPAD(0x20c, PIN_INPUT_PULLUP, 0) /* (AA3) MMC0_DAT2 */
			AM62X_IOPAD(0x208, PIN_INPUT_PULLUP, 0) /* (Y4) MMC0_DAT3 */

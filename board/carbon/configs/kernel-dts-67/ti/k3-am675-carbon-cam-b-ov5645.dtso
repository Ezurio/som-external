#include "k3-am675-carbon-cam-b-ov5640.dtso"

&camera_cam_b {
	compatible = "ovti,ov5645";

	vdddo-supply = <&vdd_3v3_carrier>;
	vdda-supply = <&vdd_3v3_carrier>;
	vddd-supply = <&vdd_3v3_carrier>;

	enable-gpios = <&exp0 0 GPIO_ACTIVE_HIGH>; /* CAM_B_PWR */
	/delete-property/ powerdown-gpios;
	clock-frequency = <24000000>;
};

#include "k3-am675-carbon-cam-d-ov5640.dtso"

&camera_cam_d {
	reg = <0x0c>;
	compatible = "arducam,arducam-pivariety";

	VANA-supply = <&vdd_3v3_carrier>;
	VDIG-supply = <&vdd_3v3_carrier>;
	VDDL-supply = <&vdd_3v3_carrier>;

	reset-gpios = <&exp0 7 GPIO_ACTIVE_HIGH>; /* CAM_D_RST */
	enable-gpios = <&exp0 6 GPIO_ACTIVE_HIGH>; /* CAM_D_PWR */
	/delete-property/ powerdown-gpios;
};

&csi2_cam3 {
	data-lanes = <1 2 3 4>;
};

&csi2rx3_in_sensor {
	data-lanes = <1 2 3 4>;
};

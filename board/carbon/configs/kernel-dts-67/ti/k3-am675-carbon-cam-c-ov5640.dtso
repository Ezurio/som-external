/dts-v1/;
/plugin/;

#include "k3-am675-carbon-cam-c.dtsi"

&cam_c {
	compatible = "ovti,ov5640";
	reg = <0x3c>;

	DOVDD-supply = <&vdd_cam_c>;
	AVDD-supply = <&vdd_cam_c>;
	DVDD-supply = <&vdd_cam_c>;

	reset-gpios = <&exp0 5 GPIO_ACTIVE_LOW>; /* CAM_C_RST */
	powerdown-gpios = <&exp0 4 GPIO_ACTIVE_LOW>; /* CAM_C_PWR */
};

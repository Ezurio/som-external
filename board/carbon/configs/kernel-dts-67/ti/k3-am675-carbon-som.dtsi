			J722S_IOPAD(0x018, PIN_INPUT, 7) /* CAM_A_RST (L25) OSPI0_D3.GPIO0_6 */
		>;
	};

	main_cam_b_pins_default: main-cam-b-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x02c, PIN_INPUT, 7) /* CAM_B_PWR (K26) OSPI0_CSN0.GPIO0_11 */
			J722S_IOPAD(0x030, PIN_INPUT, 7) /* CAM_B_RST (K23) OSPI0_CSN1.GPIO0_12 */
		>;

			J722S_IOPAD(0x00c, PIN_INPUT, 7) /* CAM_C_PWR (K27) OSPI0_D0.GPIO0_3 */
			J722S_IOPAD(0x010, PIN_INPUT, 7) /* CAM_C_RST (L27) OSPI0_D1.GPIO0_4 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/gpio-keys.h>
#include <dt-bindings/net/ti-dp83867.h>
#include <dt-bindings/phy/phy.h>
#include "k3-serdes.h"

#include "k3-j722s.dtsi"

/ {
	compatible = "summit,carbon-am67x-som", "ti,j722s";
	model = "Ezurio Carbon AM67x SOM";

	aliases {
		serial0 = &wkup_uart0;		/* UART_C */
		serial2 = &main_uart0;		/* UART_CON */
		serial3 = &main_uart1;		/* BT */
		serial4 = &main_uart5;		/* UART_A */
		serial5 = &mcu_uart0;		/* UART_B */
		serial6 = &main_uart6;		/* UART_D */
		mmc0 = &sdhci0;			/* EMMC */
		mmc1 = &sdhci1;			/* SDIO_A */
		mmc2 = &sdhci2;			/* WIFI */
		spi0 = &main_spi0;			/* SPI_A */
		spi1 = &mcu_spi0;		/* SPI_B */
		ethernet0 = &cpsw_port1;	/* ETH_A */
		ethernet1 = &cpsw_port2;	/* ETH_B */
		can0 = &main_mcan0;		/* CAN_A */
		can1 = &mcu_mcan1;		/* CAN_B */
		usb0 = &usb0;			/* USB_A */
		usb1 = &usb1;			/* USB_C */
		gpio0 = &main_gpio0;
		gpio1 = &main_gpio1;
		gpio2 = &mcu_gpio0;
		rtc0 = &rv3028;
		rtc1 = &wkup_rtc0;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		/* 4G RAM */
		reg = <0x00000000 0x80000000 0x00000000 0x80000000>,
		      <0x00000008 0x80000000 0x00000000 0x80000000>;
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* global cma region */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x38000000>;
			linux,cma-default;
		};

		secure_tfa_ddr: tfa@9e780000 {
			reg = <0x00 0x9e780000 0x00 0x80000>;
			alignment = <0x1000>;
			no-map;
		};

		secure_ddr: optee@9e800000 {
			reg = <0x00 0x9e800000 0x00 0x01800000>;
			alignment = <0x1000>;
			no-map;
		};

		wkup_r5fss0_core0_dma_memory_region: r5f-dma-memory@a0000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa0000000 0x00 0x100000>;
			no-map;
		};

		wkup_r5fss0_core0_memory_region: r5f-memory@a0100000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa0100000 0x00 0xf00000>;
			no-map;
		};

		mcu_r5fss0_core0_dma_memory_region: mcu-r5fss-dma-memory-region@a1000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa1000000 0x00 0x100000>;
			no-map;
		};

		mcu_r5fss0_core0_memory_region: mcu-r5fss-memory-region@a1100000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa1100000 0x00 0xf00000>;
			no-map;
		};

		main_r5fss0_core0_dma_memory_region: main-r5fss-dma-memory-region@a2000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa2000000 0x00 0x100000>;
			no-map;
		};

		main_r5fss0_core0_memory_region: main-r5fss-memory-region@a2100000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xa2100000 0x00 0xf00000>;
			no-map;
		};

		rtos_ipc_memory_region: ipc-memories@a5000000 {
			reg = <0x00 0xa5000000 0x00 0x1c00000>;
			alignment = <0x1000>;
			no-map;
		};
	};

	vsys_5v: regulator-vcc-in-5v {
		/* VCC_IN_5V */
		compatible = "regulator-fixed";
		regulator-name = "vsys_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vdd_ram: regulator-vdd-ram {
		/* TLV62595 U10 */
		compatible = "regulator-fixed";
		regulator-name = "vdd_ram";
		vin-supply = <&vsys_5v>;
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <850000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vpp: regulator-vpp {
		/* TPS22916 U11 */
		compatible = "regulator-fixed";
		regulator-name = "vpp";
		vin-supply = <&vdd_1v8>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		pinctrl-names = "default";
		pinctrl-0 = <&mcu_vpp_en_pins_default>;
		gpios = <&mcu_gpio0 14 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vdd_ram_1v1: regulator-vdd-ram-1v1 {
		/* TPS22916 U11 */
		compatible = "regulator-fixed";
		regulator-name = "vdd_ram_1v1";
		vin-supply = <&vdd_1v1>;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vsel_mmc1: regulator-vsel-mmc1 {
		/* Output of U4 TPS6521920WRHBRQ1 VLDO1 */
		compatible = "regulator-gpio";

		vin-supply = <&vdd_sd_pmic>;

		regulator-name = "vsel_mmc1";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;

		pinctrl-names = "default";
		pinctrl-0 = <&vsel_mmc1_pins_default>;
		gpios = <&main_gpio0 16 GPIO_ACTIVE_LOW>;

		/* initial state must be 3.3V */
		states = <3300000 0x0>, <1800000 0x1>;
		status = "disabled";
	};

	vdd_mmc1: regulator-vdd-mmc1 {
		compatible = "regulator-fixed";

		regulator-name = "vdd_mmc1";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_mmc1_power_en_default>;
		gpios = <&main_gpio0 15 GPIO_ACTIVE_HIGH>;

		enable-active-high;
		startup-delay-us = <5000>;
		status = "disabled";
	};

	clk_cam_a_hw: clk-cam-a-hw {
		compatible = "pwm-clock";
		status = "disabled";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clk_cam_a_hw";
		pwms = <&cam_a_pwm 0 42 0>; /* 1 / 42 ns = 24 MHz */
	};

	clk_cam_b_hw: clk-cam-b-hw {
		compatible = "pwm-clock";
		status = "disabled";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clk_cam_b_hw";
		pwms = <&ecap0 0 42 0>; /* 1 / 42 ns = 24 MHz */
	};

	clk_cam_c_hw: clk-cam-c-hw {
		compatible = "pwm-clock";
		status = "disabled";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clk_cam_c_hw";
		pwms = <&pwm4 0 42 0>; /* 1 / 42 ns = 24 MHz */
	};

	clk_cam_d_hw: clk-cam-d-hw {
		compatible = "pwm-clock";
		status = "disabled";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clk_cam_d_hw";
		pwms = <&epwm1 1 42 0>; /* 1 / 42 ns = 24 MHz */
	};

	cam_a_pwm: dmtimer-main-pwm-6 { /* CAM_A_MCK */
		compatible = "ti,omap-dmtimer-pwm";
		#pwm-cells = <3>;
		ti,timers = <&main_timer6>;
		pinctrl-0 = <&main_timer6_pins_default>;
		pinctrl-names = "default";
		status = "disabled";
	};

	pwm4: dmtimer-main-pwm-7 { /* CAM_C_MCK / PWM_4 */
		compatible = "ti,omap-dmtimer-pwm";
		#pwm-cells = <3>;
		ti,timers = <&main_timer7>;
		pinctrl-0 = <&main_timer7_pins_default>;
		pinctrl-names = "default";
		status = "disabled";
	};

	mmc0_pwrseq: pwrseq {
		pinctrl-names = "default";
		pinctrl-0 = <&main_mmc0_reset_pins_default>;

		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&main_gpio1 12 GPIO_ACTIVE_LOW>;
	};

	reg_slow_clock: regulator-slow-clock {
		compatible = "regulator-fixed-clock";

		regulator-name = "reg_slow_clock";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		vin-supply = <&vdd_3v3>;
		clocks = <&k3_clks 157 174>;

		startup-delay-us = <1000>;

		pinctrl-names = "default";
		pinctrl-0 = <&wifi_32k_clk>;

		assigned-clocks = <&k3_clks 157 158>;
		assigned-clock-parents = <&k3_clks 157 160>;
	};

	reg_wifi_en: regulator-wifi-en {
		compatible = "regulator-fixed";

		regulator-name = "reg_wifi_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		vin-supply = <&reg_slow_clock>;

		pinctrl-names = "default";
		pinctrl-0 = <&main_wifi_en_pins_default>;
		gpios = <&main_gpio0 17 GPIO_ACTIVE_HIGH>;
		enable-active-high;

		startup-delay-us = <250000>;
		off-on-delay-us = <100>;
	};

	wifi_wakeup: wifi-wakeup {
		compatible = "gpio-keys";

		status = "disabled";

		pinctrl-names = "default";
		pinctrl-0 = <&main_wifi_wake_default>, <&main_bt_wake_pins_default>;

		wifi-wake {
			label = "Wi-Fi Wake Up";
			linux,code = <KEY_WAKEUP>;
			wakeup-source;

			interrupts-extended = <&main_gpio0 20 IRQ_TYPE_EDGE_FALLING>,
				<&main_pmx0 0x050>;
			interrupt-names = "irq", "wakeup";

			//gpios = <&main_gpio0 20 GPIO_ACTIVE_LOW>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};

		bt-wake {
			label = "BT Wake Up";
			linux,code = <KEY_WAKEUP>;
			wakeup-source;

			interrupts-extended = <&main_gpio0 21 IRQ_TYPE_EDGE_FALLING>,
				<&main_pmx0 0x054>;
			interrupt-names = "irq", "wakeup";

			//gpios = <&main_gpio0 21 GPIO_ACTIVE_LOW>;
			//wakeup-event-action = <EV_ACT_ASSERTED>;
		};
	};
};

&cpsw3g {
	pinctrl-names = "default";
	pinctrl-0 = <&main_rgmii1_pins_default>, <&main_rgmii2_pins_default>;

	status = "disabled";

	cpts@3d000 {
		/* MAP HW3_TS_PUSH to GENF1 */
		ti,pps = <2 1>;
	};
};

&cpsw_port1 {
	status = "disabled";
	phy-mode = "rgmii-rxid";

	/delete-property/ mac-address;
	/delete-property/ ti,syscon-efuse;
	nvmem-cells = <&eth_mac0>;
	nvmem-cell-names = "mac-address";
};

&cpsw_port2 {
	status = "disabled";
	phy-mode = "rgmii-rxid";

	/delete-property/ mac-address;
	/delete-property/ ti,syscon-efuse;
	nvmem-cells = <&eth_mac1>;
	nvmem-cell-names = "mac-address";
};

&cpsw3g_mdio {
	pinctrl-names = "default";
	pinctrl-0 = <&main_mdio0_pins_default>;
};

&epwm1 { /* LVDS_E_BL_PWM / PWM_2 & CAM_D_MCK / PWM_5 */
	pinctrl-names = "default";
	pinctrl-0 = <&main_epwm1_pins_default>;
};

&epwm2 { /* LVDS_D_BL_PWM / PWM_1 & DSI_A_BL_PWM / PWM_0 */
	pinctrl-names = "default";
	pinctrl-0 = <&main_epwm2_pins_default>;
};

&ecap0 { /* CAM_B_MCK / PWM_3 */
	/* ECAP0 in APWM mode */
	pinctrl-names = "default";
	pinctrl-0 = <&main_ecap0_pins_default>;
};

&mailbox0_cluster0 {
	mbox_wkup_r5_0: mbox-wkup-r5-0 {
		ti,mbox-rx = <0 0 0>;
		ti,mbox-tx = <1 0 0>;
	};
};

&mailbox0_cluster1 {
	mbox_mcu_r5_0: mbox-mcu-r5-0 {
		ti,mbox-rx = <0 0 0>;
		ti,mbox-tx = <1 0 0>;
	};
};

&mailbox0_cluster3 {
	mbox_main_r5_0: mbox-main-r5-0 {
		ti,mbox-rx = <0 0 0>;
		ti,mbox-tx = <1 0 0>;
	};
};

/* Timers are used by Remoteproc firmware */
&main_timer0 {
	status = "reserved";
};

&main_timer1 {
	status = "reserved";
};

&main_timer2 {
	status = "reserved";
};

&wkup_r5fss0_core0 {
	mboxes = <&mailbox0_cluster0 &mbox_wkup_r5_0>;
	memory-region = <&wkup_r5fss0_core0_dma_memory_region>,
			<&wkup_r5fss0_core0_memory_region>;
};

&mcu_r5fss0_core0 {
	mboxes = <&mailbox0_cluster1 &mbox_mcu_r5_0>;
	memory-region = <&mcu_r5fss0_core0_dma_memory_region>,
			<&mcu_r5fss0_core0_memory_region>;
};

&main_r5fss0_core0 {
	mboxes = <&mailbox0_cluster3 &mbox_main_r5_0>;
	memory-region = <&main_r5fss0_core0_dma_memory_region>,
			<&main_r5fss0_core0_memory_region>;
};

&main_rti1 {
	status = "disabled";
};

&main_rti2 {
	status = "disabled";
};

&main_rti3 {
	status = "disabled";
};

&main_rti15 {
	status = "disabled";
};

&main_gpio0 {
	gpio-line-names =
		"CAM_A_PWR","","","CAM_C_PWR","CAM_C_PWR", 				/* 0 - 4 */
		"CAM_D_PWR","CAM_A_RST","","","",
		"","CAM_B_PWR","CAM_B_RST","","",					/* 10 - 14 */
		"SDIO_A_PWR_EN","SDIO_A_VSEL","W_DISABLE1","W_DISABLE2","SDIO_RESET",
		"SDIO_WAKE","BT_HOST_WAKE","RTC_INT","USB_A_ID","USB_A_OC",	/* 20 - 24 */
		"USB_C_ID","USB_C_OC","SDIO_A_PWR_EN","DSI_A_VDD_EN","DSI_A_BL_EN",
		"PCIE_PERST","","","","",				/* 30 - 34 */
		"","ETH_A_INT","","","",
		"ETH_A_RST","","","","",			/* 40 - 44 */
		"USB_C_PD_RESET","GPIO_A_3","ETH_B_RST","ETH_B_INT","LVDS_E_VDD_EN",
		"LVDS_E_BL_EN","LVDS_D_VDD_EN","LVDS_D_BL_EN","","",		/* 50 - 54 */
		"","","","","",
		"","","","","",					/* 60 - 64 */
		"","","","","",
		"","GPIO_A_0","CAM_C_RST","","",				/* 70 - 74 */
		"","","","","",
		"","","","","",					/* 80 - 84 */
		"","","","","",
		"","";						/* 90 - 91 */
};

&main_gpio1 {
	gpio-line-names =
		"","","","","",					/* 0 - 4 */
		"","","","","",
		"","","EMMC_RESET","","",			/* 10 - 14 */
		"","","","","",
		"","","","","",					/* 20 - 24 */
		"","","","","",
		"","","","","",					/* 30 - 34 */
		"","","","","",
		"","","","","",					/* 40 - 44 */
		"","","","","",
		"USB_A_VBUS","USB_C_VBUS";						/* 50 - 51 */
};

&wkup_i2c0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&wkup_i2c0_pins_default>;
	clock-frequency = <400000>;

	rv3028: rtc@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;

		backup-switchover-dsm;

		pinctrl-names = "default";
		pinctrl-0 = <&rtc_pins_default>;
		interrupts-extended = <&main_gpio0 22 IRQ_TYPE_EDGE_FALLING>,
			<&main_pmx0 0x058>;
		interrupt-names = "irq", "wakeup";
		wakeup-source;

		#clock-cells = <0>;

		eeprom {
			compatible = "microcrystal,rv3028-eeprom";
			#address-cells = <1>;
			#size-cells = <1>;

			eth_mac0: mac-address@0 {
				reg = <0x00 0x06>;
			};

			eth_mac1: mac-address@6 {
				reg = <0x06 0x06>;
			};

			ram_type: ram-type@c {
				reg = <0x0c 0x02>;
			};

			radio_type: radio-type@e {
				reg = <0x0e 0x02>;
			};
		};
	};

	tps65219: pmic@30 {
		compatible = "ti,tps65219";
		reg = <0x30>;
		buck1-supply = <&vsys_5v>;
		buck2-supply = <&vsys_5v>;
		buck3-supply = <&vsys_5v>;
		ldo1-supply = <&vdd_3v3>;
		ldo2-supply = <&vdd_1v8>;
		ldo3-supply = <&vdd_3v3>;
		ldo4-supply = <&vdd_3v3>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_irq_pins_default>;

		interrupts-extended = <&gic500 GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>;

		system-power-controller;
		ti,power-button;

		regulators {
			vdd_3v3: buck1 {
				regulator-name = "vdd_3v3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_1v8: buck2 {
				regulator-name = "vdd_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_1v1: buck3 {
				regulator-name = "vdd_1v1";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_sd_pmic: ldo1 {
				/*
				 * Regulator is left as is unused, vdd_sd
				 * is controlled via GPIO with bypass config
				 * as per the NVM configuration
				 */
				regulator-name = "vdd_sd_pmic";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-allow-bypass;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_1v2: ldo2 {
				regulator-name = "vdd_1v2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_phy_1v8: regulator-u3-ldo3 {
				regulator-name = "vdd_phy_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_pll_1v8: ldo4 {
				regulator-name = "vdd_pll_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};

	vdd_core: regulator@44 {
		compatible = "ti,tps62875";
		reg = <0x44>;
		regulator-name = "vdd_core";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <850000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&mcu_i2c0 {
	/* I2C_B */
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_i2c0_pins_default>;
	clock-frequency = <400000>;
};

&main_i2c0 {
	/* I2C_A */
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c0_pins_default>;
	clock-frequency = <400000>;
};

&main_i2c2 {
	/* I2C_CAM */
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c2_pins_default>;
	clock-frequency = <400000>;
};

&main_i2c4 {
	/* I2C_C/I2C_DISP */
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c4_pins_default>;
	clock-frequency = <400000>;
};

&main_mcan0 {
	/* CAN_A */
	pinctrl-names = "default";
	pinctrl-0 = <&main_mcan0_pins_default>;
};

&main_pmx0 {
	///delete-property/ interrupts;
	interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;

	main_epwm1_pins_default: main-epwm1-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x19c, PIN_OUTPUT, 6) /* LVDS_E_BL_PWM/PWM_2 (B25) MCASP0_AXR1.EHRPWM1_A */
			J722S_IOPAD(0x1a0, PIN_OUTPUT, 6) /* CAM_D_MCK/PWM_5 (F23) MCASP0_AXR0.EHRPWM1_B */
		>;
	};

	main_epwm2_pins_default: main-epwm2-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x1e8, PIN_OUTPUT, 8) /* LVDS_D_BL_PWM/PWM_1 (C24) I2C1_SCL.EHRPWM2_A */
			J722S_IOPAD(0x1ec, PIN_OUTPUT, 8) /* DSI_A_BL_PWM/PWM_0 (A22) I2C1_SDA.EHRPWM2_B */

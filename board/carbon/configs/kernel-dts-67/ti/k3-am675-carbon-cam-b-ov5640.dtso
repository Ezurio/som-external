/dts-v1/;
/plugin/;

#include "k3-am675-carbon-cam-b.dtsi"

&cam_b {
	compatible = "ovti,ov5640";
	reg = <0x3c>;

	DOVDD-supply = <&vdd_cam_b>;
	VDDA-supply = <&vdd_cam_b>;
	VDDD-supply = <&vdd_cam_b>;

	reset-gpios = <&exp0 2 GPIO_ACTIVE_LOW>; /* CAM_B_RST */
	powerdown-gpios = <&exp0 0 GPIO_ACTIVE_LOW>; /* CAM_B_PWR */
};

diff --git a/arch/arm/dts/k3-am62l-carbon-som.dtsi b/arch/arm/dts/k3-am62l-carbon-som.dtsi
new file mode 100644
index 00000000000..54427fff2a3
--- /dev/null
+++ b/arch/arm/dts/k3-am62l-carbon-som.dtsi
@@ -0,0 +1,1167 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AM62L Carbon SOM
+ *
+ * Copyright (C) 2026 Ezurio LLC
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include "k3-pinctrl.h"
+
+#include "k3-am62l3.dtsi"
+
+/ {
+	compatible = "summit,am62l3-carbon", "ti,am62l3";
+	model = "Ezurio Carbon AM62l3 SOM";
+
+	aliases {
+		mmc0 = &sdhci0;			/* eMMC */
+		mmc1 = &sdhci1;			/* SD/MMC */
+		mmc2 = &sdhci2;			/* Wi-Fi */
+		serial0 = &wkup_uart0;		/* UART_C */
+		serial2 = &main_uart0; 		/* UART_CON */
+		serial3 = &main_uart1;		/* BT */
+		serial4 = &main_uart5;		/* UART_A */
+		serial5 = &main_uart2;		/* UART_B */
+		serial6 = &main_uart3;		/* UART_D */
+		ethernet0 = &cpsw_port1;	/* ETH_A */
+		ethernet1 = &cpsw_port2;	/* ETH_B */
+		i2c0 = &wkup_i2c0;		/* I2C WKUP */
+		i2c1 = &main_i2c0;		/* I2C_A */
+		i2c2 = &main_i2c1;		/* I2C_B */
+		i2c3 = &main_i2c2;		/* I2C_C */
+		spi1 = &main_spi1;		/* SPI_A */
+		spi2 = &main_spi0;		/* SPI_B */
+		can0 = &main_mcan1;		/* CAN_A */
+		can1 = &main_mcan2;		/* CAN_B */
+		usb0 = &usb0;			/* USB_A */
+		usb1 = &usb1;			/* USB_B */
+		gpio0 = &wkup_gpio0;
+		gpio1 = &main_gpio0;
+		gpio2 = &main_gpio2;
+		gpio3 = &exp0;
+		rtc0 = &rv3028;
+		rtc1 = &wkup_rtc0;
+	};
+
+	chosen {
+		stdout-path = "serial2:115200n8";
+	};
+
+	memory: memory@80000000 {
+		device_type = "memory";
+		/* 2G RAM */
+		reg = <0x00000000 0x80000000 0x00000000 0x80000000>;
+	};
+
+	reserved_memory: reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* global cma region */
+		cma: linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x00 0x10000000>;
+			linux,cma-default;
+		};
+	};
+
+	reg_5v0: regulator-5v0 {
+		compatible = "regulator-fixed";
+		regulator-name = "reg_5v0";
+
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	reg_3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "reg_3v3";
+
+		vin-supply = <&reg_5v0>;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	reg_1v8: regulator-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "reg_1v8";
+
+		vin-supply = <&reg_3v3>;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	reg_vpp: regulator-vpp {
+		compatible = "regulator-fixed";
+		regulator-name = "reg_vpp";
+
+		vin-supply = <&reg_3v3>;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&main_vpp_en_pins_default>;
+		gpios = <&main_gpio0 6 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	reg_mmc0: regulator-mmc0 {
+		compatible = "regulator-fixed";
+		regulator-name = "reg_mmc0";
+
+		vin-supply = <&reg_3v3>;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpios = <&exp0 7 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		startup-delay-us = <5000>;
+		status = "disabled";
+	};
+
+	reg_mmc1: regulator-mmc1 {
+		compatible = "regulator-fixed";
+		regulator-name = "reg_mmc1";
+
+		vin-supply = <&reg_3v3>;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&main_mmc1_power_en_pins_default>;
+		gpios = <&main_gpio0 51 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		startup-delay-us = <5000>;
+		status = "disabled";
+	};
+
+	mmc0_pwrseq: mmc0-pwrseq {
+		pinctrl-names = "default";
+		pinctrl-0 = <&main_mmc0_reset_pins_default>;
+
+		compatible = "mmc-pwrseq-emmc";
+		reset-gpios = <&main_gpio0 52 GPIO_ACTIVE_LOW>;
+
+		status = "disabled";
+	};
+
+	reg_slow_clock: regulator-slow-clock {
+		compatible = "regulator-fixed-clock";
+
+		regulator-name = "reg_slow_clock";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		vin-supply = <&reg_3v3>;
+		clocks = <&scmi_clk 406>;
+
+		startup-delay-us = <1000>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&wkup_clkout_pins_default>;
+
+		assigned-clocks = <&scmi_clk 471>, <&scmi_clk 406>;
+		assigned-clock-parents = <&scmi_clk 468>, <&scmi_clk 404>;
+	};
+
+	reg_wifi_en: regulator-wifi-en {
+		compatible = "regulator-fixed";
+
+		regulator-name = "reg_wifi_en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		vin-supply = <&reg_slow_clock>;
+
+		gpios = <&exp0 0 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	wifi_wakeup: wifi-wakeup {
+		compatible = "gpio-keys";
+
+		status = "disabled";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&main_wifi_wake_default>, <&main_bt_wake_pins_default>;
+
+		wifi-wake {
+			label = "Wi-Fi Wake Up";
+			linux,code = <KEY_WAKEUP>;
+			wakeup-source;
+
+			interrupts-extended = <&main_gpio0 82 IRQ_TYPE_EDGE_FALLING>,
+				<&pmx0 0x18c>;
+			interrupt-names = "irq", "wakeup";
+
+			//gpios = <&main_gpio0 82 GPIO_ACTIVE_LOW>;
+			//wakeup-event-action = <EV_ACT_ASSERTED>;
+		};
+
+		bt-wake {
+			label = "BT Wake Up";
+			linux,code = <KEY_WAKEUP>;
+			wakeup-source;
+
+			interrupts-extended = <&main_gpio0 5 IRQ_TYPE_EDGE_FALLING>,
+				<&pmx0 0x050>;
+			interrupt-names = "irq", "wakeup";
+
+			//gpios = <&main_gpio0 5 GPIO_ACTIVE_LOW>;
+			//wakeup-event-action = <EV_ACT_ASSERTED>;
+		};
+	};
+};
+
+&main_rti1 {
+	status = "disabled";
+};
+
+&main_uart0 {
+	/* UART_CON */
+	pinctrl-names = "default", "wakeup";
+	pinctrl-0 = <&main_uart0_tx_pins_default>, <&main_uart0_rx_pins_default>;
+	pinctrl-1 = <&main_uart0_tx_pins_default>, <&main_uart0_rx_pins_wakeup>;
+	wakeup-source  = <&system_deep_sleep>;
+	status = "okay";
+};
+
+&main_uart1 {
+	/* BT */
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_uart1_pins_default>;
+
+	uart-has-rtscts;
+};
+
+&main_uart2 {
+	/* UART_B */
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_uart2_pins_default>;
+};
+
+&main_uart3 {
+	/* UART_D */
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_uart3_pins_default>;
+};
+
+&main_uart5 {
+	/* UART_A */
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_uart5_pins_default>;
+};
+
+&wkup_uart0_interconnect {
+	status = "okay";
+};
+
+&wkup_uart0 {
+	/* UART_C */
+	pinctrl-names = "default";
+	pinctrl-0 = <&wkup_uart0_pins_default>;
+};
+
+&main_i2c0 {
+	/* I2C_A */
+	pinctrl-names = "default";

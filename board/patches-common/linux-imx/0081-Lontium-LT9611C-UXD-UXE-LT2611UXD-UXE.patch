+
+static u8 lt96xx_conversion_formula(const struct drm_connector_state *state)
+{
+	bool limited = state->hdmi.is_limited_range;
+
+	switch (state->colorspace) {
+	case DRM_MODE_COLORIMETRY_BT709_YCC:
+	case DRM_MODE_COLORIMETRY_XVYCC_709:
+		return limited ? 0x02 : 0x03;
+	case DRM_MODE_COLORIMETRY_BT2020_CYCC:
+	case DRM_MODE_COLORIMETRY_BT2020_RGB:
+	case DRM_MODE_COLORIMETRY_BT2020_YCC:
+		return limited ? 0x04 : 0x05;
+	default:
+		return limited ? 0x00 : 0x01;
+	}
+}
+
+/* This setup CSC (Color Space Conversion) for the HDMI output 
+ * based on the connector state and other information,
+ * It is not present in all firmware versions and must be 
+ * requested from Lontium explicitly.
+ */
+int lt96xx_set_output_format(struct lt96xx_common *common,
+			     const struct drm_connector_state *state)
+{
+	u8 format_data[4];
+	struct lt96xx_rsp rsp = {};
+	const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT96XX_TYPE_HDMI,
+			 LT96XX_HDMI_SEQ_OUTPUT_FORMAT, LT96XX_CMD_SEP },
+		.data = format_data,
+		.data_len = ARRAY_SIZE(format_data),
+	};
+
+	switch (state->hdmi.output_format) {
+	case HDMI_COLORSPACE_RGB:
+		format_data[0] = 0x01;
+		break;
+	case HDMI_COLORSPACE_YUV444:
+		format_data[0] = 0x02;
+		break;
+	case HDMI_COLORSPACE_YUV422:
+		format_data[0] = 0x03;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (state->hdmi.output_bpc) {
+	case 8:
+		format_data[1] = 0x01;
+		break;
+	case 10:
+		format_data[1] = 0x02;
+		break;
+	case 12:
+		format_data[1] = 0x03;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	format_data[2] = state->hdmi.is_limited_range ? 0x02 : 0x01;
+	format_data[3] = lt96xx_conversion_formula(state);
+
+	return lt96xx_read_write_flow(common, &cmd, &rsp);
+}
+
+int lt96xx_set_power_mode(struct lt96xx_common *common, u8 mode)
+{
+	struct lt96xx_rsp rsp = {};
+	const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT96XX_TYPE_CUSTOM,
+			 LT96XX_CUSTOM_SEQ_POWER_MODE, LT96XX_CMD_SEP },
+		.data = &mode,
+		.data_len = 1,
+	};
+
+	return lt96xx_read_write_flow(common, &cmd, &rsp);
+}
+
+int lt96xx_select_ports(struct lt96xx_common *common, u8 type, u8 num_ports,
+			u8 port_swap)
+{
+	const u8 port_data[] = { num_ports, port_swap };
+	struct lt96xx_rsp rsp = {};
+	const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, type, LT96XX_SEQ_SELECT_PORTS,
+			 LT96XX_CMD_SEP },
+		.data = port_data,
+		.data_len = ARRAY_SIZE(port_data),
+	};
+
+	return lt96xx_read_write_flow(common, &cmd, &rsp);
+}
+
+u8 lt96xx_pack_port_swap(const u8 *codes, unsigned int count)
+{
+	u8 swap = 0;
+	unsigned int i;
+
+	for (i = 0; i < count && i < 4; i++)
+		swap |= (codes[i] & 0x3) << (6 - 2 * i);
+
+	return swap;
+}
+
+/* Hardware/pin Channel to Physical Port mapping */
+const u8 lt96xx_port_map[4] = { 0b01, 0b11, 0b00, 0b10 };
+
+static void lt96xx_fw_loaded(const struct firmware *fw, void *context)
+{
+	struct lt96xx_common *common = context;
+	struct device *dev = common->dev;
+	int ret;
+
+	if (!fw) {
+		dev_err(dev, "failed reading firmware file '%s'\n", common->fw_file);
+		goto fail;
+	}
+
+	ret = lt96xx_firmware_upgrade_fw(common, fw);
+
+	release_firmware(fw);
+
+	if (ret < 0)
+		goto fail;
+
+	ret = lt96xx_read_fw_version(common);
+	if (ret <= 0)
+		goto fail;
+
+	common->fw_version = ret;
+
+	dev_dbg(dev, "current version: 0x%04x\n", common->fw_version);
+	return;
+
+fail:
+	dev_err(dev, "firmware update failed\n"
+		"update need to be performed manually, by issuing\n"
+		"'echo 1 > /sys/bus/i2c/devices/%s/firmware'\n", 
+		dev_name(dev));
+}
+
+int lt96xx_probe_common(struct lt96xx_common *common)
+{
+	struct device *dev = common->dev;
+	int ret;
+
+	common->timing_valid = ! of_get_drm_panel_display_mode(dev->of_node,
+					    &common->timing_mode,
+					    &common->timing_bus_flags);
+
+	if (!i2c_check_functionality(common->client->adapter, I2C_FUNC_I2C))
+		return dev_err_probe(dev, -ENODEV, "device doesn't support I2C\n");
+
+	i2c_set_clientdata(common->client, common);
+
+	ret = devm_mutex_init(dev, &common->mcu_lock);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to init mutex\n");
+
+	common->regmap = devm_regmap_init_i2c(common->client,
+		&lt96xx_regmap_config);
+	if (IS_ERR(common->regmap))
+		return dev_err_probe(dev, PTR_ERR(common->regmap),
+				     "regmap i2c init failed\n");
+
+	/* keep ic in reset until interrupts enabled */
+	common->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(common->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(common->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	common->supplies[0].supply = "vcc";
+	common->supplies[1].supply = "vdd";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(common->supplies),
+				      common->supplies);
+	if (ret)
+		return ret;
+
+	INIT_WORK(&common->work, lt96xx_hpd_work);
+
+	ret = devm_request_threaded_irq(dev, common->client->irq, NULL,
+					lt96xx_irq_thread_handler,
+					IRQF_TRIGGER_FALLING | IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					dev_name(dev), common);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(common->supplies), common->supplies);
+	if (ret)
+		return ret;
+
+	/*
+	 * Add the bridge before any slow I2C traffic below (reset, chip ID,
+	 * firmware version) so a spurious HPD interrupt racing that sequence
+	 * always has an added bridge to notify instead of one that isn't
+	 * registered yet.
+	 */
+	common->bridge.of_node = dev->of_node;
+	common->bridge.ops = 
+			DRM_BRIDGE_OP_DETECT | 
+			DRM_BRIDGE_OP_HPD |
+			DRM_BRIDGE_OP_HDMI |
+			DRM_BRIDGE_OP_HDMI_AUDIO;
+	
+	common->bridge.ops |= common->timing_valid ? 
+		DRM_BRIDGE_OP_MODES : DRM_BRIDGE_OP_EDID;
+
+	common->bridge.type = DRM_MODE_CONNECTOR_HDMIA;
+	common->bridge.vendor = "Lontium";
+	common->bridge.supported_formats = BIT(HDMI_COLORSPACE_RGB) |
+					  BIT(HDMI_COLORSPACE_YUV422) |
+					  BIT(HDMI_COLORSPACE_YUV444);
+	common->bridge.max_bpc = 10;
+	common->bridge.hdmi_audio_dev = dev;
+	common->bridge.hdmi_audio_max_i2s_playback_channels = 8;
+	common->bridge.hdmi_audio_dai_port = 2;
+	drm_bridge_add(&common->bridge);
+
+	enable_irq(common->client->irq);
+
+	/* release the reset */
+	lt96xx_reset(common);
+
+	/* chip id check is a sanity check will never fail with proper integration */
+	ret = lt96xx_read_chipid(common);
+	if (ret < 0) {
+		dev_err(dev, "failed to read chip id.\n");
+		lt96xx_remove_common(common->client);
+		return ret;
+	}
+
+	ret = lt96xx_read_fw_version(common);
+	if (ret <= 0) {
+		dev_warn(dev, "no firmware programmed, requesting the update\n");
+		ret = request_firmware_nowait(THIS_MODULE, false,
+					      common->fw_file, dev, GFP_KERNEL,
+					      common, lt96xx_fw_loaded);
+		if (ret)
+			dev_warn(dev,
+				"failed to request firmware update, retry manually via sysfs\n");
+	} else {
+		common->fw_version = ret;
+	}
+
+	return 0;
+}
+
+void lt96xx_remove_common(struct i2c_client *client)
+{
+	struct lt96xx_common *common = i2c_get_clientdata(client);
+
+	disable_irq(common->client->irq);
+	cancel_work_sync(&common->work);
+	drm_bridge_remove(&common->bridge);
+	regulator_bulk_disable(ARRAY_SIZE(common->supplies), common->supplies);
+
+	drm_edid_free(common->cached_edid);
+	common->cached_edid = NULL;
+}
+
+struct lt96xx_common *bridge_to_lt96xx(struct drm_bridge *bridge)
+{
+	return container_of(bridge, struct lt96xx_common, bridge);
+}
+
+const struct lt96xx_common *
+bridge_to_lt96xx_const(const struct drm_bridge *bridge)
+{
+	return container_of_const(bridge, struct lt96xx_common, bridge);
+}
+
+static int lt96xx_read_hpd(struct lt96xx_common *common)
+{
+	int ret;
+	const u8 hpd_data[] = { 0x00 };
+	const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_READ, LT96XX_TYPE_HDMI,
+			 LT96XX_HDMI_SEQ_HPD, LT96XX_CMD_SEP },
+		.data = hpd_data,
+		.data_len = 1,
+	};
+	u8 hpd_status;
+	struct lt96xx_rsp rsp = { .data = &hpd_status, .data_len = 1 };
+
+	ret = lt96xx_read_write_flow(common, &cmd, &rsp);
+	if (ret)
+		return ret;
+
+	return hpd_status == 0x02;
+}
+
+irqreturn_t lt96xx_irq_thread_handler(int irq, void *dev_id)
+{
+	struct lt96xx_common *common = dev_id;
+	struct device *dev = common->dev;
+	int ret;
+	unsigned int irq_status;
+
+	guard(mutex)(&common->mcu_lock);
+
+	ret = regmap_read(common->regmap, 0xe084, &irq_status);
+	if (ret) {
+		dev_err(dev, "failed to read irq status: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+
+
+	/* Clear interrupt: hardware requires two writes with delay */
+	regmap_write(common->regmap, 0xe0df, irq_status);
+	usleep_range(10000, 12000);
+	regmap_write(common->regmap, 0xe0df, 0);
+
+	if (irq_status & BIT(0))
+		schedule_work(&common->work);
+
+	return IRQ_HANDLED;
+}
+
+/* EDID base block + reasonable number of extension blocks; caps a corrupted
+ * block-0 extension count from driving excessive slow MCU-mailbox reads. */
+#define LT96XX_EDID_MAX_BLOCKS 4
+
+static int lt96xx_get_edid_block(void *data, u8 *buf, unsigned int block,
+				 size_t len)
+{
+	struct lt96xx_common *common = data;
+	struct device *dev = common->dev;
+	
+	u8 edid_raw[LT96XX_CMD_Y0_SIZE + LT96XX_EDID_BUF_SIZE];
+	u8 y0;
+	int ret, i, offset = 0, attempt;
+	
+	struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_READ, LT96XX_TYPE_HDMI,
+			 LT96XX_HDMI_SEQ_EDID, LT96XX_CMD_SEP },
+	};
+	struct lt96xx_rsp rsp = {
+		.data = edid_raw,
+		.data_len = LT96XX_CMD_Y0_SIZE + LT96XX_EDID_BUF_SIZE,
+	};
+
+	dev_dbg(dev, "Reading EDID block %u\n", block);
+
+	if (len != 128)
+		return -EINVAL;
+
+	for (i = 0; i < 4; i++) {
+		y0 = block * 4 + i;
+		cmd.data = &y0;
+		cmd.data_len = 1;
+
+		for (attempt = 0; attempt < 3; attempt++) {
+			ret = lt96xx_read_write_flow(common, &cmd, &rsp);
+			if (!ret)
+				break;
+		}
+		if (ret) {
+			dev_err(dev, "Failed to read EDID block %u packet %d\n",
+				block, i);
+			return ret;
+		}
+		memcpy(buf + offset, &edid_raw[LT96XX_CMD_Y0_SIZE],
+		       LT96XX_EDID_BUF_SIZE);
+		offset += LT96XX_EDID_BUF_SIZE;
+	}
+
+	return 0;
+}
+
+static const struct drm_edid *lt96xx_read_edid(struct lt96xx_common *common)
+{
+	u8 buf[EDID_LENGTH];
+	int ret, num_blocks, i;
+	struct edid *edid;
+	const struct drm_edid *drm_edid;
+
+	ret = lt96xx_get_edid_block(common, buf, 0, EDID_LENGTH);
+	if (ret)
+		return NULL;
+
+	edid = (struct edid *)buf;
+	num_blocks = min_t(int, edid->extensions + 1, LT96XX_EDID_MAX_BLOCKS);
+
+	edid = kmemdup(buf, num_blocks * EDID_LENGTH, GFP_KERNEL);
+	if (!edid)
+		return NULL;
+
+	for (i = 1; i < num_blocks; i++) {
+		ret = lt96xx_get_edid_block(common, (u8 *)edid + i * EDID_LENGTH,
+					     i, EDID_LENGTH);
+		if (ret) {
+			kfree(edid);
+			return NULL;
+		}
+	}
+
+	drm_edid = drm_edid_alloc(edid, num_blocks * EDID_LENGTH);
+	kfree(edid);
+
+	if (!drm_edid_valid(drm_edid)) {
+		drm_edid_free(drm_edid);
+		return NULL;
+	}
+
+	return drm_edid;
+}
+
+void lt96xx_hpd_work(struct work_struct *work)
+{
+	struct lt96xx_common *common =
+		container_of(work, struct lt96xx_common, work);
+	int ret, i;
+
+	/* Give the chip time to reflect HPD state after the interrupt */
+	msleep(200);
+
+	for (i = 0; i < 3; i++) {
+		ret = lt96xx_read_hpd(common);
+		if (ret >= 0)
+			break;
+	}
+
+	if (ret < 0) {
+		dev_err(common->dev, "Failed to read HPD status (err=%d)\n", ret);
+		return;
+	}
+
+	if (ret && !common->timing_valid) {
+		/* Reading EDID takes long time, so do it before updating states */
+		const struct drm_edid *new_edid = lt96xx_read_edid(common);
+
+		guard(mutex)(&common->mcu_lock);
+
+		drm_edid_free(common->cached_edid);
+		common->cached_edid = new_edid;
+	}
+
+	common->hdmi_connected = ret ? connector_status_connected :
+		connector_status_disconnected;
+
+	dev_dbg(common->dev, "HPD work: connector status is %s, edid is %s\n",
+		 ret ? "connected" : "disconnected",
+		 common->cached_edid ? "valid" : "none");
+
+	 drm_bridge_hpd_notify(&common->bridge, common->hdmi_connected);
+}
+
+int lt96xx_bridge_attach(struct drm_bridge *bridge,
+			 struct drm_encoder *encoder,
+			 enum drm_bridge_attach_flags flags)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+	struct drm_connector *connector;
+	int ret;
+
+	if (common->next_bridge) {
+		ret = drm_bridge_attach(encoder, common->next_bridge, bridge,
+					flags | DRM_BRIDGE_ATTACH_NO_CONNECTOR);
+		if (ret < 0)
+			return ret;
+	}
+
+	if (flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR)
+		return 0;
+
+	connector = drm_bridge_connector_init(bridge->dev, encoder);
+	if (IS_ERR(connector)) {
+		ret = PTR_ERR(connector);
+		dev_err(common->dev,
+			"failed to initialize bridge connector: %d\n", ret);
+		return ret;
+	}
+
+	ret = drm_connector_attach_encoder(connector, encoder);
+	if (ret) {
+		dev_err(common->dev,
+			"failed to attach connector to encoder: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+enum drm_mode_status
+lt96xx_hdmi_tmds_char_rate_valid(const struct drm_bridge *bridge,
+				 const struct drm_display_mode *mode,
+				 unsigned long long tmds_rate)
+{
+	const struct lt96xx_common *common = bridge_to_lt96xx_const(bridge);
+
+	if (tmds_rate > common->max_tmds_rate)
+		return MODE_CLOCK_HIGH;
+
+	if (tmds_rate < 25000000)
+		return MODE_CLOCK_LOW;
+
+	return MODE_OK;
+}
+
+enum drm_connector_status
+lt96xx_bridge_detect(struct drm_bridge *bridge,
+		     struct drm_connector *connector)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+
+	return common->hdmi_connected;
+}
+
+int lt96xx_bridge_get_modes(struct drm_bridge *bridge,
+				 struct drm_connector *connector)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &common->timing_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	if (common->bus_format)
+		drm_display_info_set_bus_formats(&connector->display_info,
+						 &common->bus_format, 1);
+	connector->display_info.bus_flags = common->timing_bus_flags;
+
+	return 1;
+}
+
+const struct drm_edid *lt96xx_bridge_edid_read(struct drm_bridge *bridge,
+					       struct drm_connector *connector)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+
+	if (common->hdmi_connected != connector_status_connected)
+		return NULL;
+
+	guard(mutex)(&common->mcu_lock);
+	return drm_edid_dup(common->cached_edid);
+}
+
+int lt96xx_write_infoframe(struct lt96xx_common *common, u8 reg_type,
+			   const u8 *buffer, size_t len)
+{
+	u8 extra[1 + LT96XX_INFOFRAME_MAX_SIZE];
+	struct lt96xx_rsp rsp = {};
+	struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT96XX_TYPE_HDMI,
+			 LT96XX_HDMI_SEQ_INFOFRAME, LT96XX_CMD_SEP },
+	};
+
+	if (len > LT96XX_INFOFRAME_MAX_SIZE)
+		return -EINVAL;
+
+	extra[0] = reg_type;
+	memcpy(&extra[1], buffer, len);
+	cmd.data = extra;
+	cmd.data_len = 1 + len;
+
+	return lt96xx_read_write_flow(common, &cmd, &rsp);
+}
+
+static int lt96xx_infoframe_reg_type(enum hdmi_infoframe_type type)
+{
+	switch (type) {
+	case HDMI_INFOFRAME_TYPE_AVI:
+		return 0x01;
+	case HDMI_INFOFRAME_TYPE_AUDIO:
+		return 0x02;
+	case HDMI_INFOFRAME_TYPE_DRM:
+		return 0x03;
+	case HDMI_INFOFRAME_TYPE_VENDOR:
+		return 0x04;
+	default:
+		return -EINVAL;
+	}
+}
+
+int lt96xx_hdmi_write_infoframe(struct drm_bridge *bridge,
+				 enum hdmi_infoframe_type type,
+				 const u8 *buffer, size_t len)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+	int reg_type = lt96xx_infoframe_reg_type(type);
+
+	if (reg_type < 0)
+		return reg_type;
+
+	return lt96xx_write_infoframe(common, reg_type, buffer, len);
+}
+
+int lt96xx_hdmi_clear_infoframe(struct drm_bridge *bridge,
+				 enum hdmi_infoframe_type type)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+	u8 clear_data[LT96XX_INFOFRAME_MAX_SIZE - 1] = {};
+	int reg_type = lt96xx_infoframe_reg_type(type);
+
+	if (reg_type < 0)
+		return reg_type;
+
+	return lt96xx_write_infoframe(common, reg_type, clear_data,
+				      sizeof(clear_data));
+}
+
+static int lt96xx_hdmi_audio_control(struct lt96xx_common *common,
+				      u8 format, u8 channels)
+{
+	const u8 audio_extra[2] = { format, channels };
+	struct lt96xx_rsp rsp = {};
+	const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT96XX_TYPE_HDMI,
+			 LT96XX_HDMI_SEQ_AUDIO, LT96XX_CMD_SEP },
+		.data = audio_extra,
+		.data_len = ARRAY_SIZE(audio_extra),
+	};
+
+	return lt96xx_read_write_flow(common, &cmd, &rsp);
+}
+
+static int lt96xx_hdmi_audio_set_width(struct lt96xx_common *common,
+					       u8 width)
+{
+	const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT96XX_TYPE_HDMI,
+			 LT96XX_HDMI_SEQ_AUDIO_WIDTH, LT96XX_CMD_SEP },
+		.data = &width,
+		.data_len = 1,
+	};
+	struct lt96xx_rsp rsp = {};
+
+	return lt96xx_read_write_flow(common, &cmd, &rsp);
+}
+
+int lt96xx_hdmi_audio_prepare(struct drm_bridge *bridge,
+			     struct drm_connector *connector,
+			     struct hdmi_codec_daifmt *fmt,
+			     struct hdmi_codec_params *hparms)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+	int ret;
+	u8 format, width;
+
+	if (hparms->sample_rate < LT96XX_HDMI_AUDIO_MIN_RATE ||
+	    hparms->sample_rate > LT96XX_HDMI_AUDIO_MAX_RATE)
+		return -EINVAL;
+
+	switch (hparms->sample_width) {
+	case 16:
+		width = 0x02;
+		break;
+	case 32:
+		width = 0x01;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt->fmt) {
+	case HDMI_I2S:
+		format = 0x01;
+		break;
+	case HDMI_SPDIF:
+		format = 0x02;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	ret = lt96xx_hdmi_audio_set_width(common, width);
+	if (ret < 0) {
+		dev_err(common->dev, "set audio width failed!\n");
+		return ret;
+	}
+
+	ret = lt96xx_hdmi_audio_control(common, format, hparms->channels);
+	if (ret < 0) {
+		dev_err(common->dev, "set audio info failed!\n");
+		return ret;
+	}
+
+	return drm_atomic_helper_connector_hdmi_update_audio_infoframe(
+		connector, &hparms->cea);
+}
+
+void lt96xx_hdmi_audio_shutdown(struct drm_bridge *bridge,
+			       struct drm_connector *connector)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+	int ret;
+
+	ret = lt96xx_hdmi_audio_control(common, 0x03, 0x00);
+	if (ret < 0)
+		dev_err(common->dev, "set audio info failed!\n");
+
+	drm_atomic_helper_connector_hdmi_clear_audio_infoframe(connector);
+}
+
+void lt96xx_setup_video_timing(struct device *dev,
+				 const struct drm_display_mode *mode,
+				 u8 *buf)
+{
+	struct lt96xx_video_timing timing = {
+		.h_total = cpu_to_be16(mode->htotal),
+		.hactive = cpu_to_be16(mode->hdisplay),
+		.hsync_len = cpu_to_be16(mode->hsync_end - mode->hsync_start),
+		.hfront_porch = cpu_to_be16(mode->hsync_start - mode->hdisplay),
+		.hback_porch = cpu_to_be16(mode->htotal - mode->hsync_end),
+		.v_total = cpu_to_be16(mode->vtotal),
+		.vactive = cpu_to_be16(mode->vdisplay),
+		.vsync_len = cpu_to_be16(mode->vsync_end - mode->vsync_start),
+		.vfront_porch = cpu_to_be16(mode->vsync_start - mode->vdisplay),
+		.vback_porch = cpu_to_be16(mode->vtotal - mode->vsync_end),
+		.framerate = drm_mode_vrefresh(mode),
+		.vic = drm_match_cea_mode(mode),
+	};
+
+	dev_dbg(dev, "hactive=%d, vactive=%d\n",
+		be16_to_cpu(timing.hactive), be16_to_cpu(timing.vactive));
+	dev_dbg(dev, "framerate=%d\n", timing.framerate);
+	dev_dbg(dev, "vic = 0x%02x\n", timing.vic);
+
+	memcpy(buf, &timing, sizeof(timing));
+}
+
+static int lt96xx_suspend(struct device *dev)
+{
+	struct lt96xx_common *common = dev_get_drvdata(dev);
+	int ret;
+
+	disable_irq(common->client->irq);
+	cancel_work_sync(&common->work);
+
+	guard(mutex)(&common->mcu_lock);
+
+	gpiod_set_value_cansleep(common->reset_gpio, 1);
+
+	ret = regulator_bulk_disable(ARRAY_SIZE(common->supplies),
+				     common->supplies);
+	if (ret) {
+		dev_err(common->dev, "regulator bulk disable failed.\n");
+		gpiod_set_value_cansleep(common->reset_gpio, 0);
+		enable_irq(common->client->irq);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int lt96xx_resume(struct device *dev)
+{
+	struct lt96xx_common *common = dev_get_drvdata(dev);
+	int ret;
+
+	guard(mutex)(&common->mcu_lock);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(common->supplies),
+				    common->supplies);
+	if (ret) {
+		dev_err(common->dev, "regulator bulk enable failed.\n");
+		return ret;
+	}
+	enable_irq(common->client->irq);
+	lt96xx_reset(common);
+
+	return ret;
+}
+
+const struct dev_pm_ops lt96xx_bridge_pm_ops = {
+	SET_SYSTEM_SLEEP_PM_OPS(lt96xx_suspend, lt96xx_resume)
+};
+
+static ssize_t firmware_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t len)
+{
+	struct lt96xx_common *common = dev_get_drvdata(dev);
+	struct drm_atomic_state *state = NULL;
+	const struct firmware *fw;
+	int ret, resume_ret;
+
+	dev_warn(dev, "starting firmware upgrade - display will be disrupted\n");
+
+	/* load firmware — must happen outside the mcu_lock */
+	ret = request_firmware_direct(&fw, common->fw_file, dev);
+	if (ret) {
+		dev_err(common->dev, "failed to load '%s'\n", common->fw_file);
+		return ret;
+	}
+
+	/*
+	 * Save and disable the complete DRM state before entering bootloader.
+	 * Best effort only: the upgrade proceeds even if this fails, since the
+	 * chip must still be reflashed once a manual upgrade has been requested.
+	 */
+	state = drm_atomic_helper_suspend(common->bridge.dev);
+	if (IS_ERR(state))
+		dev_err_probe(dev, PTR_ERR(state), "failed to suspend DRM state\n");
+
+	ret = lt96xx_firmware_upgrade_fw(common, fw);
+
+	release_firmware(fw);
+
+	if (ret)
+		goto resume;
+
+	ret = lt96xx_read_fw_version(common);
+	if (ret < 0) {
+		dev_warn(dev,
+			"upgrade succeeded but failed to read new fw version %d\n", ret);
+	} else {
+		common->fw_version = ret;
+		dev_info(dev, "firmware upgrade succeeded, version: 0x%04x\n", ret);
+	}
+
+resume:
+	if (!IS_ERR(state)) {
+		resume_ret = drm_atomic_helper_resume(common->bridge.dev, state);
+		if (resume_ret)
+			dev_err_probe(dev, resume_ret, "failed to resume DRM state\n");
+	}
+
+	return ret < 0 ? ret : len;
+}
+
+static ssize_t firmware_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct lt96xx_common *common = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "0x%04x\n", common->fw_version);
+}

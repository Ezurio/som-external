diff --git a/drivers/gpu/drm/bridge/lontium-lt2611uxd.c b/drivers/gpu/drm/bridge/lontium-lt2611uxd.c
new file mode 100644
index 0000000..75fb74f
--- /dev/null
+++ b/drivers/gpu/drm/bridge/lontium-lt2611uxd.c
@@ -0,0 +1,437 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2026 Ezurio, LLC.
+ *
+ * LVDS to HDMI bridge driver for the LT2611UXD/UXE chip family.
+ * Shared MCU-mailbox protocol/infrastructure lives in lontium-lt96xx.c.
+ */
+
+#include <linux/i2c.h>
+#include <linux/media-bus-format.h>
+#include <linux/module.h>
+#include <linux/of_graph.h>
+#include <linux/slab.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_of.h>
+#include <drm/display/drm_hdmi_state_helper.h>
+
+#include "lontium-lt96xx.h"
+
+/* lt96xx_cmd_hdr.type values specific to this chip family */
+#define LT2611UXD_TYPE_LVDS 0x4c /* 'L' */
+
+/* LVDS-type command sequence numbers */
+#define LT2611UXD_LVDS_SEQ_FORMAT 0x32
+#define LT2611UXD_LVDS_SEQ_VIDEO 0x34
+
+#define LT2611UXD_MAX_LVDS_PORTS 4
+#define LT2611UXD_LVDS_VIDEO_LEN (LT96XX_VIDEO_TIMING_LEN + 3)
+#define LT2611UXD_MAX_LVDS_FORMATS 5
+
+#define LT2611UXD_LVDS_DE_MODE 'D'
+#define LT2611UXD_LVDS_SYNC_MODE 'S'
+
+/* LVDS input pixel clock limits (kHz); dual/quad link double the max per link */
+#define LT2611UXD_LVDS_MIN_CLOCK 12500
+#define LT2611UXD_LVDS_SINGLE_MAX_CLOCK 214000
+
+#define LT2611UXD_FW_FILE "lt2611uxd_fw.bin"
+
+enum lt2611_chip_type {
+	CHIP_LT2611UXD = 0,
+	CHIP_LT2611UXE,
+};
+
+struct lt2611uxd_chip_data {
+	const char *product;
+	unsigned int max_ports;
+	unsigned long long max_tmds_rate;
+};
+
+static const struct lt2611uxd_chip_data lt2611uxd_chip_data[] = {
+	[CHIP_LT2611UXD] = { "LT2611UXD", 2, 600000000 },
+	[CHIP_LT2611UXE] = { "LT2611UXE", 4, 600000000 },
+};
+
+struct lt2611uxd {
+	struct lt96xx_common common;
+	const struct lt2611uxd_chip_data *cdata;
+	unsigned int num_ports;
+	/* LVDS Ports Select Y1 byte: physical port carrying each logical port */
+	u8 lvds_port_swap;
+};
+
+static const struct drm_bridge_timings lt2611uxd_default_timings = {
+	.input_bus_flags = DRM_BUS_FLAG_PIXDATA_SAMPLE_NEGEDGE |
+			   DRM_BUS_FLAG_DE_HIGH,
+};
+
+static struct lt2611uxd *bridge_to_lt2611uxd(struct drm_bridge *bridge)
+{
+	return container_of(bridge_to_lt96xx(bridge), struct lt2611uxd, common);
+}
+
+static int lt2611uxd_lvds_select_ports(struct lt2611uxd *lt2611uxd)
+{
+	return lt96xx_select_ports(&lt2611uxd->common, LT2611UXD_TYPE_LVDS,
+				   lt2611uxd->num_ports,
+				   lt2611uxd->lvds_port_swap);
+}
+
+static int lt2611uxd_lvds_set_format(struct device *dev,
+				     struct lt2611uxd *lt2611uxd, u32 mapping)
+{
+	struct lt96xx_rsp rsp = {};
+	u8 format;
+
+	switch (mapping) {
+	case MEDIA_BUS_FMT_RGB888_1X7X4_SPWG:
+		format = 0x02;
+		break;
+	case MEDIA_BUS_FMT_RGB666_1X7X3_SPWG:
+		format = 0x04;
+		break;
+	case MEDIA_BUS_FMT_RGB888_1X7X4_JEIDA:
+		format = 0x05;
+		break;
+	case MEDIA_BUS_FMT_RGB101010_1X7X5_JEIDA:
+		format = 0x06;
+		break;
+	case MEDIA_BUS_FMT_RGB101010_1X7X5_SPWG:
+		format = 0x03;
+		break;
+	default:
+		dev_err(dev, "unsupported lvds data-mapping\n");
+		return -EINVAL;
+	}
+
+	const struct lt96xx_cmd format_cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT2611UXD_TYPE_LVDS,
+			 LT2611UXD_LVDS_SEQ_FORMAT, LT96XX_CMD_SEP },
+		.data = &format,
+		.data_len = 1,
+	};
+
+	return lt96xx_read_write_flow(&lt2611uxd->common, &format_cmd, &rsp);
+}
+
+static int lt2611uxd_video_setup(struct lt2611uxd *lt2611uxd,
+				 const struct drm_display_mode *mode)
+{
+	struct device *dev = lt2611uxd->common.dev;
+	u8 timing_data[LT2611UXD_LVDS_VIDEO_LEN];
+	struct lt96xx_rsp rsp = {};
+
+	const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT2611UXD_TYPE_LVDS,
+			 LT2611UXD_LVDS_SEQ_VIDEO, LT96XX_CMD_SEP },
+		.data = timing_data,
+		.data_len = ARRAY_SIZE(timing_data),
+	};
+
+	lt96xx_setup_video_timing(dev, mode, &timing_data[1]);
+
+	timing_data[0] = LT2611UXD_LVDS_SYNC_MODE;
+	timing_data[23] = !!(mode->flags & DRM_MODE_FLAG_PHSYNC);
+	timing_data[24] = !!(mode->flags & DRM_MODE_FLAG_PVSYNC);
+
+	return lt96xx_read_write_flow(&lt2611uxd->common, &cmd, &rsp);
+}
+
+static void lt2611uxd_bridge_atomic_enable(struct drm_bridge *bridge,
+					   struct drm_atomic_state *state)
+{
+	struct lt2611uxd *lt2611uxd = bridge_to_lt2611uxd(bridge);
+	struct device *dev = lt2611uxd->common.dev;
+	struct drm_connector *connector;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_bridge_state *bridge_state;
+	u32 mapping;
+	int ret;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state,
+							     bridge->encoder);
+	if (WARN_ON(!connector))
+		return;
+
+	conn_state = drm_atomic_get_new_connector_state(state, connector);
+	if (WARN_ON(!conn_state))
+		return;
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, conn_state->crtc);
+	if (WARN_ON(!crtc_state))
+		return;
+
+	bridge_state = drm_atomic_get_new_bridge_state(state, bridge);
+	if (WARN_ON(!bridge_state))
+		return;
+
+	mapping = bridge_state->input_bus_cfg.format;
+	if (mapping == MEDIA_BUS_FMT_FIXED)
+		mapping = lt2611uxd->common.bus_format;
+	if (!mapping || mapping == MEDIA_BUS_FMT_FIXED) {
+		dev_err(dev, "LVDS data mapping was not negotiated\n");
+		return;
+	}
+
+	ret = lt2611uxd_lvds_select_ports(lt2611uxd);
+	if (ret)
+		dev_err(dev, "failed to select LVDS ports\n");
+
+	ret = lt2611uxd_lvds_set_format(dev, lt2611uxd, mapping);
+	if (ret)
+		dev_err(dev, "failed to set LVDS format\n");
+
+	ret = lt96xx_set_output_format(&lt2611uxd->common, conn_state);
+	if (ret)
+		dev_err(dev, "failed to set output data format\n");
+
+	ret = lt96xx_set_hdmi_mode(&lt2611uxd->common,
+				   connector->display_info.is_hdmi);
+	if (ret)
+		dev_err(dev, "failed to set HDMI/DVI mode\n");
+
+	ret = lt2611uxd_video_setup(lt2611uxd, &crtc_state->adjusted_mode);
+	if (ret)
+		dev_err(dev, "video format setup failed\n");
+
+	ret = lt96xx_hdmi_enable(&lt2611uxd->common, true);
+	if (ret)
+		dev_err(dev, "failed to enable HDMI output\n");
+}
+
+static void lt2611uxd_bridge_atomic_disable(struct drm_bridge *bridge,
+					    struct drm_atomic_state *state)
+{
+	struct lt2611uxd *lt2611uxd = bridge_to_lt2611uxd(bridge);
+	struct device *dev = lt2611uxd->common.dev;
+	int ret;
+
+	ret = lt96xx_hdmi_enable(&lt2611uxd->common, false);
+	if (ret)
+		dev_err(dev, "failed to disable HDMI output\n");
+}
+
+static enum drm_mode_status
+lt2611uxd_bridge_mode_valid(struct drm_bridge *bridge,
+			    const struct drm_display_info *info,
+			    const struct drm_display_mode *mode)
+{
+	const struct lt2611uxd *lt2611uxd = bridge_to_lt2611uxd(bridge);
+	unsigned int max_clock =
+		LT2611UXD_LVDS_SINGLE_MAX_CLOCK * lt2611uxd->num_ports;
+
+	if (mode->clock < LT2611UXD_LVDS_MIN_CLOCK)
+		return MODE_CLOCK_LOW;
+
+	if (mode->clock > max_clock)
+		return MODE_CLOCK_HIGH;
+
+	return MODE_OK;
+}
+
+static u32 *lt2611uxd_bridge_atomic_get_input_bus_fmts(
+	struct drm_bridge *bridge, struct drm_bridge_state *bridge_state,
+	struct drm_crtc_state *crtc_state,
+	struct drm_connector_state *conn_state, u32 output_fmt,
+	unsigned int *num_input_fmts)
+{
+	struct lt2611uxd *lt2611uxd = bridge_to_lt2611uxd(bridge);
+	static const u32 supported_formats[LT2611UXD_MAX_LVDS_FORMATS] = {
+		MEDIA_BUS_FMT_RGB888_1X7X4_SPWG,
+		MEDIA_BUS_FMT_RGB888_1X7X4_JEIDA,
+		MEDIA_BUS_FMT_RGB666_1X7X3_SPWG,
+		MEDIA_BUS_FMT_RGB101010_1X7X5_SPWG,
+		MEDIA_BUS_FMT_RGB101010_1X7X5_JEIDA,
+	};
+	const u32 *fmts = &lt2611uxd->common.bus_format;
+	unsigned int count = 1;
+	u32 *input_fmts;
+
+	*num_input_fmts = 0;
+
+	if (!lt2611uxd->common.bus_format) {
+		fmts = supported_formats;
+		count = ARRAY_SIZE(supported_formats);
+	}
+
+	input_fmts = kmemdup(fmts, count * sizeof(*input_fmts), GFP_KERNEL);
+	if (!input_fmts)
+		return NULL;
+
+	*num_input_fmts = count;
+
+	return input_fmts;
+}
+
+static int lt2611uxd_bridge_atomic_check(struct drm_bridge *bridge,
+					 struct drm_bridge_state *bridge_state,
+					 struct drm_crtc_state *crtc_state,
+					 struct drm_connector_state *conn_state)
+{
+	bridge_state->input_bus_cfg.flags = bridge->timings->input_bus_flags;
+
+	return 0;
+}
+
+static const struct drm_bridge_funcs lt2611uxd_bridge_funcs = {
+	.mode_valid = lt2611uxd_bridge_mode_valid,
+	.get_modes = lt96xx_bridge_get_modes,
+	.attach = lt96xx_bridge_attach,
+	.detect = lt96xx_bridge_detect,
+	.edid_read = lt96xx_bridge_edid_read,
+	.atomic_enable = lt2611uxd_bridge_atomic_enable,
+	.atomic_disable = lt2611uxd_bridge_atomic_disable,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+	.atomic_get_input_bus_fmts = lt2611uxd_bridge_atomic_get_input_bus_fmts,
+	.atomic_check = lt2611uxd_bridge_atomic_check,
+	.atomic_reset = drm_atomic_helper_bridge_reset,
+
+	.hdmi_tmds_char_rate_valid = lt96xx_hdmi_tmds_char_rate_valid,
+	.hdmi_write_infoframe = lt96xx_hdmi_write_infoframe,
+	.hdmi_clear_infoframe = lt96xx_hdmi_clear_infoframe,
+	.hdmi_audio_prepare = lt96xx_hdmi_audio_prepare,
+	.hdmi_audio_shutdown = lt96xx_hdmi_audio_shutdown,
+};
+
+static int lt2611uxd_parse_dt(struct device *dev, struct lt2611uxd *lt2611uxd)
+{
+	struct device_node *ports[2] = {};
+	u8 codes[LT2611UXD_MAX_LVDS_PORTS];
+	unsigned int i, num_ports = 0;
+	int mapping;
+
+	/* Read data-mapping from the bridge node during probe. */
+	mapping = drm_of_lvds_get_data_mapping(dev->of_node);
+	if (mapping > 0)
+		lt2611uxd->common.bus_format = mapping;
+
+	for (i = 0; i < lt2611uxd->cdata->max_ports; i++) {
+		struct device_node *ep;
+
+		/* Get the local endpoint for this LVDS port */
+		ep = of_graph_get_endpoint_by_regs(dev->of_node, i, -1);
+		if (!ep)
+			continue;
+
+		/* Record this physical port's identity code for the next logical slot */
+		codes[num_ports] = lt96xx_port_map[i];
+
+		/* Store the port node of the local endpoint for later use */
+		if (num_ports < 2)
+			ports[num_ports] = of_get_parent(ep);
+
+		of_node_put(ep);
+
+		num_ports++;
+	}
+
+	/* Ensure that at least one LVDS port was found */
+	if (!num_ports)
+		return dev_err_probe(dev, -ENODEV,
+				     "no LVDS input port found\n");
+
+	lt2611uxd->num_ports = num_ports;
+	lt2611uxd->lvds_port_swap = lt96xx_pack_port_swap(codes, num_ports);
+
+	/* Handle potential lane swap for dual-link LVDS port */
+	if (num_ports == 2 &&
+	    drm_of_lvds_get_dual_link_pixel_order_sink(ports[0], ports[1]) ==
+		    DRM_LVDS_DUAL_LINK_EVEN_ODD_PIXELS)
+		lt2611uxd->lvds_port_swap =
+			((lt2611uxd->lvds_port_swap >> 2) & 0x30) |
+			((lt2611uxd->lvds_port_swap << 2) & 0xc0);
+
+	of_node_put(ports[0]);
+	of_node_put(ports[1]);
+
+	return lt96xx_probe_output_bridge(&lt2611uxd->common, dev->of_node,
+					 LT2611UXD_MAX_LVDS_PORTS);
+}
+
+static int lt2611uxd_probe(struct i2c_client *client)
+{
+	struct lt2611uxd *lt2611uxd;
+	struct lt96xx_common *common;
+	struct device *dev = &client->dev;
+	int ret;
+
+	lt2611uxd = devm_drm_bridge_alloc(dev, struct lt2611uxd, common.bridge,
+					  &lt2611uxd_bridge_funcs);
+	if (IS_ERR(lt2611uxd))
+		return dev_err_probe(dev, PTR_ERR(lt2611uxd),
+				     "drm bridge alloc failed.\n");
+
+	lt2611uxd->cdata = i2c_get_match_data(client);
+	if (!lt2611uxd->cdata)
+		return dev_err_probe(dev, -EINVAL, "no match data for device\n");
+
+	common = &lt2611uxd->common;
+	common->dev = dev;
+	common->client = client;
+	common->fw_file = LT2611UXD_FW_FILE;
+	common->max_tmds_rate = lt2611uxd->cdata->max_tmds_rate;
+	common->bridge.product = lt2611uxd->cdata->product;
+	common->bridge.timings = &lt2611uxd_default_timings;
+
+	ret = lt2611uxd_parse_dt(dev, lt2611uxd);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse device tree\n");
+
+	ret = lt96xx_probe_common(common);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "initialized successfully with fw version 0x%04x\n",
+		common->fw_version);
+
+	return 0;
+}
+
+static const struct i2c_device_id lt2611uxd_id[] = {
+	{ 
+		"lontium,lt2611uxd",
+		(kernel_ulong_t)&lt2611uxd_chip_data[CHIP_LT2611UXD]
+	},
+	{ 
+		"lontium,lt2611uxe",
+		(kernel_ulong_t)&lt2611uxd_chip_data[CHIP_LT2611UXE]
+	},
+	{ /* sentinel */ }
+};
+
+static const struct of_device_id lt2611uxd_match_table[] = {
+	{ 
+		.compatible = "lontium,lt2611uxd",
+		.data = &lt2611uxd_chip_data[CHIP_LT2611UXD]
+	},
+	{ 
+		.compatible = "lontium,lt2611uxe",
+		.data = &lt2611uxd_chip_data[CHIP_LT2611UXE]
+	},
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lt2611uxd_match_table);
+
+static struct i2c_driver lt2611uxd_driver = {
+	.driver = {
+		.name = "lt2611uxd",
+		.of_match_table = lt2611uxd_match_table,
+		.pm = &lt96xx_bridge_pm_ops,
+		.dev_groups = lt96xx_attr_groups,
+	},
+	.probe = lt2611uxd_probe,
+	.remove = lt96xx_remove_common,
+	.id_table = lt2611uxd_id,
+};
+module_i2c_driver(lt2611uxd_driver);
+
+MODULE_FIRMWARE(LT2611UXD_FW_FILE);
+MODULE_AUTHOR("Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>");
+MODULE_DESCRIPTION("Lontium LT2611UXD/UXE LVDS to HDMI bridge");
+MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/bridge/lontium-lt9611c.c b/drivers/gpu/drm/bridge/lontium-lt9611c.c
new file mode 100644
index 0000000..75fb74f
--- /dev/null
+++ b/drivers/gpu/drm/bridge/lontium-lt9611c.c
@@ -0,0 +1,368 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2026 Lontium Semiconductor, Inc.
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ * Copyright (C) 2026 Ezurio, LLC.
+ *
+ * MIPI DSI to HDMI bridge driver for the LT9611C/EX/UXD chip family.
+ * Shared MCU-mailbox protocol/infrastructure lives in lontium-lt96xx.c.
+ */
+
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of_graph.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_of.h>
+#include <drm/display/drm_hdmi_state_helper.h>
+
+#include "lontium-lt96xx.h"
+
+/* lt96xx_cmd_hdr.type value specific to this chip family */
+#define LT9611C_TYPE_MIPI 0x4d /* 'M' */
+
+/* MIPI-type command sequence number */
+#define LT9611C_MIPI_SEQ_LANES 0x32
+#define LT9611C_MIPI_SEQ_VIDEO 0x33
+
+#define LT9611C_MAX_MIPI_PORTS 2
+#define LT9611C_MIPI_VIDEO_LEN LT96XX_VIDEO_TIMING_LEN
+
+#define LT9611C_FW_FILE "lt9611c_fw.bin"
+
+enum lt9611_chip_type {
+	CHIP_LT9611C = 0,
+	CHIP_LT9611EX,
+	CHIP_LT9611UXD,
+};
+
+struct lt9611c_chip_data {
+	const char *product;
+	unsigned int max_ports;
+	unsigned long long max_tmds_rate;
+};
+
+static const struct lt9611c_chip_data lt9611c_chip_data[] = {
+	[CHIP_LT9611C]   = { "LT9611C",   1, 340000000 },
+	[CHIP_LT9611EX]  = { "LT9611EX",  2, 340000000 },
+	[CHIP_LT9611UXD] = { "LT9611UXD",  2, 600000000 },
+};
+
+struct lt9611c {
+	struct lt96xx_common common;
+	unsigned int num_ports;
+	struct mipi_dsi_host *dsi_hosts[LT9611C_MAX_MIPI_PORTS];
+	const struct lt9611c_chip_data *cdata;
+	u8 port_swap;
+	u8 lanes;
+};
+
+static struct lt9611c *bridge_to_lt9611c(struct drm_bridge *bridge)
+{
+	return container_of(bridge_to_lt96xx(bridge), struct lt9611c, common);
+}
+
+static int lt9611c_attach_dsi(struct lt9611c *lt9611c)
+{
+	const struct mipi_dsi_device_info info = { "lt9611c", 0, NULL };
+	struct device *dev = lt9611c->common.dev;
+	struct mipi_dsi_device *dsi;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < lt9611c->num_ports; i++) {
+		dsi = devm_mipi_dsi_device_register_full(dev, lt9611c->dsi_hosts[i],
+							 &info);
+		if (IS_ERR(dsi))
+			return dev_err_probe(dev, PTR_ERR(dsi),
+					     "failed to create dsi device for port %u\n", i);
+
+		dsi->lanes = lt9611c->lanes;
+		dsi->format = MIPI_DSI_FMT_RGB888;
+		dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+				  MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+				  MIPI_DSI_MODE_VIDEO_HSE |
+				  MIPI_DSI_MODE_VIDEO_BURST |
+				  MIPI_DSI_MODE_LPM |
+				  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+		ret = devm_mipi_dsi_attach(dev, dsi);
+		if (ret < 0)
+			return dev_err_probe(dev, ret,
+					     "failed to attach dsi device for port %u\n", i);
+	}
+
+	return 0;
+}
+
+static int lt9611c_video_setup(struct lt9611c *lt9611c,
+				const struct drm_display_mode *mode)
+{
+	struct lt96xx_common *common = &lt9611c->common;
+	struct device *dev = common->dev;
+	u8 timing_data[LT9611C_MIPI_VIDEO_LEN];
+	struct lt96xx_rsp rsp = {};
+	struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT9611C_TYPE_MIPI,
+			 LT9611C_MIPI_SEQ_VIDEO, LT96XX_CMD_SEP },
+		.data = timing_data,
+		.data_len = LT9611C_MIPI_VIDEO_LEN,
+	};
+
+	lt96xx_setup_video_timing(dev, mode, timing_data);
+
+	return lt96xx_read_write_flow(common, &cmd, &rsp);
+}
+
+static int lt9611c_lane_setup(struct lt9611c *lt9611c)
+{
+	struct lt96xx_common *common = &lt9611c->common;
+	const u8 lane_data = lt9611c->lanes;
+	struct lt96xx_rsp rsp = {};
+	const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_WRITE, LT9611C_TYPE_MIPI,
+			 LT9611C_MIPI_SEQ_LANES, LT96XX_CMD_SEP },
+		.data = &lane_data,
+		.data_len = 1,
+	};
+
+	return lt96xx_read_write_flow(common, &cmd, &rsp);
+}
+
+static void lt9611c_bridge_atomic_enable(struct drm_bridge *bridge,
+					 struct drm_atomic_state *state)
+{
+	struct lt9611c *lt9611c = bridge_to_lt9611c(bridge);
+	struct lt96xx_common *common = &lt9611c->common;
+	struct device *dev = common->dev;
+	struct drm_connector *connector;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	int ret;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state, bridge->encoder);
+	if (WARN_ON(!connector))
+		return;
+
+	conn_state = drm_atomic_get_new_connector_state(state, connector);
+	if (WARN_ON(!conn_state))
+		return;
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, conn_state->crtc);
+	if (WARN_ON(!crtc_state))
+		return;
+
+	ret = lt96xx_select_ports(common, LT9611C_TYPE_MIPI, lt9611c->num_ports,
+				  lt9611c->port_swap);
+	if (ret)
+		dev_err(dev, "failed to select MIPI ports\n");
+
+	ret = lt9611c_lane_setup(lt9611c);
+	if (ret)
+		dev_err(dev, "failed to set MIPI lane count\n");
+
+	ret = lt9611c_video_setup(lt9611c, &crtc_state->adjusted_mode);
+	if (ret)
+		dev_err(dev, "video mode setup failed\n");
+
+	ret = lt96xx_set_hdmi_mode(common, connector->display_info.is_hdmi);
+	if (ret)
+		dev_err(dev, "failed to set HDMI/DVI mode\n");
+
+	ret = lt96xx_set_output_format(common, conn_state);
+	if (ret)
+		dev_err(dev, "failed to set output data format\n");
+
+	ret = lt96xx_hdmi_enable(common, true);
+	if (ret)
+		dev_err(dev, "failed to enable HDMI output\n");
+}
+
+static void lt9611c_bridge_atomic_disable(struct drm_bridge *bridge,
+					  struct drm_atomic_state *state)
+{
+	struct lt96xx_common *common = bridge_to_lt96xx(bridge);
+	struct device *dev = common->dev;
+	int ret;
+
+	ret = lt96xx_hdmi_enable(common, false);
+	if (ret)
+		dev_err(dev, "failed to disable HDMI output\n");
+}
+
+static const struct drm_bridge_funcs lt9611c_bridge_funcs = {
+	.get_modes = lt96xx_bridge_get_modes,
+	.attach = lt96xx_bridge_attach,
+	.detect = lt96xx_bridge_detect,
+	.edid_read = lt96xx_bridge_edid_read,
+	.atomic_enable = lt9611c_bridge_atomic_enable,
+	.atomic_disable = lt9611c_bridge_atomic_disable,
+	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+	.atomic_reset = drm_atomic_helper_bridge_reset,
+
+	.hdmi_tmds_char_rate_valid = lt96xx_hdmi_tmds_char_rate_valid,
+	.hdmi_write_infoframe = lt96xx_hdmi_write_infoframe,
+	.hdmi_clear_infoframe = lt96xx_hdmi_clear_infoframe,
+
+	.hdmi_audio_prepare = lt96xx_hdmi_audio_prepare,
+	.hdmi_audio_shutdown = lt96xx_hdmi_audio_shutdown,
+};
+
+static int lt9611c_parse_dt(struct device *dev, struct lt9611c *lt9611c)
+{
+	u8 codes[LT9611C_MAX_MIPI_PORTS];
+	struct device_node *dsi_node;
+	struct mipi_dsi_host *host;
+	unsigned int i, num_ports = 0;
+
+	lt9611c->lanes = 4;
+
+	for (i = 0; i < lt9611c->cdata->max_ports; i++) {
+		struct device_node *ep;
+
+		/* Only need local endpoint presence here; attach_dsi() resolves the
+		 * remote node later, once it actually needs the dsi host. */
+		ep = of_graph_get_endpoint_by_regs(dev->of_node, i, -1);
+		if (!ep)
+			continue;
+
+		if (!num_ports) {
+			/*
+			 * The hardware autodetects the number of active DSI lanes and does
+			 * not require a specific lane count command, but the Linux DRM DSI
+			 * host framework requires dsi->lanes to configure host PHY/clocks.
+			 * Default to 4 lanes unless overridden by device tree.
+			 */
+			int lanes = drm_of_get_data_lanes_count(ep, 1, 4);
+
+			if (lanes > 0)
+				lt9611c->lanes = lanes;
+		}
+
+		of_node_put(ep);
+
+		dsi_node = of_graph_get_remote_node(dev->of_node, i, -1);
+		if (!dsi_node)
+			return dev_err_probe(dev, -ENODEV,
+					    "missing remote dsi node for port %u\n", i);
+
+		host = of_find_mipi_dsi_host_by_node(dsi_node);
+		of_node_put(dsi_node);
+		if (!host)
+			return dev_err_probe(dev, -EPROBE_DEFER,
+					    "failed to find dsi host for port %u\n", i);
+
+		lt9611c->dsi_hosts[num_ports] = host;
+		codes[num_ports] = lt96xx_port_map[i];
+		num_ports++;
+	}
+
+	if (!num_ports)
+		return dev_err_probe(dev, -ENODEV, "failed to get remote node for primary dsi\n");
+
+	lt9611c->num_ports = num_ports;
+	lt9611c->port_swap = lt96xx_pack_port_swap(codes, num_ports);
+
+	return lt96xx_probe_output_bridge(&lt9611c->common, dev->of_node,
+					 LT9611C_MAX_MIPI_PORTS);
+}
+
+static int lt9611c_probe(struct i2c_client *client)
+{
+	struct lt9611c *lt9611c;
+	struct lt96xx_common *common;
+	struct device *dev = &client->dev;
+	int ret;
+
+	lt9611c = devm_drm_bridge_alloc(dev, struct lt9611c, common.bridge,
+					&lt9611c_bridge_funcs);
+	if (IS_ERR(lt9611c))
+		return dev_err_probe(dev, PTR_ERR(lt9611c), "drm bridge alloc failed.\n");
+
+	lt9611c->cdata = i2c_get_match_data(client);
+	if (!lt9611c->cdata)
+		return dev_err_probe(dev, -EINVAL, "no match data for device\n");
+
+	common = &lt9611c->common;
+	common->dev = dev;
+	common->client = client;
+	common->fw_file = LT9611C_FW_FILE;
+	common->max_tmds_rate = lt9611c->cdata->max_tmds_rate;
+	common->bridge.product = lt9611c->cdata->product;
+
+	ret = lt9611c_parse_dt(dev, lt9611c);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse device tree\n");
+
+	ret = lt96xx_probe_common(common);
+	if (ret)
+		return ret;
+
+	/* A dual-port LT9611C uses one DSI device; port 1 is the slave link. */
+	ret = lt9611c_attach_dsi(lt9611c);
+	if (ret) {
+		lt96xx_remove_common(client);
+		return ret;
+	}
+
+	dev_info(dev, "initialized successfully with fw version 0x%04x\n",
+		 common->fw_version);
+
+	return 0;
+}
+
+static const struct i2c_device_id lt9611c_id[] = {
+	{
+		"lontium,lt9611c",
+		(kernel_ulong_t)&lt9611c_chip_data[CHIP_LT9611C]
+	},
+	{
+		"lontium,lt9611ex",
+		(kernel_ulong_t)&lt9611c_chip_data[CHIP_LT9611EX]
+	},
+	{
+		"lontium,lt9611uxd",
+		(kernel_ulong_t)&lt9611c_chip_data[CHIP_LT9611UXD]
+	},
+	{ /* sentinel */ }
+};
+
+static const struct of_device_id lt9611c_match_table[] = {
+	{
+		.compatible = "lontium,lt9611c",
+		.data = &lt9611c_chip_data[CHIP_LT9611C]
+	},
+	{
+		.compatible = "lontium,lt9611ex",
+		.data = &lt9611c_chip_data[CHIP_LT9611EX]
+	},
+	{
+		.compatible = "lontium,lt9611uxd",
+		.data = &lt9611c_chip_data[CHIP_LT9611UXD]
+	},
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lt9611c_match_table);
+
+static struct i2c_driver lt9611c_driver = {
+	.driver = {
+		.name = "lt9611c",
+		.of_match_table = lt9611c_match_table,
+		.pm = &lt96xx_bridge_pm_ops,
+		.dev_groups = lt96xx_attr_groups,
+	},
+	.probe = lt9611c_probe,
+	.remove = lt96xx_remove_common,
+	.id_table = lt9611c_id,
+};
+module_i2c_driver(lt9611c_driver);
+
+MODULE_FIRMWARE(LT9611C_FW_FILE);
+MODULE_AUTHOR("SunYun Yang <syyang@lontium.com>");
+MODULE_AUTHOR("Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>");
+MODULE_DESCRIPTION("Lontium LT9611C(EX/UXD) MIPI DSI to HDMI bridge");
+MODULE_LICENSE("GPL");
diff --git a/drivers/gpu/drm/bridge/lontium-lt96xx.c b/drivers/gpu/drm/bridge/lontium-lt96xx.c
new file mode 100644
index 0000000..75fb74f
--- /dev/null
+++ b/drivers/gpu/drm/bridge/lontium-lt96xx.c
@@ -0,0 +1,1376 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2026 Lontium Semiconductor, Inc.
+ * Copyright (C) 2026 Ezurio, LLC.
+ *
+ * Shared MCU-mailbox protocol/infrastructure for the Lontium LT9611C
+ * and LT2611UXD bridge chip families. See lontium-lt96xx.h.
+ */
+
+#include <linux/crc8.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/iopoll.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_bridge_connector.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_of.h>
+#include <drm/display/drm_hdmi_state_helper.h>
+#include <sound/hdmi-codec.h>
+
+#include "lontium-lt96xx.h"
+
+#define LT96XX_HDMI_AUDIO_MIN_RATE 32000
+#define LT96XX_HDMI_AUDIO_MAX_RATE 192000
+
+int lt96xx_read_write_flow(struct lt96xx_common *common,
+				   const struct lt96xx_cmd *cmd,
+				   struct lt96xx_rsp *rsp)
+{
+	int ret;
+	unsigned int i;
+	unsigned int temp;
+	unsigned int max_params = 0xe0dd - 0xe0b0 + 1;
+
+	guard(mutex)(&common->mcu_lock);
+
+	ret = regmap_write(common->regmap, 0xe0de, 0x01);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(common->regmap, 0xe0ae, temp,
+				       temp == 0x01, 1000, 100 * 1000);
+	if (ret)
+		return -ETIMEDOUT;
+
+	ret = regmap_bulk_write(common->regmap, 0xe0b0, &cmd->hdr,
+				LT96XX_CMD_HDR_SIZE);
+	if (ret)
+		return ret;
+
+	for (i = 0; cmd->data && i < cmd->data_len &&
+		    (LT96XX_CMD_HDR_SIZE + i) < max_params;
+	     i++) {
+		ret = regmap_write(common->regmap,
+				   0xe0b0 + LT96XX_CMD_HDR_SIZE + i, cmd->data[i]);
+		if (ret)
+			return ret;
+	}
+
+	ret = regmap_write(common->regmap, 0xe0de, 0x02);
+	if (ret)
+		return ret;
+
+	ret = regmap_read_poll_timeout(common->regmap, 0xe0ae, temp,
+				       temp == 0x02, 1000, 100 * 1000);
+	if (ret)
+		return -ETIMEDOUT;
+
+	ret = regmap_bulk_read(common->regmap, 0xe085, &rsp->hdr,
+			       LT96XX_CMD_HDR_SIZE);
+	if (ret)
+		return ret;
+
+	if (cmd->hdr.func != rsp->hdr.func ||
+	    cmd->hdr.type != rsp->hdr.type ||
+	    cmd->hdr.seq != rsp->hdr.seq ||
+	    cmd->hdr.sep != rsp->hdr.sep)
+		dev_dbg(common->dev,
+			"command response header mismatch: sent %02x %02x %02x %02x, "
+			"received %02x %02x %02x %02x\n",
+			cmd->hdr.func, cmd->hdr.type, cmd->hdr.seq, cmd->hdr.sep,
+			rsp->hdr.func, rsp->hdr.type, rsp->hdr.seq, rsp->hdr.sep);
+
+	if (rsp->data && rsp->data_len)
+		ret = regmap_bulk_read(common->regmap,
+				       0xe085 + LT96XX_CMD_HDR_SIZE,
+				       rsp->data, rsp->data_len);
+
+	return ret;
+}
+
+static const struct regmap_range_cfg lt96xx_ranges[] = {
+	{
+		.name = "register_range",
+		.range_min = 0,
+		.range_max = 0xfe9c,
+		.selector_reg = LT96XX_PAGE_CONTROL,
+		.selector_mask = 0xff,
+		.selector_shift = 0,
+		.window_start = 0,
+		.window_len = 0x100,
+	},
+};
+
+const struct regmap_config lt96xx_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xfe9c,
+	.ranges = lt96xx_ranges,
+	.num_ranges = ARRAY_SIZE(lt96xx_ranges),
+};
+
+DECLARE_CRC8_TABLE(lt96xx_crc8_table);
+
+static void lt96xx_config_parameters(struct lt96xx_common *common)
+{
+	/* This sequence switches i2c to bootloader, among other things */
+	const struct reg_sequence seq_write_paras[] = {
+		REG_SEQ0(0xe0ee, 0x01), REG_SEQ0(0xe103, 0x3f), /* fifo rst */
+		REG_SEQ0(0xe103, 0xff), REG_SEQ0(0xe05e, 0xc1),
+		REG_SEQ0(0xe058, 0x00), REG_SEQ0(0xe059, 0x50),
+		REG_SEQ0(0xe05a, 0x10), REG_SEQ0(0xe05a, 0x00),
+		REG_SEQ0(0xe058, 0x21),
+	};
+
+	regmap_multi_reg_write(common->regmap, seq_write_paras,
+			       ARRAY_SIZE(seq_write_paras));
+}
+
+static void lt96xx_wren(struct lt96xx_common *common)
+{
+	regmap_write(common->regmap, 0xe05a, 0x04);
+	regmap_write(common->regmap, 0xe05a, 0x00);
+}
+
+static void lt96xx_wrdi(struct lt96xx_common *common)
+{
+	regmap_write(common->regmap, 0xe05a, 0x08);
+	regmap_write(common->regmap, 0xe05a, 0x00);
+}
+
+static void lt96xx_erase_op(struct lt96xx_common *common, u32 addr)
+{
+	const struct reg_sequence seq_write[] = {
+		REG_SEQ0(0xe0ee, 0x01),
+		REG_SEQ0(0xe05a, 0x04),
+		REG_SEQ0(0xe05a, 0x00),
+		REG_SEQ0(0xe05b, (addr >> 16) & 0xff),
+		REG_SEQ0(0xe05c, (addr >> 8) & 0xff),
+		REG_SEQ0(0xe05d, addr & 0xff),
+		REG_SEQ0(0xe05a, 0x01),
+		REG_SEQ0(0xe05a, 0x00),
+	};
+
+	regmap_multi_reg_write(common->regmap, seq_write,
+			       ARRAY_SIZE(seq_write));
+}
+
+static unsigned int read_flash_reg_status(struct lt96xx_common *common)
+{
+	const struct reg_sequence seq_write[] = {
+		REG_SEQ0(0xe103, 0x3f), REG_SEQ0(0xe103, 0xff),
+		REG_SEQ0(0xe05e, 0x40), REG_SEQ0(0xe056, 0x05),
+		REG_SEQ0(0xe055, 0x25), REG_SEQ0(0xe055, 0x01),
+		REG_SEQ0(0xe058, 0x21),
+	};
+	unsigned int status;
+	int ret;
+
+	regmap_multi_reg_write(common->regmap, seq_write,
+			       ARRAY_SIZE(seq_write));
+	ret = regmap_read(common->regmap, 0xe05f, &status);
+	if (ret)
+		return 0xff;
+
+	return status;
+}
+
+static void lt96xx_crc_to_sram(struct lt96xx_common *common)
+{
+	const struct reg_sequence seq_write[] = {
+		REG_SEQ0(0xe051, 0x00), REG_SEQ0(0xe055, 0xc0),
+		REG_SEQ0(0xe055, 0x80), REG_SEQ0(0xe05e, 0xc0),
+		REG_SEQ0(0xe058, 0x21),
+	};
+
+	regmap_multi_reg_write(common->regmap, seq_write,
+			       ARRAY_SIZE(seq_write));
+}
+
+static void lt96xx_data_to_sram(struct lt96xx_common *common)
+{
+	const struct reg_sequence seq_write[] = {
+		REG_SEQ0(0xe051, 0xff),
+		REG_SEQ0(0xe055, 0x80),
+		REG_SEQ0(0xe05e, 0xc0),
+		REG_SEQ0(0xe058, 0x21),
+	};
+
+	regmap_multi_reg_write(common->regmap, seq_write,
+			       ARRAY_SIZE(seq_write));
+}
+
+static void lt96xx_sram_to_flash(struct lt96xx_common *common, size_t addr)
+{
+	const struct reg_sequence seq_write[] = {
+		REG_SEQ0(0xe05b, (addr >> 16) & 0xff),
+		REG_SEQ0(0xe05c, (addr >> 8) & 0xff),
+		REG_SEQ0(0xe05d, addr & 0xff),
+		REG_SEQ0(0xe05a, 0x30),
+		REG_SEQ0(0xe05a, 0x00),
+	};
+
+	regmap_multi_reg_write(common->regmap, seq_write,
+			       ARRAY_SIZE(seq_write));
+}
+
+static int lt96xx_block_erase(struct lt96xx_common *common)
+{
+	struct device *dev = common->dev;
+	unsigned int block_num;
+	unsigned int flash_status = 0;
+	u32 flash_addr = 0;
+	int ret;
+
+	for (block_num = 0; block_num < 2; block_num++) {
+		flash_addr = block_num * 0x008000;
+		lt96xx_erase_op(common, flash_addr);
+		msleep(100);
+		ret = read_poll_timeout(read_flash_reg_status, flash_status,
+					!(flash_status & 0x01),
+					50 * USEC_PER_MSEC,
+					2500 * USEC_PER_MSEC, false, common);
+		if (ret) {
+			dev_err(dev, "flash erase timeout for block %u\n",
+				block_num);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int lt96xx_write_data(struct lt96xx_common *common,
+			     const struct firmware *fw, size_t addr)
+{
+	struct device *dev = common->dev;
+	int ret;
+	unsigned int page = 0, num = 0, i = 0;
+	size_t size, index;
+	const u8 *data;
+	u8 value;
+
+	data = fw->data;
+	size = fw->size;
+	page = DIV_ROUND_UP(size, LT96XX_PAGE_SIZE);
+	if (page * LT96XX_PAGE_SIZE > LT96XX_FW_SIZE) {
+		dev_err(dev, "firmware size out of range\n");
+		return -EINVAL;
+	}
+
+	dev_dbg(dev, "%u pages, total size %zu byte\n", page, size);
+
+	for (num = 0; num < page; num++) {
+		lt96xx_data_to_sram(common);
+
+		for (i = 0; i < LT96XX_PAGE_SIZE; i++) {
+			index = num * LT96XX_PAGE_SIZE + i;
+			value = (index < size) ? data[index] : 0xff;
+
+			ret = regmap_write(common->regmap, 0xe059, value);
+			if (ret < 0) {
+				dev_err(dev,
+					"write error at page %u, index %u\n",
+					num, i);
+				return ret;
+			}
+		}
+
+		lt96xx_wren(common);
+		lt96xx_sram_to_flash(common, addr);
+
+		addr += LT96XX_PAGE_SIZE;
+	}
+
+	lt96xx_wrdi(common);
+
+	return 0;
+}
+
+static int lt96xx_write_crc(struct lt96xx_common *common, u8 fw_crc,
+			    size_t addr)
+{
+	struct device *dev = common->dev;
+	int ret;
+
+	lt96xx_crc_to_sram(common);
+	ret = regmap_write(common->regmap, 0xe059, fw_crc);
+	if (ret < 0) {
+		dev_err(dev, "failed to write crc\n");
+		return ret;
+	}
+
+	lt96xx_wren(common);
+	lt96xx_sram_to_flash(common, addr);
+	lt96xx_wrdi(common);
+
+	dev_dbg(dev, "crc 0x%02x written to flash at addr 0x%zx\n", fw_crc,
+		addr);
+
+	return 0;
+}
+
+void lt96xx_reset(struct lt96xx_common *common)
+{
+	gpiod_set_value_cansleep(common->reset_gpio, 1);
+	usleep_range(10000, 12000);
+
+	gpiod_set_value_cansleep(common->reset_gpio, 0);
+	msleep(400);
+}
+
+static int lt96xx_upgrade_result(struct lt96xx_common *common, u8 fw_crc)
+{
+	struct device *dev = common->dev;
+	unsigned int crc_result;
+	int ret;
+
+	/* Switch i2c to bootloader mode */
+	regmap_write(common->regmap, 0xe0ee, 0x01);
+
+	/* Read firmware CRC result from the device */
+	ret = regmap_read(common->regmap, 0xe021, &crc_result);
+
+	/* Switch i2c back to normal mode */
+	regmap_write(common->regmap, 0xe0ee, 0x00);
+
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read firmware crc\n");
+
+	if (crc_result != fw_crc) {
+		dev_err(dev,
+			"fw upgrade failed, expected crc=0x%02x, read crc=0x%02x\n",
+			fw_crc, crc_result);
+		return -EIO;
+	}
+
+	dev_info(dev, "firmware upgrade success, crc=0x%02x\n", crc_result);
+	return 0;
+}
+
+static int lt96xx_firmware_upgrade_fw(struct lt96xx_common *common,
+					      const struct firmware *fw)
+{
+	struct device *dev = common->dev;
+	u8 *buffer;
+	size_t total_size = LT96XX_FW_SIZE - 1;
+	u8 fw_crc;
+	int ret;
+
+	crc8_populate_msb(lt96xx_crc8_table, LT96XX_CRC_POLYNOMIAL);
+
+	if (fw->size > total_size) {
+		dev_err(dev, "firmware too large (%zu > %zu)\n", fw->size,
+			total_size);
+		return -EINVAL;
+	}
+	dev_dbg(dev, "firmware size: %zu bytes\n", fw->size);
+
+	buffer = kmalloc(total_size, GFP_KERNEL);
+	if (!buffer)
+		return -ENOMEM;
+
+	memcpy(buffer, fw->data, fw->size);
+	memset(buffer + fw->size, 0xff, total_size - fw->size);
+
+	fw_crc = crc8(lt96xx_crc8_table, buffer, total_size, 0);
+	kfree(buffer);
+
+	dev_info(dev,
+		 "starting firmware upgrade, size: %zu bytes, crc: 0x%02x\n",
+		 fw->size, fw_crc);
+
+	/* No HPD processing while the flash sequence below is in progress */
+	disable_irq(common->client->irq);
+	cancel_work_sync(&common->work);
+
+	/* hardware access requires mcu_lock */
+	guard(mutex)(&common->mcu_lock);
+
+	/* This switches i2c to bootloader mode */
+	lt96xx_config_parameters(common);
+
+	ret = lt96xx_block_erase(common);
+	if (ret < 0)
+		goto out;
+
+	ret = lt96xx_write_data(common, fw, 0);
+	if (ret < 0) {
+		dev_err(dev, "failed to write firmware data\n");
+		goto out;
+	}
+
+	ret = lt96xx_write_crc(common, fw_crc, LT96XX_FW_SIZE - 1);
+	if (ret < 0)
+		dev_err(dev, "failed to write firmware crc\n");
+
+out:
+	/* Finish the firmware upgrade sequence by holding reset, 
+	 * re-enabling the HPD interrupt, and then releasing reset.
+	 */
+	gpiod_set_value_cansleep(common->reset_gpio, 1);
+	msleep(1);
+	enable_irq(common->client->irq);
+	/* This implicitly switches i2c back to normal mode */
+	lt96xx_reset(common);
+
+	return ret < 0 ? ret : lt96xx_upgrade_result(common, fw_crc);
+}
+
+int lt96xx_read_chipid(struct lt96xx_common *common)
+{
+	struct device *dev = common->dev;
+	u8 chipid[2];
+	int ret;
+
+	guard(mutex)(&common->mcu_lock);
+
+	/* Switch i2c to bootloader */
+	ret = regmap_write(common->regmap, 0xe0ee, 0x01);
+	if (ret)
+		return ret;
+
+	/* Read chip ID from bootloader */
+	ret = regmap_bulk_read(common->regmap, 0xe100, chipid, 2);
+
+	/* Switch i2c back to normal mode, regardless of the read result */
+	regmap_write(common->regmap, 0xe0ee, 0x00);
+
+	if (ret)
+		return ret;
+
+	if (chipid[0] != 0x23 || chipid[1] != 0x06) {
+		dev_err(dev, "ChipID: 0x%02x 0x%02x\n", chipid[0], chipid[1]);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+int lt96xx_read_fw_version(struct lt96xx_common *common)
+{
+	static const u8 ver_data[] = { 0x00 };
+	static const struct lt96xx_cmd cmd = {
+		.hdr = { LT96XX_FUNC_READ, LT96XX_TYPE_CUSTOM,
+			 LT96XX_CUSTOM_SEQ_FW_VERSION, LT96XX_CMD_SEP },
+		.data = ver_data,
+		.data_len = 1,
+	};
+	u8 version[2];
+	struct lt96xx_rsp rsp = { .data = version,
+				  .data_len = ARRAY_SIZE(version) };
+	int ret;
+
+	ret = lt96xx_read_write_flow(common, &cmd, &rsp);
+	if (ret)
+		return ret;
+
+	return (version[0] << 8) | version[1];
+}
+

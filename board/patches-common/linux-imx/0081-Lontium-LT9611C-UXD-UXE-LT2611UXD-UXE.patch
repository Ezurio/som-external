diff --git a/Documentation/devicetree/bindings/display/bridge/lontium,lt2611uxd.yaml b/Documentation/devicetree/bindings/display/bridge/lontium,lt2611uxd.yaml
new file mode 100644
index 0000000..a359fc1
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/bridge/lontium,lt2611uxd.yaml
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/bridge/lontium,lt2611uxd.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Lontium LT2611UXD/UXE LVDS to HDMI Bridge
+
+maintainers:
+  - Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
+
+description: |
+  The LT2611UXD and LT2611UXE are bridge devices which convert LVDS to
+  HDMI 2.0. LT2611UXD supports up to two LVDS input ports, LT2611UXE
+  supports up to four LVDS input ports.
+
+properties:
+  compatible:
+    enum:
+      - lontium,lt2611uxd
+      - lontium,lt2611uxe
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  data-mapping:
+    enum:
+      - jeida-18
+      - jeida-24
+      - jeida-30
+      - vesa-24
+      - vesa-30
+    description: LVDS input color signals mapping order.
+
+  reset-gpios:
+    maxItems: 1
+    description: GPIO connected to active high RESET pin.
+
+  vdd-supply:
+    description: Regulator for 1.8V core power.
+
+  vcc-supply:
+    description: Regulator for 3.3V IO power.
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/$defs/port-base
+        unevaluatedProperties: false
+        description:
+          Primary LVDS port for LVDS input
+
+        properties:
+          endpoint:
+            $ref: /schemas/media/video-interfaces.yaml#
+            unevaluatedProperties: false
+
+      port@4:
+        $ref: /schemas/graph.yaml#/properties/port
+        description:
+          HDMI port for HDMI output
+
+    patternProperties:
+      "^port@[1-3]$":
+        $ref: /schemas/graph.yaml#/properties/port
+        description:
+          Additional LVDS port, used in combination with the other
+          LVDS ports to drive higher resolution displays. port@1 is
+          available on both LT2611UXD and LT2611UXE, port@2 and
+          port@3 are LT2611UXE only.
+
+    required:
+      - port@0
+      - port@4
+
+  panel-timing: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+  - vdd-supply
+  - vcc-supply
+  - ports
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: lontium,lt2611uxe
+    then:
+      properties:
+        ports:
+          properties:
+            port@2: false
+            port@3: false
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        hdmi-bridge@2b {
+            compatible = "lontium,lt2611uxd";
+            reg = <0x2b>;
+
+            interrupt-parent = <&gpio1>;
+            interrupts = <11 IRQ_TYPE_EDGE_FALLING>;
+
+            reset-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
+
+            vdd-supply = <&vdd_1v8>;
+            vcc-supply = <&vcc_3v3>;
+            data-mapping = "vesa-24";
+
+            ports {
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                port@0 {
+                    reg = <0>;
+                    endpoint {
+                        remote-endpoint = <&lvds_out>;
+                    };
+                };
+
+                port@4 {
+                    reg = <4>;
+                    endpoint {
+                        remote-endpoint = <&hdmi_connector_in>;
+                    };
+                };
+            };
+        };

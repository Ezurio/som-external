+const struct attribute_group *lt96xx_attr_groups[] = {
+	&lt96xx_attr_group,
+	NULL,
+};
diff --git a/drivers/gpu/drm/bridge/lontium-lt96xx.h b/drivers/gpu/drm/bridge/lontium-lt96xx.h
new file mode 100644
index 0000000..75fb74f
--- /dev/null
+++ b/drivers/gpu/drm/bridge/lontium-lt96xx.h
@@ -0,0 +1,213 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2026 Lontium Semiconductor, Inc.
+ * Copyright (C) 2026 Ezurio, LLC.
+ *
+ * Shared MCU-mailbox protocol/infrastructure for the Lontium LT9611C
+ * (MIPI DSI to HDMI) and LT2611UXD (LVDS to HDMI) bridge chip families.
+ * Both families share the same I2C register-mailbox handshake at
+ * 0xe0b0-0xe0dd/0xe085-0xe0ac and the same SRAM firmware-upgrade flow;
+ * the video input side (MIPI DSI vs LVDS) and its associated timing/
+ * enable commands differ and stay in the two separate driver files.
+ */
+
+#ifndef __LONTIUM_LT96XX_H__
+#define __LONTIUM_LT96XX_H__
+
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/hdmi.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_modes.h>
+#include <sound/hdmi-codec.h>
+
+struct drm_connector;
+struct drm_connector_state;
+struct drm_display_mode;
+struct drm_edid;
+struct gpio_desc;
+
+#define LT96XX_FW_SIZE (64 * 1024)
+#define LT96XX_PAGE_SIZE 256
+#define LT96XX_CRC_POLYNOMIAL 0x31
+#define LT96XX_PAGE_CONTROL 0xff
+#define LT96XX_CMD_HDR_SIZE 4
+#define LT96XX_CMD_Y0_SIZE 1 /* Y0 echo byte in ACK response */
+#define LT96XX_EDID_BUF_SIZE 32
+#define LT96XX_INFOFRAME_MAX_SIZE 32
+
+struct lt96xx_cmd_hdr {
+	u8 func;
+	u8 type;
+	u8 seq;
+	u8 sep;
+};
+
+/* lt96xx_cmd_hdr.func values */
+#define LT96XX_FUNC_WRITE 0x57 /* 'W' */
+#define LT96XX_FUNC_READ 0x52 /* 'R' */
+
+/* lt96xx_cmd_hdr.type values */
+#define LT96XX_TYPE_HDMI 0x48 /* 'H' */
+
+/* lt96xx_cmd_hdr.sep is always ':' */
+#define LT96XX_CMD_SEP 0x3a /* ':' */
+
+/* HDMI Read command sequence numbers */
+#define LT96XX_HDMI_SEQ_HPD 0x31
+#define LT96XX_HDMI_SEQ_EDID_SIZE 0x32
+#define LT96XX_HDMI_SEQ_EDID 0x33
+
+/* HDMI Write command sequence numbers */
+#define LT96XX_HDMI_SEQ_ENABLE 0x31
+#define LT96XX_HDMI_SEQ_CONN_MODE 0x32
+#define LT96XX_HDMI_SEQ_OUTPUT_FORMAT 0x33
+#define LT96XX_HDMI_SEQ_INFOFRAME 0x35
+#define LT96XX_HDMI_SEQ_AUDIO 0x36
+#define LT96XX_HDMI_SEQ_AUDIO_WIDTH 0x42
+
+/* MIPI/LVDS Ports Select command (seq 0x31): Y0=port count, Y1=port-swap byte;
+ * only the command type byte (M vs L) differs between chip families. */
+#define LT96XX_SEQ_SELECT_PORTS 0x31
+/* Physical-DT-graph-port-index to port-identity-code table, shared by both
+ * chip families' port discovery loops (index 0 = PhyPortB, 1 = PhyPortA). */
+extern const u8 lt96xx_port_map[4];
+
+/* Custom-type command, identical on both chip families */
+#define LT96XX_TYPE_CUSTOM 0x43 /* 'C' */
+#define LT96XX_CUSTOM_SEQ_FW_VERSION 0x31
+#define LT96XX_CUSTOM_SEQ_POWER_MODE 0x33
+#define LT96XX_POWER_MODE_STANDBY 0x01
+#define LT96XX_POWER_MODE_SLEEP 0x02
+
+struct lt96xx_cmd {
+	struct lt96xx_cmd_hdr hdr;
+	const u8 *data;
+	size_t data_len;
+};
+
+struct lt96xx_rsp {
+	struct lt96xx_cmd_hdr hdr;
+	u8 *data;
+	unsigned int data_len;
+};
+
+/*
+ * Embedded as the first member of each driver's own bridge struct, so
+ * shared callbacks can recover it from &bridge via container_of()
+ * regardless of which concrete driver struct wraps it.
+ */
+struct lt96xx_common {
+	struct device *dev;
+	struct i2c_client *client;
+	struct drm_bridge bridge;
+	struct drm_bridge *next_bridge;
+	struct regmap *regmap;
+	/* Protects command flow to the MCU and IRQ work coordination. */
+	struct mutex mcu_lock;
+	struct work_struct work;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[2];
+	const char *fw_file;
+	int fw_version;
+	unsigned long long max_tmds_rate;
+	u32 bus_format;
+	struct drm_display_mode timing_mode;
+	enum drm_connector_status hdmi_connected;
+	const struct drm_edid *cached_edid;
+	u32 timing_bus_flags;
+	bool timing_valid;
+};
+
+struct __packed lt96xx_video_timing {
+	__be16 h_total;
+	__be16 hactive;
+	__be16 hsync_len;
+	__be16 hfront_porch;
+	__be16 hback_porch;
+	__be16 v_total;
+	__be16 vactive;
+	__be16 vsync_len;
+	__be16 vfront_porch;
+	__be16 vback_porch;
+	u8 framerate;
+	u8 vic;
+};
+
+#define LT96XX_VIDEO_TIMING_LEN sizeof(struct lt96xx_video_timing)
+
+int lt96xx_read_write_flow(struct lt96xx_common *common,
+			   const struct lt96xx_cmd *cmd,
+			   struct lt96xx_rsp *rsp);
+
+void lt96xx_reset(struct lt96xx_common *common);
+int lt96xx_read_chipid(struct lt96xx_common *common);
+int lt96xx_read_fw_version(struct lt96xx_common *common);
+
+/* Documented identically for both chip families (HDMI 0x31/0x32/0x33, Custom 0x33). */
+int lt96xx_hdmi_enable(struct lt96xx_common *common, bool enable);
+int lt96xx_set_hdmi_mode(struct lt96xx_common *common, bool is_hdmi);
+int lt96xx_set_output_format(struct lt96xx_common *common,
+			      const struct drm_connector_state *state);
+int lt96xx_set_power_mode(struct lt96xx_common *common, u8 mode);
+int lt96xx_select_ports(struct lt96xx_common *common, u8 type, u8 num_ports,
+			u8 port_swap);
+int lt96xx_probe_output_bridge(struct lt96xx_common *common,
+			       struct device_node *of_node,
+			       unsigned int output_port);
+/* Packs up to 4 per-logical-slot physical-port identity codes (2 bits each,
+ * discovery order) into the Ports Select command's Y1 port-swap byte. */
+u8 lt96xx_pack_port_swap(const u8 *codes, unsigned int count);
+
+int lt96xx_probe_common(struct lt96xx_common *common);
+void lt96xx_remove_common(struct i2c_client *client);
+
+struct lt96xx_common *bridge_to_lt96xx(struct drm_bridge *bridge);
+const struct lt96xx_common *
+bridge_to_lt96xx_const(const struct drm_bridge *bridge);
+
+irqreturn_t lt96xx_irq_thread_handler(int irq, void *dev_id);
+void lt96xx_hpd_work(struct work_struct *work);
+
+int lt96xx_bridge_attach(struct drm_bridge *bridge,
+			 struct drm_encoder *encoder,
+			 enum drm_bridge_attach_flags flags);
+int lt96xx_bridge_get_modes(struct drm_bridge *bridge,
+				 struct drm_connector *connector);
+enum drm_mode_status
+lt96xx_hdmi_tmds_char_rate_valid(const struct drm_bridge *bridge,
+				 const struct drm_display_mode *mode,
+				 unsigned long long tmds_rate);
+enum drm_connector_status
+lt96xx_bridge_detect(struct drm_bridge *bridge,
+		     struct drm_connector *connector);
+const struct drm_edid *lt96xx_bridge_edid_read(struct drm_bridge *bridge,
+					       struct drm_connector *connector);
+
+int lt96xx_write_infoframe(struct lt96xx_common *common, u8 reg_type,
+			   const u8 *buffer, size_t len);
+int lt96xx_hdmi_write_infoframe(struct drm_bridge *bridge,
+				 enum hdmi_infoframe_type type,
+				 const u8 *buffer, size_t len);
+int lt96xx_hdmi_clear_infoframe(struct drm_bridge *bridge,
+				 enum hdmi_infoframe_type type);
+int lt96xx_hdmi_audio_prepare(struct drm_bridge *bridge,
+			     struct drm_connector *connector,
+			     struct hdmi_codec_daifmt *fmt,
+			     struct hdmi_codec_params *hparms);
+void lt96xx_hdmi_audio_shutdown(struct drm_bridge *bridge,
+			       struct drm_connector *connector);
+
+void lt96xx_setup_video_timing(struct device *dev,
+				 const struct drm_display_mode *mode,
+				 u8 *buf);
+extern const struct dev_pm_ops lt96xx_bridge_pm_ops;
+
+extern const struct attribute_group *lt96xx_attr_groups[];
+
+#endif /* __LONTIUM_LT96XX_H__ */

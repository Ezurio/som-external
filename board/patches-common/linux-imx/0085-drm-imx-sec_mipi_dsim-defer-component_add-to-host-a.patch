From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Date: Thu, 3 Sep 2026 12:00:00 +0000
Subject: [PATCH] drm/imx: sec_mipi_dsim: defer component_add to host attach

1. Separate DSI host registration from DRM component binding. Probe the
   sec-dsim core and register mipi_dsi_host during platform probe so that
   downstream DSI bridges can probe and attach to the DSI host.

2. Defer component_add() until a downstream DSI device (bridge or panel)
   attaches via host_attach callback. This ensures imx-drm-core does not
   bind before external downstream bridges (e.g. LT9611C / LT2611UXD / SN65DSI83)
   are available.

3. In sec_mipi_dsim_host_attach(), only treat an attaching device as a panel
   if of_drm_find_panel() succeeds. Bridges attaching via mipi_dsi_attach
   must not set dsim->panel, nor be rejected as unknown devices.

Signed-off-by: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
---
 drivers/gpu/drm/bridge/sec-dsim.c       | 89 +++++++++++++------------
 drivers/gpu/drm/imx/sec_mipi_dsim-imx.c | 56 +++++++++++-----
 include/drm/bridge/sec_mipi_dsim.h      | 10 ++-
 3 files changed, 94 insertions(+), 61 deletions(-)

diff -Naur a/drivers/gpu/drm/bridge/sec-dsim.c b/drivers/gpu/drm/bridge/sec-dsim.c
--- a/drivers/gpu/drm/bridge/sec-dsim.c	2026-09-03 13:04:27.730553481 -0400
+++ b/drivers/gpu/drm/bridge/sec-dsim.c	2026-09-03 13:05:16.171423858 -0400
@@ -471,22 +471,25 @@
 	}
 
 	if (!dsim->next) {
-		/* 'dsi' must be panel device */
-		panel = of_drm_find_panel(dsi->dev.of_node);
-
-		if (!panel) {
-			dev_err(dev, "refuse unknown dsi device attach\n");
-			WARN_ON(!panel);
-			return -ENODEV;
-		}
-
-		/* Don't support multiple panels */
-		if (dsim->panel && panel && dsim->panel != panel) {
-			dev_err(dev, "don't support multiple panels\n");
-			return -EBUSY;
-		}
-
-		dsim->panel = panel;
+		/* 'dsi' can be panel or bridge device */
+		if (dsi->dev.of_node) {
+			panel = of_drm_find_panel(dsi->dev.of_node);
+			if (!IS_ERR(panel)) {
+				/* Don't support multiple panels */
+				if (dsim->panel && dsim->panel != panel) {
+					dev_err(dev, "don't support multiple panels\n");
+					return -EBUSY;
+				}
+				dsim->panel = panel;
+			} else {
+				struct drm_bridge *bridge = of_drm_find_bridge(dsi->dev.of_node);
+
+				if (!bridge) {
+					dev_err(dev, "refuse unknown dsi device attach\n");
+					return -ENODEV;
+				}
+			}
+		}
 	}
 
 	/* TODO: DSIM 3 lanes has some display issue, so
@@ -501,6 +503,12 @@
 	dsim->format	 = dsi->format;
 	dsim->mode_flags = dsi->mode_flags;
 
+	if (dsim->pdata && dsim->pdata->host_attach) {
+		int ret = dsim->pdata->host_attach(dsim->pdata->priv_data, dsi);
+		if (ret)
+			return ret;
+	}
+
 	/* TODO: support later */
 #if 0
 	if (dsim->connector.dev)
@@ -514,9 +522,10 @@
 				     struct mipi_dsi_device *dsi)
 {
 	struct sec_mipi_dsim *dsim = to_sec_mipi_dsim(host);
+	const struct sec_mipi_dsim_plat_data *pdata = dsim->pdata;
 
-	if (WARN_ON(!dsim->next && !dsim->panel))
-		return -ENODEV;
+	if (pdata && pdata->host_detach)
+		pdata->host_detach(pdata->priv_data, dsi);
 
 	/* clear the saved dsi parameters */
 	dsim->lanes	 = 0;
@@ -1950,18 +1959,14 @@
 	.atomic_destroy_state   = drm_atomic_helper_connector_destroy_state,
 };
 
-int sec_mipi_dsim_bind(struct device *dev, struct device *master, void *data,
-		       struct drm_encoder *encoder, void __iomem *base,
-		       int irq, const struct sec_mipi_dsim_plat_data *pdata)
+int sec_mipi_dsim_probe(struct device *dev, void __iomem *base,
+			int irq, const struct sec_mipi_dsim_plat_data *pdata)
 {
 	int ret, version;
-	struct drm_device *drm_dev = data;
 	struct drm_bridge *bridge;
-	struct drm_connector *connector;
 	struct sec_mipi_dsim *dsim;
-	struct device_node *node = NULL;
 
-	dev_dbg(dev, "sec-dsim bridge bind begin\n");
+	dev_dbg(dev, "sec-dsim bridge probe begin\n");
 
 	dsim = devm_kzalloc(dev, sizeof(*dsim), GFP_KERNEL);
 	if (!dsim) {
@@ -1972,7 +1977,6 @@
 	dsim->dev = dev;
 	dsim->base = base;
 	dsim->pdata = pdata;
-	dsim->encoder = encoder;
 
 	dsim->dsi_host.ops = &sec_mipi_dsim_host_ops;
 	dsim->dsi_host.dev = dev;
@@ -2013,17 +2017,6 @@
 		return -ENOMEM;
 	}
 
-	/* mipi dsi host needs to be registered before bridge attach, since:
-	 * 1. Have Panel
-	 *    The 'mipi_dsi_host_register' will allocate a mipi_dsi_device
-	 *    if the dsi host node has a panel child node in DTB. And dsi
-	 *    host ->attach() will be called in panel's probe().
-	 *
-	 * 2. Have Bridge
-	 *    The dsi host ->attach() will be called through the below
-	 *    'drm_bridge_attach()' which will attach next bridge in a
-	 *    chain.
-	 */
 	ret = mipi_dsi_host_register(&dsim->dsi_host);
 	if (ret) {
 		dev_err(dev, "Unable to register mipi dsi host: %d\n", ret);
@@ -2033,6 +2026,39 @@
 	dsim->bridge = bridge;
 	bridge->driver_private = dsim;
 	bridge->of_node = dev->of_node;
+
+	dev_dbg(dev, "sec-dsim bridge probe end\n");
+
+	return 0;
+}
+EXPORT_SYMBOL(sec_mipi_dsim_probe);
+
+void sec_mipi_dsim_remove(struct device *dev)
+{
+	struct sec_mipi_dsim *dsim = dev_get_drvdata(dev);
+
+	if (dsim)
+		mipi_dsi_host_unregister(&dsim->dsi_host);
+}
+EXPORT_SYMBOL(sec_mipi_dsim_remove);
+
+int sec_mipi_dsim_bind(struct device *dev, struct device *master, void *data,
+		       struct drm_encoder *encoder)
+{
+	int ret;
+	struct drm_device *drm_dev = data;
+	struct drm_bridge *bridge;
+	struct drm_connector *connector;
+	struct sec_mipi_dsim *dsim = dev_get_drvdata(dev);
+	struct device_node *node = NULL;
+
+	dev_dbg(dev, "sec-dsim bridge bind begin\n");
+
+	if (!dsim)
+		return -ENODEV;
+
+	dsim->encoder = encoder;
+	bridge = dsim->bridge;
 	bridge->encoder = encoder;
 
 	/* attach sec dsim bridge and its next bridge if exists */
@@ -2058,7 +2084,7 @@
 			}
 		}
 
-		mipi_dsi_host_unregister(&dsim->dsi_host);
+		dsim->panel = NULL;
 		return ret;
 	}
 
@@ -2073,25 +2098,21 @@
 					 &sec_mipi_dsim_connector_funcs,
 					 DRM_MODE_CONNECTOR_DSI);
 		if (ret)
-			goto host_unregister;
+			return ret;
 
 		/* TODO */
 		connector->dpms = DRM_MODE_DPMS_OFF;
 
 		ret = drm_connector_attach_encoder(connector, encoder);
-		if (ret)
-			goto cleanup_connector;
+		if (ret) {
+			drm_connector_cleanup(connector);
+			return ret;
+		}
 	}
 
 	dev_dbg(dev, "sec-dsim bridge bind end\n");
 
 	return 0;
-
-cleanup_connector:
-	drm_connector_cleanup(connector);
-host_unregister:
-	mipi_dsi_host_unregister(&dsim->dsi_host);
-	return ret;
 }
 EXPORT_SYMBOL(sec_mipi_dsim_bind);
 
@@ -2099,10 +2120,8 @@
 {
 	struct sec_mipi_dsim *dsim = dev_get_drvdata(dev);
 
-	if (dsim->panel)
+	if (dsim && dsim->panel)
 		drm_connector_cleanup(&dsim->connector);
-
-	mipi_dsi_host_unregister(&dsim->dsi_host);
 }
 EXPORT_SYMBOL(sec_mipi_dsim_unbind);
 
diff -Naur a/drivers/gpu/drm/imx/sec_mipi_dsim-imx.c b/drivers/gpu/drm/imx/sec_mipi_dsim-imx.c
--- a/drivers/gpu/drm/imx/sec_mipi_dsim-imx.c	2026-09-03 13:04:27.731056567 -0400
+++ b/drivers/gpu/drm/imx/sec_mipi_dsim-imx.c	2026-09-03 13:05:49.833892298 -0400
@@ -49,6 +49,7 @@
 	struct clk *clk_apb;
 	struct clk *clk_pix;
 	struct drm_encoder encoder;
+	struct sec_mipi_dsim_plat_data pdata;
 
 	struct reset_control *soft_resetn;
 	struct reset_control *clk_enable;
@@ -371,23 +373,42 @@
 		reset_control_put(dsim->mipi_reset);
 }
 
+static const struct component_ops imx_sec_dsim_ops;
+
+static int imx_sec_dsim_host_attach(void *priv_data,
+				    struct mipi_dsi_device *dsi)
+{
+	struct imx_sec_dsim_device *dsim = priv_data;
+	int ret;
+
+	ret = component_add(dsim->dev, &imx_sec_dsim_ops);
+	if (ret) {
+		if (ret != -EPROBE_DEFER)
+			dev_err(dsim->dev, "failed to register component: %d\n", ret);
+	}
+
+	return ret;
+}
+
+static int imx_sec_dsim_host_detach(void *priv_data,
+				    struct mipi_dsi_device *dsi)
+{
+	struct imx_sec_dsim_device *dsim = priv_data;
+
+	component_del(dsim->dev, &imx_sec_dsim_ops);
+	return 0;
+}
+
 static int imx_sec_dsim_bind(struct device *dev, struct device *master,
 			     void *data)
 {
 	int ret;
 	struct drm_device *drm_dev = data;
 	struct device_node *np = dev->of_node;
-	const struct of_device_id *of_id = of_match_device(imx_sec_dsim_dt_ids,
-							   dev);
-	const struct sec_mipi_dsim_plat_data *pdata;
 	struct drm_encoder *encoder;
 
 	dev_dbg(dev, "%s: dsim bind begin\n", __func__);
 
-	if (!of_id)
-		return -ENODEV;
-	pdata = of_id->data;
-
 	encoder = &dsim_dev->encoder;
 	ret = imx_drm_encoder_parse_of(drm_dev, encoder, np);
 	if (ret)
@@ -400,8 +420,7 @@
 		return ret;
 
 	/* bind sec dsim bridge */
-	ret = sec_mipi_dsim_bind(dev, master, data, encoder,
-				 dsim_dev->base, dsim_dev->irq, pdata);
+	ret = sec_mipi_dsim_bind(dev, master, data, encoder);
 	if (ret) {
 		dev_err_probe(dev, ret, "failed to bind sec dsim bridge\n");
 		drm_encoder_cleanup(encoder);
@@ -444,9 +463,15 @@
 {
 	int ret;
 	struct device *dev = &pdev->dev;
+	const struct of_device_id *of_id = of_match_device(imx_sec_dsim_dt_ids, dev);
+	const struct sec_mipi_dsim_plat_data *pdata;
 
 	dev_dbg(dev, "%s: dsim probe begin\n", __func__);
 
+	if (!of_id)
+		return -ENODEV;
+	pdata = of_id->data;
+
 	dsim_dev = devm_kzalloc(dev, sizeof(*dsim_dev), GFP_KERNEL);
 	if (!dsim_dev) {
 		dev_err(dev, "Unable to allocate 'dsim_dev'\n");
@@ -454,6 +479,11 @@
 	}
 	dsim_dev->dev = dev;
 
+	dsim_dev->pdata = *pdata;
+	dsim_dev->pdata.priv_data = dsim_dev;
+	dsim_dev->pdata.host_attach = imx_sec_dsim_host_attach;
+	dsim_dev->pdata.host_detach = imx_sec_dsim_host_detach;
+
 	dsim_dev->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(dsim_dev->base))
 		return PTR_ERR(dsim_dev->base);
@@ -487,19 +517,20 @@
 
 	pm_runtime_enable(dev);
 
-	ret = component_add(dev, &imx_sec_dsim_ops);
+	ret = sec_mipi_dsim_probe(dev, dsim_dev->base, dsim_dev->irq, &dsim_dev->pdata);
 	if (ret) {
 		pm_runtime_disable(dev);
 		sec_dsim_of_put_resets(dsim_dev);
-		dev_err_probe(dev, ret, "Failed to add component\n");
+		dev_err_probe(dev, ret, "Failed to probe sec-dsim\n");
+		return ret;
 	}
 
-	return ret;
+	return 0;
 }
 
 static void imx_sec_dsim_remove(struct platform_device *pdev)
 {
-	component_del(&pdev->dev, &imx_sec_dsim_ops);
+	sec_mipi_dsim_remove(&pdev->dev);
 	pm_runtime_disable(&pdev->dev);
 	sec_dsim_of_put_resets(dsim_dev);
 }
diff -Naur a/include/drm/bridge/sec_mipi_dsim.h b/include/drm/bridge/sec_mipi_dsim.h
--- a/include/drm/bridge/sec_mipi_dsim.h	2026-09-03 13:04:27.729977316 -0400
+++ b/include/drm/bridge/sec_mipi_dsim.h	2026-09-03 13:04:48.218381490 -0400
@@ -20,6 +20,7 @@
 
 struct sec_mipi_dsim_dphy_timing;
 struct sec_mipi_dsim_pll;
+struct mipi_dsi_device;
 
 struct sec_mipi_dsim_plat_data {
 	uint32_t version;
@@ -32,6 +33,9 @@
 	enum drm_mode_status (*mode_valid)(struct drm_encoder *encoder,
 					   const struct drm_display_mode *mode);
 	int (*determine_pll_ref_rate)(u32 *rate, u32 min, u32 max);
+	int (*host_attach)(void *priv_data, struct mipi_dsi_device *dsi);
+	int (*host_detach)(void *priv_data, struct mipi_dsi_device *dsi);
+	void *priv_data;
 };
 
 /* DPHY PLL structure */
@@ -102,9 +106,11 @@
 
 int sec_mipi_dsim_check_pll_out(void *driver_private,
 				const struct drm_display_mode *mode);
+int sec_mipi_dsim_probe(struct device *dev, void __iomem *base,
+			int irq, const struct sec_mipi_dsim_plat_data *pdata);
+void sec_mipi_dsim_remove(struct device *dev);
 int sec_mipi_dsim_bind(struct device *dev, struct device *master, void *data,
-		       struct drm_encoder *encoder, void __iomem *base,
-		       int irq, const struct sec_mipi_dsim_plat_data *pdata);
+		       struct drm_encoder *encoder);
 void sec_mipi_dsim_unbind(struct device *dev, struct device *master, void *data);
 
 void sec_mipi_dsim_suspend(struct device *dev);
-- 

From c88667a226ef54b656dc16f0f3c52897c0c76605 Mon Sep 17 00:00:00 2001
From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Date: Tue, 7 May 2024 14:22:36 +0200
Subject: [PATCH] phy: freescale: imx8mq-usb: set vbus depending on mode

Signed-off-by: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
---
 drivers/phy/freescale/phy-fsl-imx8mq-usb.c | 22 ++++++++++++++++------
 1 file changed, 16 insertions(+), 6 deletions(-)

Upstream-Status: Inappropriate No time for upstreaming 

diff --git a/drivers/phy/freescale/phy-fsl-imx8mq-usb.c b/drivers/phy/freescale/phy-fsl-imx8mq-usb.c
index 559b8f9ef80a..7bf935f17af2 100644
--- a/drivers/phy/freescale/phy-fsl-imx8mq-usb.c
+++ b/drivers/phy/freescale/phy-fsl-imx8mq-usb.c
@@ -153,6 +153,7 @@ struct imx8mq_usb_phy {
 	struct dentry *debugfs;
 	u16	cr_access_base;
 	u16	cr_read_count;
+	bool	vbus_enabled;
 };
 
 
@@ -849,10 +850,6 @@ static int imx8mq_phy_power_on(struct phy *phy)
 	u32 value;
 	int ret;
 
-	ret = regulator_enable(imx_phy->vbus);
-	if (ret)
-		return ret;
-
 	ret = clk_prepare_enable(imx_phy->clk);
 	if (ret)
 		return ret;
@@ -883,7 +880,10 @@ static int imx8mq_phy_power_off(struct phy *phy)
 
 	clk_disable_unprepare(imx_phy->alt_clk);
 	clk_disable_unprepare(imx_phy->clk);
-	regulator_disable(imx_phy->vbus);
+	if (!IS_ERR_OR_NULL(imx_phy->vbus) && imx_phy->vbus_enabled) {
+		regulator_disable(imx_phy->vbus);
+		imx_phy->vbus_enabled = false;
+	}
 
 	return 0;
 }
@@ -1116,6 +1116,25 @@ static int imx8mq_phy_set_mode(struct phy *phy, enum phy_mode mode,
 {
 	struct imx8mq_usb_phy *imx_phy = phy_get_drvdata(phy);
 
+	switch (mode) {
+	case PHY_MODE_USB_HOST:
+		if (!IS_ERR_OR_NULL(imx_phy->vbus) && !imx_phy->vbus_enabled) {
+			int ret = regulator_enable(imx_phy->vbus);
+			if (ret)
+				dev_err(&imx_phy->phy->dev, "failed to enable vbus %d\n", ret);
+			imx_phy->vbus_enabled = true;
+		}
+		break;
+	case PHY_MODE_USB_DEVICE:
+		if (!IS_ERR_OR_NULL(imx_phy->vbus) && imx_phy->vbus_enabled) {
+			regulator_disable(imx_phy->vbus);
+			imx_phy->vbus_enabled = false;
+		}
+		break;
+	default:
+		break;
+	}
+
 	if (mode == PHY_MODE_USB_DEVICE)
 		return imx8mq_phy_charger_detect(imx_phy);
 
@@ -1185,8 +1204,8 @@ static int imx8mq_usb_phy_probe(struct platform_device *pdev)
 	if (IS_ERR(imx_phy->phy))
 		return PTR_ERR(imx_phy->phy);
 
-	imx_phy->vbus = devm_regulator_get(dev, "vbus");
-	if (IS_ERR(imx_phy->vbus))
+	imx_phy->vbus = devm_regulator_get_optional(dev, "vbus");
+	if (IS_ERR(imx_phy->vbus) && PTR_ERR(imx_phy->vbus) != -ENODEV)
 		return dev_err_probe(dev, PTR_ERR(imx_phy->vbus), "failed to get vbus\n");
 
 	phy_set_drvdata(imx_phy->phy, imx_phy);

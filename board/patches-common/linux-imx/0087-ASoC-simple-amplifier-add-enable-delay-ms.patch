From 532264b0b0d2d56b1d715b3ce2d0ece589939da9 Mon Sep 17 00:00:00 2001
From: Summit <noreply@example.com>
Date: Thu, 15 Oct 2026 19:42:56 +0000
Subject: [PATCH] ASoC: simple-amplifier: add enable-delay-ms

DAPM powers the amplifier widget in prepare(), before the DAI starts its
bit clock and before a codec that ramps its output (de-pop) has settled.
Unmuting the amplifier at that point passes the ramp and the clock start
transient to the speaker.

Add an optional enable-delay-ms property. When set, the enable GPIO is
asserted from a delayed work item after the widget is powered up. Power
down cancels the pending work and deasserts the GPIO immediately, so the
amplifier is still muted before the codec is stopped.

Upstream-Status: Inappropriate [board-specific, not submitted]

Signed-off-by: Summit <noreply@example.com>
---
 .../sound/simple-audio-amplifier.yaml         |  5 +++
 sound/soc/codecs/simple-amplifier.c           | 40 ++++++++++++++++---
 2 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/simple-audio-amplifier.yaml b/Documentation/devicetree/bindings/sound/simple-audio-amplifier.yaml
index 5db1f989d050..6db76ac1775a 100644
--- a/Documentation/devicetree/bindings/sound/simple-audio-amplifier.yaml
+++ b/Documentation/devicetree/bindings/sound/simple-audio-amplifier.yaml
@@ -21,6 +21,11 @@ properties:
   enable-gpios:
     maxItems: 1
 
+  enable-delay-ms:
+    description: >
+      Time in milliseconds to wait after the amplifier widget is powered
+      before asserting enable-gpios. Defaults to 0 (assert immediately).
+
   VCC-supply:
     description: >
       power supply for the device
diff --git a/sound/soc/codecs/simple-amplifier.c b/sound/soc/codecs/simple-amplifier.c
index d306c585b52b..a3e9590d3656 100644
--- a/sound/soc/codecs/simple-amplifier.c
+++ b/sound/soc/codecs/simple-amplifier.c
@@ -4,38 +4,59 @@
  * Author: Jerome Brunet <jbrunet@baylibre.com>
  */
 
+#include <linux/devm-helpers.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/property.h>
 #include <linux/regulator/consumer.h>
+#include <linux/workqueue.h>
 #include <sound/soc.h>
 
 #define DRV_NAME "simple-amplifier"
 
 struct simple_amp {
 	struct gpio_desc *gpiod_enable;
+	struct delayed_work enable_work;
+	unsigned int enable_delay_ms;
 };
 
+static void simple_amp_enable_work(struct work_struct *work)
+{
+	struct simple_amp *priv = container_of(work, struct simple_amp,
+					       enable_work.work);
+
+	gpiod_set_value_cansleep(priv->gpiod_enable, 1);
+}
+
 static int drv_event(struct snd_soc_dapm_widget *w,
 		     struct snd_kcontrol *control, int event)
 {
 	struct snd_soc_component *c = snd_soc_dapm_to_component(w->dapm);
 	struct simple_amp *priv = snd_soc_component_get_drvdata(c);
-	int val;
 
 	switch (event) {
 	case SND_SOC_DAPM_POST_PMU:
-		val = 1;
+		if (priv->enable_delay_ms) {
+			/*
+			 * DAPM powers the widget in prepare(), before the
+			 * DAI clocks start. Unmute from a work item so the
+			 * source can settle first.
+			 */
+			schedule_delayed_work(&priv->enable_work,
+				msecs_to_jiffies(priv->enable_delay_ms));
+		} else {
+			gpiod_set_value_cansleep(priv->gpiod_enable, 1);
+		}
 		break;
 	case SND_SOC_DAPM_PRE_PMD:
-		val = 0;
+		cancel_delayed_work_sync(&priv->enable_work);
+		gpiod_set_value_cansleep(priv->gpiod_enable, 0);
 		break;
 	default:
 		WARN(1, "Unexpected event");
 		return -EINVAL;
 	}
 
-	gpiod_set_value_cansleep(priv->gpiod_enable, val);
-
 	return 0;
 }
 
@@ -69,12 +90,21 @@ static int simple_amp_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct simple_amp *priv;
+	int ret;
 
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
 	if (priv == NULL)
 		return -ENOMEM;
 	platform_set_drvdata(pdev, priv);
 
+	ret = devm_delayed_work_autocancel(dev, &priv->enable_work,
+					   simple_amp_enable_work);
+	if (ret)
+		return ret;
+
+	device_property_read_u32(dev, "enable-delay-ms",
+				 &priv->enable_delay_ms);
+
 	priv->gpiod_enable = devm_gpiod_get_optional(dev, "enable",
 						     GPIOD_OUT_LOW);
 	if (IS_ERR(priv->gpiod_enable))
-- 
2.55.0


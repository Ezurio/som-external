+static enum drm_mode_status lvds_codec_mode_valid(struct drm_bridge *bridge,
+					const struct drm_display_info *info,
+					const struct drm_display_mode *mode)
+{
+	struct lvds_codec *lvds_codec = to_lvds_codec(bridge);
+
+	if (mode->clock < lvds_codec->min_frequency)
+		return MODE_CLOCK_LOW;
+
+	if (mode->clock > lvds_codec->max_frequency)
+		return MODE_CLOCK_HIGH;
+
+	return MODE_OK;
+}

From: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
Date: Wed, 12 Feb 2026 21:35:00 -0500
Subject: [PATCH] gpio: Add GPIO fanout driver for virtual GPIO control

Add a new GPIO fanout driver that provides a virtual GPIO chip interface
to control multiple physical GPIO outputs simultaneously. This is useful
for controlling groups of related outputs with a single GPIO value.

The driver creates a virtual GPIO chip that, when written to, propagates
the value to all configured physical output GPIOs. This is implemented
using the GPIO array API for efficient batch operations.

Device tree usage example:

        gpio_fanout: gpio-fanout {
        compatible = "gpio-fanout";
        gpio-controller;
        #gpio-cells = <2>;
        ngpio = <1>;
        /* Physical output GPIOs */
        gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>,
                <&gpio0 23 GPIO_ACTIVE_HIGH>,
                <&gpio0 24 GPIO_ACTIVE_HIGH>;
    };

Usage via standard GPIO APIs:

    gpioset gpiochip0 0=1  # Set all outputs to HIGH
    gpioget gpiochip0 0    # Get current value of virtual GPIO

Signed-off-by: Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>
---
 drivers/gpio/Kconfig       |  12 ++
 drivers/gpio/Makefile      |   1 +
 drivers/gpio/gpio-fanout.c | 337 +++++++++++++++++++++++++++++++++++++
 3 files changed, 350 insertions(+)
 create mode 100644 drivers/gpio/gpio-fanout.c

Upstream-Status: Inappropriate No time for upstreaming

--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -2016,6 +2016,17 @@ config GPIO_SIM
 	  This enables the GPIO simulator - a configfs-based GPIO testing
 	  driver.
 
+config GPIO_FANOUT
+	tristate "GPIO Fanout driver"
+	help
+	  This driver provides a virtual GPIO chip that controls multiple
+	  physical GPIO outputs simultaneously. When the virtual GPIO is
+	  written to, the value is propagated to all configured physical
+	  output GPIOs.
+	  This is useful for controlling groups of related outputs with a
+	  single GPIO value.
+	  Say Y here if you need this functionality.
+
 endmenu
 
 menu "GPIO Debugging utilities"
--- a/drivers/gpio/Makefile
+++ b/drivers/gpio/Makefile
@@ -69,6 +69,7 @@ obj-$(CONFIG_GPIO_SL28CPLD)		+= gpio-sl28cpld.o
 obj-$(CONFIG_GPIO_EP93XX)		+= gpio-ep93xx.o
 obj-$(CONFIG_GPIO_EXAR)			+= gpio-exar.o
 obj-$(CONFIG_GPIO_F7188X)		+= gpio-f7188x.o
+obj-$(CONFIG_GPIO_FANOUT)		+= gpio-fanout.o
 obj-$(CONFIG_GPIO_FTGPIO010)		+= gpio-ftgpio010.o
 obj-$(CONFIG_GPIO_FXL6408)		+= gpio-fxl6408.o
 obj-$(CONFIG_GPIO_GE_FPGA)		+= gpio-ge.o
--- /dev/null
+++ b/drivers/gpio/gpio-fanout.c
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * GPIO Fanout Driver - Virtual GPIO chip that controls multiple physical GPIOs
+ *
+ * Copyright (C) 2026 Boris Krasnovskiy
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio/consumer.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/bitmap.h>
+
+#define DRIVER_NAME "gpio-fanout"
+
+/**
+ * struct gpio_fanout_data - GPIO fanout driver private data
+ * @chip: GPIO chip descriptor
+ * @dev: Pointer to device structure
+ * @descs: Array of GPIO descriptors for output GPIOs
+ * @value_bitmap: Bitmap of values for array API operations
+ * @output_values: Cached output state for virtual GPIOs
+ */
+struct gpio_fanout_data {
+	struct gpio_chip chip;
+	struct device *dev;
+	struct gpio_descs *descs;
+	unsigned long *value_bitmap;
+	int *output_values;
+};
+
+/**
+ * gpio_fanout_get() - Get the value of a virtual GPIO
+ * @chip: The GPIO chip
+ * @offset: The GPIO offset
+ *
+ * Returns the cached value of the virtual GPIO.
+ *
+ * Return: GPIO value (0 or 1), or -EINVAL if offset is invalid
+ */
+static int gpio_fanout_get(struct gpio_chip *chip, unsigned int offset)
+{
+	struct gpio_fanout_data *data = gpiochip_get_data(chip);
+
+	if (offset >= chip->ngpio)
+		return -EINVAL;
+
+	return data->output_values[offset];
+}
+
+/**
+ * gpio_fanout_set() - Set the value of all output GPIOs
+ * @chip: The GPIO chip
+ * @offset: The GPIO offset (not used, applies to all outputs)
+ * @value: The value to set (0 or 1)
+ *
+ * Sets all output GPIOs to the requested value by updating the
+ * value bitmap and propagating changes via the GPIO array API.
+ */
+static int gpio_fanout_set(struct gpio_chip *chip, unsigned int offset,
+			    int value)
+{
+	struct gpio_fanout_data *data = gpiochip_get_data(chip);
+
+	if (offset >= chip->ngpio)
+		return -EINVAL;
+
+	data->output_values[offset] = value;
+
+	dev_dbg(data->dev,
+		"Virtual GPIO %u set to %d, propagating to %d outputs\n",
+		offset, value, data->descs->ndescs);
+
+	if (value)
+		bitmap_fill(data->value_bitmap, data->descs->ndescs);
+	else
+		bitmap_zero(data->value_bitmap, data->descs->ndescs);
+
+	return gpiod_set_array_value_cansleep(data->descs->ndescs,
+				       data->descs->desc,
+				       NULL,
+				       data->value_bitmap);
+}
+
+/**
+ * gpio_fanout_direction_input() - Request GPIO direction as input
+ * @chip: The GPIO chip
+ * @offset: The GPIO offset
+ *
+ * Virtual GPIO does not support input mode.
+ *
+ * Return: -EINVAL (not supported)
+ */
+static int gpio_fanout_direction_input(struct gpio_chip *chip,
+				       unsigned int offset)
+{
+	return -EINVAL;
+}
+
+/**
+ * gpio_fanout_direction_output() - Request GPIO direction as output
+ * @chip: The GPIO chip
+ * @offset: The GPIO offset
+ * @value: Initial value for the GPIO
+ *
+ * Configures the virtual GPIO as an output and sets it to the
+ * requested value, which is propagated to all physical outputs.
+ *
+ * Return: 0 on success, -EINVAL if offset is invalid
+ */
+static int gpio_fanout_direction_output(struct gpio_chip *chip,
+					 unsigned int offset, int value)
+{
+	if (offset >= chip->ngpio)
+		return -EINVAL;
+
+	gpio_fanout_set(chip, offset, value);
+	return 0;
+}
+
+/**
+ * gpio_fanout_parse_dt() - Parse device tree and get GPIO descriptors
+ * @pdev: Platform device pointer
+ * @data: Driver private data structure
+ *
+ * Retrieves the output GPIO array from device tree and allocates
+ * the necessary bitmaps and caches.
+ *
+ * Return: 0 on success, negative error code on failure
+ */
+static int gpio_fanout_parse_dt(struct platform_device *pdev,
+				 struct gpio_fanout_data *data)
+{
+	struct device *dev = &pdev->dev;
+	struct gpio_descs *output_gpios;
+	int num_outputs;
+
+	output_gpios = devm_gpiod_get_array(dev, NULL, GPIOD_OUT_LOW);
+	if (IS_ERR(output_gpios)) {
+		dev_err(dev, "Failed to get GPIO array: %ld\n",
+			PTR_ERR(output_gpios));
+		return PTR_ERR(output_gpios);
+	}
+
+	if (output_gpios->ndescs == 0) {
+		dev_err(dev, "No GPIOs specified\n");
+		return -EINVAL;
+	}
+
+	num_outputs = output_gpios->ndescs;
+
+	data->output_values = devm_kcalloc(dev, data->chip.ngpio,
+					   sizeof(*data->output_values),
+					   GFP_KERNEL);
+	if (!data->output_values)
+		return -ENOMEM;
+
+	data->value_bitmap = devm_bitmap_zalloc(dev, num_outputs,
+						GFP_KERNEL);
+	if (!data->value_bitmap)
+		return -ENOMEM;
+
+	data->descs = output_gpios;
+
+	return 0;
+}
+
+/**
+ * gpio_fanout_probe() - Probe the GPIO fanout device
+ * @pdev: Platform device pointer
+ *
+ * Initializes the GPIO fanout driver, configures the virtual GPIO chip,
+ * parses the device tree to get output GPIO descriptors, and registers
+ * the chip with the GPIO subsystem.
+ *
+ * Return: 0 on success, negative error code on failure
+ */
+static int gpio_fanout_probe(struct platform_device *pdev)
+{
+	struct gpio_fanout_data *data;
+	struct device_node *np = pdev->dev.of_node;
+	u32 ngpio = 1;
+	int ret;
+
+	data = devm_kzalloc(&pdev->dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->dev = &pdev->dev;
+
+	of_property_read_u32(np, "ngpio", &ngpio);
+	if (ngpio > 32) {
+		dev_err(&pdev->dev, "ngpio must be <= 32\n");
+		return -EINVAL;
+	}
+
+	data->chip.label = DRIVER_NAME;
+	data->chip.parent = &pdev->dev;
+	data->chip.owner = THIS_MODULE;
+	data->chip.base = -1;
+	data->chip.ngpio = ngpio;
+	data->chip.can_sleep = true;
+	data->chip.get = gpio_fanout_get;
+	data->chip.set = gpio_fanout_set;
+	data->chip.direction_input = gpio_fanout_direction_input;
+	data->chip.direction_output = gpio_fanout_direction_output;
+
+	ret = gpio_fanout_parse_dt(pdev, data);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to parse device tree: %d\n", ret);
+		return ret;
+	}
+
+	ret = devm_gpiochip_add_data(&pdev->dev, &data->chip, data);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register GPIO chip: %d\n", ret);
+		return ret;
+	}
+
+	platform_set_drvdata(pdev, data);
+
+	dev_info(&pdev->dev,
+		 "GPIO fanout chip registered: %d virtual -> %d outputs\n",
+		 ngpio, data->descs->ndescs);
+
+	return 0;
+}
+
+static const struct of_device_id gpio_fanout_of_match[] = {
+	{ .compatible = "gpio-fanout", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gpio_fanout_of_match);
+
+static struct platform_driver gpio_fanout_driver = {
+	.driver = {
+		.name = DRIVER_NAME,
+		.of_match_table = gpio_fanout_of_match,
+	},
+	.probe = gpio_fanout_probe,
+};
+
+module_platform_driver(gpio_fanout_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Boris Krasnovskiy <boris.krasnovskiy@ezurio.com>");
+MODULE_DESCRIPTION("GPIO Fanout Driver - Virtual GPIO chip controlling multiple physical GPIOs");

diff --git a/psplash-drm.h b/psplash-drm.h
new file mode 100644
--- /dev/null
+++ b/psplash-drm.h
@@ -0,0 +1,9 @@
+#ifndef PSPLASH_DRM_H
+#define PSPLASH_DRM_H
+
+/* Returns the panel rotation angle (0/90/180/270) detected from the DRM
+ * "panel orientation" connector property of the DRM device backing
+ * /dev/fb<fbdev_id>, or 0 if unavailable. */
+int psplash_drm_panel_angle(int fbdev_id);
+
+#endif
diff --git a/psplash-drm.c b/psplash-drm.c
new file mode 100644
--- /dev/null
+++ b/psplash-drm.c
@@ -0,0 +1,111 @@
+#include <string.h>
+#include <stdlib.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <xf86drmMode.h>
+
+#include "psplash-drm.h"
+
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+
+/* DRM "panel orientation" enum values as registered by the kernel
+ * (drm_connector.c drm_panel_orientation_enum_list, always in this order):
+ *   0 = Normal, 1 = Upside Down, 2 = Left Side Up, 3 = Right Side Up
+ */
+static const int orientation_angles[] = { 0, 180, 90, 270 };
+
+static int parse_card_index(const char *name)
+{
+	char *end;
+	long value;
+
+	if (strncmp(name, "card", 4))
+		return -1;
+
+	value = strtol(name + 4, &end, 10);
+	if (*end != '\0' || value < 0)
+		return -1;
+
+	return (int)value;
+}
+
+static int open_drm_for_fbdev(int fbdev_id)
+{
+	DIR *dir;
+	struct dirent *entry;
+	char path[64];
+	int card_id = -1;
+	int fd;
+
+	snprintf(path, sizeof(path), "/sys/class/graphics/fb%d/device/drm",
+			 fbdev_id);
+	dir = opendir(path);
+	if (dir) {
+		while ((entry = readdir(dir)) != NULL) {
+			card_id = parse_card_index(entry->d_name);
+			if (card_id >= 0)
+				break;
+		}
+		closedir(dir);
+	}
+
+	if (card_id < 0)
+		card_id = fbdev_id;
+
+	snprintf(path, sizeof(path), "/dev/dri/card%d", card_id);
+	fd = open(path, O_RDWR | O_CLOEXEC);
+	return fd >= 0 ? fd : -1;
+}
+
+static int query_drm_fd(int fd)
+{
+	drmModeRes *res = drmModeGetResources(fd);
+	int angle = 0;
+	int i, j;
+
+	if (!res)
+		return 0;
+
+	for (i = 0; i < res->count_connectors; i++) {
+		drmModeObjectProperties *props = drmModeObjectGetProperties(
+			fd, res->connectors[i], DRM_MODE_OBJECT_CONNECTOR);
+
+		if (!props)
+			continue;
+
+		for (j = 0; j < (int)props->count_props; j++) {
+			drmModePropertyRes *prop = drmModeGetProperty(fd, props->props[j]);
+
+			if (prop) {
+				if (!strcmp(prop->name, "panel orientation") &&
+				    (prop->flags & DRM_MODE_PROP_ENUM) &&
+				    props->prop_values[j] < ARRAY_SIZE(orientation_angles)) {
+					angle = orientation_angles[props->prop_values[j]];
+					drmModeFreeProperty(prop);
+					drmModeFreeObjectProperties(props);
+					goto done;
+				}
+				drmModeFreeProperty(prop);
+			}
+		}
+		drmModeFreeObjectProperties(props);
+	}
+done:
+	drmModeFreeResources(res);
+	return angle;
+}
+
+int psplash_drm_panel_angle(int fbdev_id)
+{
+	int fd, angle;
+
+	fd = open_drm_for_fbdev(fbdev_id);
+	if (fd < 0)
+		return 0;
+
+	angle = query_drm_fd(fd);
+	close(fd);
+	return angle > 0 ? angle : 0;
+}

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

&reg_wifi_en {
	startup-delay-us = <10000>;
	off-on-delay-us = <100>;
};

&usdhc3 {
	status = "okay";

	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";
	};
};

&lpuart5 {
 	status = "okay";

	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_wifi_en>;
		max-speed = <115200>;

		host-wakeup-gpios = <&pcal6534 4 GPIO_ACTIVE_HIGH>;
	};
};

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

&reg_slow_clock {
	status = "okay";
};

&reg_usdhc2_vmmc {
	vin-supply = <&reg_slow_clock>;

	startup-delay-us = <10000>;
	off-on-delay-us = <100>;
};

&usdhc2 {
	cap-power-off-card;

	#address-cells = <1>;
	#size-cells = <0>;

	bt@1 {
		reg = <1>;
		compatible = "ti,cc33xxbt";
	};

	wifi@2 {
		reg = <2>;
		compatible = "ti,cc33xx";
	};
};

&lpuart8 {
 	status = "okay";

	bluetooth {
		compatible = "ti,cc33xx-bt";
		cc33xx-supply = <&reg_usdhc2_vmmc>;
		max-speed = <115200>;
	};
};

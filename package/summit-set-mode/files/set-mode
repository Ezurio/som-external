die() {
    echo "$1"
    exit 1
}

# Find kernel FIT Image
if [ -f '/boot/kernel.itb' ]; then
    kernel='/boot/kernel.itb'
elif [ -f '/boot/fitImage' ]; then
    kernel='/boot/fitImage'
else
    die 'No kernel image found'
fi

# Retrieve all configurations from FIT Image
confs=$(dumpimage -l ${kernel} | grep -F 'Configuration')

# Find default configuration
default=$(echo "${confs}" | grep -m1 -o 'conf-.*\.dtb')
# Find dtb prefix
prefix=$(echo "${default}" | sed -r 's/-[^-]+\.dtb//')
# Find all parameters
params=$(echo "${confs}" | sed -rn "s/.*${prefix}-(.*)\.dtbo.*/\1/p" | sort -u)

cconf=$(fw_printenv -n conf)
# Parse current conf into list of overlay names
cconf_names=$(echo "${cconf}" | tr '#' '\n' | sed -rn "s/${prefix}-(.*)\.dtbo/\1/p")

overlay_names=

print_overlays() {
    echo 'Currently set modes/overlays:'
    if [ -z "${cconf_names}" ]; then
        echo '  No overlays set'
    else

        # shellcheck disable=SC2086
        printf '  %s\n' ${cconf_names}
    fi
}

print_regdomain() {
    echo 'Currently set regulatory domain:'
    { printf '  '; fw_printenv -n 'RegDomain'; } || \
        die '  No regulatory domain set'
}

overlay_append() {
    overlay_names="${overlay_names}${overlay_names:+
}${1}"
}

overlay_remove() {
    overlay_names=$(echo "${overlay_names}" | sed "/^${1}$/d")
}

case "${1}" in
    '')
        echo "Usage: $0 <mode> [<overlays> ...]"
        echo '  <mode> is one or multiple of:'
        echo '  default - remove all overlays'
        echo '  status - print active overlays'
        echo '  <overlay> [<overlay> ...] - set exact list of overlays'
        echo '  +<overlay> - add overlay, -<overlay> - remove overlay (can be mixed)'
        echo
        echo 'Available modes/overlays:'
        # shellcheck disable=SC2086
        printf '  %s\n' ${params}
        echo
        print_regdomain
        echo
        print_overlays
        exit 1
        ;;

    default)
        # overlay_names stays empty - remove all overlays
        ;;

    status)
        # Print current configuration
        print_overlays
        exit 0
        ;;

    *)
        # If no parameters are found, exit
        [ -n "${params}" ] || die 'No overlays found'

        # shellcheck disable=SC1091
        . /usr/bin/boot-rootfs.sh

        # Start from current conf, skipping stale overlays
        overlay_names=$(echo "${cconf_names}" | grep -Fx "${params}")
        _cleared=false

        # Verify that all parameters are valid and add them into
        # configuration string
        # Validate all names at once
        _invalid=$(printf '%s\n' "${@}" | grep -oE '[^+-].*' | grep -vFx "${params}")
        [ -z "${_invalid}" ] || die "Invalid mode: $(echo "${_invalid}" | head -1)"

        for i in "${@}" ; do
            case "${i}" in
                -*) overlay_remove "${i#-}"; continue ;;
                +*) name="${i#+}" ;;
                *)  ${_cleared} || { overlay_names=; _cleared=true; }
                    name="${i}" ;;
            esac

            case "${name}" in
                *ifx*)
                    [ -n "$(fw_printenv -n 'RegDomain')" ] || \
                        die 'Regulatory Domain not set for IFX overlay'
                    ;;
            esac

            case "${name}" in
                m2*sdio*)
                    [ "${rootDevType:?}" != 'SD' ] || \
                        die 'M.2 SDIO cannot be used when booting from SD card'
                    ;;
            esac

            overlay_append "${name}"
        done
        ;;
esac

# Reconstruct conf from overlay_names
conf=
for _n in ${overlay_names} ; do
    conf="${conf}#${prefix}-${_n}.dtbo"
done
[ -z "${conf}" ] || conf="#${default}${conf}"

# Verify that requested configuration is different from current one
[ "${cconf}" != "${conf}" ] || die 'Configuration already set'

# Set new configuration
fw_setenv 'conf' "${conf}" || die 'Failed to set new configuration'

# Reboot to apply new configuration
reboot

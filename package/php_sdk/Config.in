config BR2_PACKAGE_PHP_SDK
	bool "Summit PHP SDK"
	depends on BR2_PACKAGE_SDCSDK || BR2_PACKAGE_SUMMIT_SUPPLICANT
	select BR2_PACKAGE_PHP
	select BR2_PACKAGE_PHP_EXT_JSON
	help
	  Summit SDK PHP library interface

if BR2_PACKAGE_PHP_SDK

config BR2_PACKAGE_PHP_SDK_TEST
	bool "Test PHP script"
	help
	  Install test PHP script to webserver on target.

endif

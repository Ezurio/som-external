#!/bin/sh
### BEGIN INIT INFO
# Provides:          summit-usbgadget
# Required-Start:    $local_fs $remote_fs $syslog
# Required-Stop:     $local_fs $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Summit USB gadget daemon
### END INIT INFO

DAEMON=/usr/bin/summit-usbgadget
PIDFILE=/var/run/summit-usbgadget.pid

start_service() {
    if [ ! -x "$DAEMON" ]; then
        echo "Missing daemon: $DAEMON" >&2
        return 1
    fi

    start-stop-daemon --start --quiet --background \
        --make-pidfile --pidfile "$PIDFILE" \
        --exec "$DAEMON"
}

stop_service() {
    start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry TERM/5/KILL/2
    status=$?
    rm -f "$PIDFILE"
    return "$status"
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart|reload)
        stop_service || true
        start_service
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "summit-usbgadget is running"
            exit 0
        fi
        echo "summit-usbgadget is stopped"
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload|status}" >&2
        exit 1
        ;;
esac

exit 0

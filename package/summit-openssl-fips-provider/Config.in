config BR2_PACKAGE_SUMMIT_OPENSSL_FIPS_PROVIDER
	bool "Summit OpenSSL FIPS Provider"
	depends on BR2_PACKAGE_OPENSSL 
	depends on BR2_PACKAGE_LIBOPENSSL_3_0
	depends on !BR2_PACKAGE_FIPSCHECK 
	depends on !BR2_PACKAGE_LIBOPENSSL_ENABLE_FIPS
	help
		Summit OpenSSL FIPS provider

if BR2_PACKAGE_SUMMIT_OPENSSL_FIPS_PROVIDER

config BR2_PACKAGE_SUMMIT_OPENSSL_FIPS_PROVIDER_VERSION_VALUE
	string "OpenSSL FIPS Provider version"
	default "11.0.0.294"

config BR2_PACKAGE_SUMMIT_OPENSSL_FIPS_PROVIDER_ARCH
	string
	default "arm-eabihf" if BR2_arm && BR2_ARM_EABIHF
	default "arm-eabi" if BR2_arm && BR2_ARM_EABI
	default "aarch64" if BR2_aarch64
	default "powerpc64-e5500" if BR2_powerpc64
	default "powerpc" if BR2_powerpc
	default "x86" if BR2_i386
	default "x86_64" if BR2_x86_64

endif # BR2_PACKAGE_SUMMIT_OPENSSL_FIPS_PROVIDER

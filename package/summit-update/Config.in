config BR2_PACKAGE_SUMMIT_UPDATE
	bool "Summit Software Update"
	select BR2_PACKAGE_SWUPDATE
	select BR2_PACKAGE_LIBCONFIG
	help
	  Support for software updates

if BR2_PACKAGE_SUMMIT_UPDATE

config BR2_PACKAGE_SUMMIT_UPDATE_STREAM_SERVICE
	bool "Enable firmware update streaming service"
	depends on BR2_INIT_SYSTEMD
	help
	  Enable systemd socket-activated service to accept firmware
	  updates over TCP connections (port 9000). When enabled, the
	  service will automatically start on incoming connections.
	  To perform an update, use the following example command:
	  nc -N 10.10.4.234 9000 < firmware_update.swu

endif

config BR2_PACKAGE_SUMMIT_ENCRYPTED_STORAGE_TOOLKIT
	bool "Summit Encrypted Storage toolkit"
	select BR2_SUMMIT_SECURE_BOOT
	select BR2_PACKAGE_KEYUTILS
	select BR2_PACKAGE_HOST_CRYPTSETUP
	select BR2_PACKAGE_FSCRYPTCTL_1
	select BR2_PACKAGE_HOST_FSCRYPTCTL_1
	select BR2_PACKAGE_BLUEZ5_UTILS_SECURE_STORAGE if BR2_PACKAGE_BLUEZ5_UTILS
	help
	  Toolkit for implementing Secure Boot architecture and encription
	  This is part of Chain of Trust architecture.

if BR2_PACKAGE_SUMMIT_ENCRYPTED_STORAGE_TOOLKIT

config BR2_PACKAGE_SUMMIT_ENCRYPTED_STORAGE_TOOLKIT_EXEC_PERM
	bool "Allow exec on perm mount"

config BR2_PACKAGE_SUMMIT_ENCRYPTED_STORAGE_TOOLKIT_CREATE_RODATA
	bool "Create encrypted read-only data partition"
	default y

endif

if BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM

config BR2_TOOLCHAIN_EXTERNAL_PREFIX
	default "arm-summit-linux-gnueabihf" if BR2_ARM_EABIHF
	default "arm-summit-linux-gnueabi" if BR2_ARM_EABI
	default "aarch64-summit-linux-gnu" if BR2_aarch64

config BR2_PACKAGE_PROVIDES_TOOLCHAIN_EXTERNAL
	default "toolchain-external-summit-arm"

endif

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM
	bool "Summit ARM Toolchain"
	depends on BR2_arm || BR2_aarch64
	depends on BR2_ARM_CPU_ARMV7A || BR2_ARM_CPU_ARMV8A || BR2_ARM_CPU_ARMV6 || BR2_ARM_CPU_ARMV5 || BR2_ARM_CPU_ARMV4 || BR2_aarch64
	depends on BR2_HOSTARCH = "x86_64"
	select BR2_TOOLCHAIN_EXTERNAL_GLIBC
	select BR2_TOOLCHAIN_HAS_SSP
	select BR2_INSTALL_LIBSTDCPP
	help
	  Summit toolchain for the ARM architecture.

if BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM

choice
	prompt "Toolchain Version"
	default BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_12
	help
	  Select the version of the toolchain you wish to use.

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_12
	bool "Summit 12.x (2024.02) toolchain"
	select BR2_TOOLCHAIN_HEADERS_AT_LEAST_6_6
	select BR2_TOOLCHAIN_GCC_AT_LEAST_13
	select BR2_TOOLCHAIN_HAS_OPENMP
	help
	  GCC 13.3.0, GDB 14.2.0, glibc-2.38+, headers-6.6.0, binutils 2.41

endchoice

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_ID
	string
	default summit

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_VERSION
	string
	default 12.0.0.59 if BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_12

endif

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM
	bool "Summit ARM Toolchain"
	depends on BR2_arm || BR2_aarch64
	depends on BR2_ARM_CPU_ARMV7A || BR2_ARM_CPU_ARMV8A || BR2_ARM_CPU_ARMV6 || BR2_ARM_CPU_ARMV5 || BR2_ARM_CPU_ARMV4 || BR2_aarch64
	depends on BR2_HOSTARCH = "x86_64"
	select BR2_TOOLCHAIN_EXTERNAL_GLIBC
	select BR2_TOOLCHAIN_HAS_SSP
	select BR2_INSTALL_LIBSTDCPP
	help
		Summit toolchain for the ARM architecture.

if BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM

choice
	prompt "Toolchain Version"
	default BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_11 if BR2_SUMMIT_FIPS_11
	default BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_12
	help
		Select the version of the toolchain you wish to use.

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_13
	bool "Summit 13.x (2025.02)"
	select BR2_TOOLCHAIN_HEADERS_AT_LEAST_6_12
	select BR2_TOOLCHAIN_GCC_AT_LEAST_14
	select BR2_TOOLCHAIN_HAS_OPENMP
	help
		GCC 14.2.0, GDB 15.0.0, glibc-2.41+, headers-6.12.0, binutils 2.44

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_12
	bool "Summit 12.x (2024.02)"
	select BR2_TOOLCHAIN_HEADERS_AT_LEAST_6_6
	select BR2_TOOLCHAIN_GCC_AT_LEAST_13
	select BR2_TOOLCHAIN_HAS_OPENMP
	help
		GCC 13.3.0, GDB 14.2.0, glibc-2.38+, headers-6.6.0, binutils 2.41

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_11
	bool "Summit 11.x (2023.02)"
	select BR2_TOOLCHAIN_HEADERS_AT_LEAST_6_1
	select BR2_TOOLCHAIN_GCC_AT_LEAST_12
	select BR2_TOOLCHAIN_HAS_OPENMP
	help
		GCC 12.2.0, GDB 12.0.0, glibc-2.36+, headers-6.1.0, binutils 2.39
		For FIPS 11.x builds only

endchoice

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_PREFIX
	string
	default "som60" if BR2_ARM_EABIHF
	default "wb4x" if BR2_ARM_EABI
	default "imx8" if BR2_aarch64

#	default "som60" if BR2_ARM_EABIHF && BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_11
#	default "wb4x" if BR2_ARM_EABI && BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_11
#	default "imx8" if BR2_aarch64 && BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_11
#	default "arm-eabihf" if BR2_ARM_EABIHF
#	default "arm-eabi" if BR2_ARM_EABI
#	default "aarch64" if BR2_aarch64

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_ID
	string
	default laird if BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_11
	default summit

config BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_VERSION
	string
	default 12.0.0.59 if BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_12
	default 11.0.0.264 if BR2_TOOLCHAIN_EXTERNAL_SUMMIT_ARM_11

endif
